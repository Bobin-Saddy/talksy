<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Flow+Circular&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
{%- assign primary_color = section.settings.primary_color | default: '#6366f1' -%}

<div id="chat-launcher" aria-label="Open Chat" style="background: #ffffff; color: {{ primary_color }};">
  <div id="launcher-icon">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
  </div>
  <div id="close-launcher-icon" style="display:none;">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </div>
</div>

<div id="chat-widget" class="chat-hidden">
  
  <div id="chat-header">
    <div class="header-content">
      <div id="header-avatar-container" class="avatar-stack">
        <div class="avatar-status"></div>
        <img id="main-support-avatar" src="https://ui-avatars.com/api/?name=S" alt="Support">
      </div>
      <div class="header-text" style="position: relative;">
        <div style="display:flex; flex-direction:column; gap: 2px;">
          <span id="header-title-text" class="header-title">Live Support</span>
          <span id="header-subtitle-text" class="header-subtitle"><span class="pulse"></span> </span>
        </div>
      </div>
    </div>
    <button id="chat-close" title="Minimize">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
    </button>
  </div>

  <div id="widget-main-container" style="flex: 1; overflow: hidden; display: flex; flex-direction: column;">
    
    <!-- HOME TAB -->
    <div id="tab-home" class="tab-content">
      <div class="home-hero" id="home-hero-bg"> 
        <h1 id="welcome-h1">Hi there 👋</h1>
        <p id="welcome-p">We are here to help you! Ask us anything.</p>
      </div>
      
      <div class="home-scroll-area" id="home-scroll-area-bg">
        <div class="home-card" id="start-chat-trigger">
          <div class="card-text">
            <strong id="card-msg-text">Send us a message</strong>
            <span id="card-reply-time">Typically replies in 5 minutes</span>
          </div>
          <div class="card-arrow" id="card-arrow-bg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>

        <div class="promo-section">
          <h3 id="onboarding-title-text">Start a conversation</h3>
          <p id="onboarding-subtitle-text">Please provide your details to begin.</p>
        </div>
      </div>
    </div>

    <!-- CHAT TAB -->
    <div id="tab-chat" class="tab-content" style="display:none;">
      
      <div id="chat-onboarding-step" class="step-container">
        <div class="registration-form">
          <h3 id="onboarding-form-title" style="text-align: center !important;">Identify Yourself</h3>
          <p id="onboarding-form-subtitle" style="text-align: center !important;">How should we address you?</p>
          <div class="input-group">
            <input id="chat-fname" type="text" placeholder="First Name" autocomplete="off" />
            <input id="chat-lname" type="text" placeholder="Last Name" autocomplete="off" />
            <input id="chat-email" type="email" placeholder="Email Address" autocomplete="off" />
            <button id="chat-submit-info" disabled>Start Chatting</button>
          </div>
        </div>
      </div>

      <div id="chat-chat-step" class="step-container" style="display:none;">
        <div id="chat-messages"></div>
        
        <div id="image-preview-container" style="display:none;">
          <div id="image-preview-wrapper">
            <img id="image-preview" src="" alt="Preview" />
            <button id="remove-image-btn">×</button>
          </div>
          <button id="send-image-btn">Upload and Send</button>
        </div>

        <div id="chat-footer">
          <div class="input-wrapper">
            <button id="emoji-btn" class="tool-btn">😊</button>
            <button id="file-btn" class="tool-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
            </button>
            <input id="chat-file-input" type="file" style="display:none;" accept="image/*" />
            <input id="chat-input" placeholder="Compose message..." autocomplete="off" />
            <button id="chat-send">
               <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            </button>
          </div>
          <div id="emoji-picker" class="hidden-picker"></div>
        </div>
      </div>
    </div>

    <!-- FAQ TAB -->
    <div id="tab-faq" class="tab-content" style="display:none;">
      <div class="faq-container">
        <div class="faq-header">
          <h2 id="faq-main-title">Frequently Asked Questions</h2>
          <p id="faq-subtitle">Find quick answers to common questions</p>
        </div>
        
        <div class="faq-search">
          <input type="text" id="faq-search-input" placeholder="🔍 Search FAQs..." />
        </div>
        
        <div id="faq-categories-list" class="faq-scroll-area">
          <div class="faq-loading">
            <div class="loading-spinner"></div>
            <p>Loading FAQs...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SEARCH TAB -->
    <div id="tab-search" class="tab-content" style="display:none;">
      <div class="search-container">
        <div class="search-header">
          <h2>Search Store</h2>
          <p>Find products, pages, orders & more</p>
        </div>
        
        <div class="search-box">
          <input type="text" id="store-search-input" placeholder="🔍 Search anything..." />
          <select id="search-type-filter">
            <option value="all">All</option>
            <option value="products">Products</option>
            <option value="orders">Orders</option>
            <option value="pages">Pages</option>
            <option value="collections">Collections</option>
          </select>
        </div>
        
        <div id="search-results" class="search-scroll-area">
          <div class="search-empty">
            <div class="search-empty-icon">🔍</div>
            <div class="search-empty-text">Start typing to search</div>
            <p class="search-empty-subtext">Search for products, orders, pages or collections</p>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- BOTTOM NAVIGATION -->
  <div id="chat-nav">
    <div class="nav-item active" data-tab="home">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M5.50065 17.4167H8.88498V12.7628C8.88498 12.5532 8.95618 12.3775 9.09857 12.2357C9.24035 12.0933 9.41604 12.0221 9.62565 12.0221H12.3757C12.5853 12.0221 12.7613 12.0933 12.9037 12.2357C13.0454 12.3775 13.1163 12.5532 13.1163 12.7628V17.4167H16.5007V9.44905C16.5007 9.35494 16.4802 9.26939 16.4392 9.19239C16.3983 9.11539 16.3424 9.04816 16.2715 8.99072L11.3362 5.27089C11.242 5.189 11.1302 5.14805 11.0007 5.14805C10.8711 5.14805 10.7596 5.189 10.6661 5.27089L5.72982 8.99072C5.65954 9.04939 5.60362 9.11661 5.56207 9.19239C5.52051 9.26816 5.50004 9.35372 5.50065 9.44905V17.4167ZM4.58398 17.4167V9.44905C4.58398 9.21439 4.63654 8.99225 4.74165 8.78264C4.84676 8.57302 4.9916 8.40039 5.17615 8.26472L10.1124 4.52655C10.3709 4.32916 10.6661 4.23047 10.9979 4.23047C11.3297 4.23047 11.6267 4.32916 11.8889 4.52655L16.8252 8.2638C17.0103 8.39947 17.1551 8.57241 17.2596 8.78264C17.3648 8.99225 17.4173 9.21439 17.4173 9.44905V17.4167C17.4173 17.6624 17.326 17.8766 17.1432 18.0593C16.9605 18.242 16.7463 18.3334 16.5007 18.3334H12.9403C12.7301 18.3334 12.5541 18.2625 12.4123 18.1207C12.2705 17.9783 12.1997 17.8023 12.1997 17.5927V12.9397H9.80165V17.5927C9.80165 17.8029 9.73076 17.9789 9.58898 18.1207C9.44721 18.2625 9.27151 18.3334 9.0619 18.3334H5.50065C5.25498 18.3334 5.04079 18.242 4.85807 18.0593C4.67535 17.8766 4.58398 17.6624 4.58398 17.4167Z" fill="black"/>
      </svg>
      <span>Home</span>
    </div>
    <div class="nav-item" data-tab="chat">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M16.2382 8.90509H9.95247M17.2858 3.66699C17.8415 3.66699 18.3744 3.88774 18.7674 4.28067C19.1603 4.67361 19.381 5.20654 19.381 5.76223V16.2384C19.381 16.7941 19.1603 17.327 18.7674 17.72C18.3744 18.1129 17.8415 18.3337 17.2858 18.3337L14.144 18.3326L11.7408 20.7358C11.5604 20.9162 11.3204 21.0246 11.0658 21.0406C10.8112 21.0566 10.5595 20.9792 10.3579 20.8228L10.2594 20.7358L7.85619 18.3326L4.71438 18.3337C4.15869 18.3337 3.62575 18.1129 3.23282 17.72C2.83989 17.327 2.61914 16.7941 2.61914 16.2384V5.76223C2.61914 5.20654 2.83989 4.67361 3.23282 4.28067C3.62575 3.88774 4.15869 3.66699 4.71438 3.66699H17.2858Z" stroke="black" stroke-linecap="round" stroke-linejoin="round"/>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M6.80829 9.95266C7.3321 9.95266 7.85591 9.42885 7.85591 8.90504C7.85591 8.38123 7.3321 7.85742 6.80829 7.85742C6.28448 7.85742 5.76172 8.38123 5.76172 8.90504C5.76172 9.42885 6.28448 9.95266 6.80829 9.95266ZM6.80829 14.1431C7.3321 14.1431 7.85591 13.6193 7.85591 13.0955C7.85591 12.5717 7.3321 12.0479 6.80829 12.0479C6.28448 12.0479 5.76172 12.5717 5.76172 13.0955C5.76172 13.6193 6.28448 14.1431 6.80829 14.1431Z" fill="black"/>
        <path d="M16.2388 13.0957H9.95312" stroke="black" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Messages</span>
    </div>
    <div class="nav-item" data-tab="search">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
        <circle cx="10" cy="10" r="7" stroke="black" stroke-width="1.5"/>
        <path d="M15 15L19 19" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>Search</span>
    </div>
    <div class="nav-item" data-tab="faq">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M11 16.5V16.5083M11 14.2083V7.79167M19.25 11C19.25 15.5563 15.5563 19.25 11 19.25C6.44365 19.25 2.75 15.5563 2.75 11C2.75 6.44365 6.44365 2.75 11 2.75C15.5563 2.75 19.25 6.44365 19.25 11Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>FAQs</span>
    </div>
  </div>
</div>

<style>
div#image-preview-wrapper { position: relative; }
img#image-preview { width: 100%; height: 151px; object-fit: cover; }
button#send-image-btn { background: #f3f4f6; color: #6c6c6c; border: none; padding: 10px; border-radius: 10px; width: 96%; margin: 0 6px; }
button#remove-image-btn { position: absolute; background: #f3f4f6; border: none; padding: 4px 8px; border-radius: 20px !important; right: 7px; top: 8px; }

:root { 
    --chat-primary: {{ primary_color }}; 
    --chat-bg: #ffffff;
    --chat-font: 'Euclid Circular A Medium', 'Euclid Circular A', -apple-system, sans-serif; 
    --chat-font-size: 15px;
}

#chat-widget, #chat-widget *, #chat-launcher, #chat-launcher * { box-sizing: border-box; font-family: var(--chat-font) !important; margin: 0; }
.header-title, #welcome-h1, #card-msg-text, #onboarding-title-text { font-weight: 500 !important; }

#chat-launcher { 
  position: fixed; bottom: 25px; right: 25px; width: 62px; height: 62px; border-radius: 50%; 
  display: flex; align-items: center; justify-content: center; cursor: pointer; 
  z-index: 999999; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transition: transform 0.3s;
}
#chat-launcher:hover { transform: scale(1.08); }

#chat-widget { 
  position: fixed; bottom: 100px; right: 25px; width: 380px; height: 620px; 
  max-height: calc(100vh - 130px); background: var(--chat-bg); border-radius: 24px; 
  display: flex; flex-direction: column; overflow: hidden; 
  box-shadow: 0 15px 50px rgba(0,0,0,0.15); z-index: 999998; 
  transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); 
}
.chat-hidden { opacity: 0; transform: translateY(30px) scale(0.9); pointer-events: none; }
.chat-visible { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }

#chat-header { padding: 22px 20px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
.header-content { display: flex; align-items: center; gap: 12px; }
.avatar-stack { position: relative; width: 44px; height: 44px; }
.avatar-stack img { width: 100%; height: 100%; border-radius: 12px; object-fit: cover; }
.avatar-status { position: absolute; bottom: -2px; right: -2px; width: 12px; height: 12px; background: #22c55e; border: 2px solid #fff; border-radius: 50%; }
.header-title { display: block; font-weight: 700; font-size: 18px; }
.header-subtitle { font-size: 13px; opacity: 0.8; display: flex; align-items: center; gap: 5px; }
.pulse { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; animation: pulse-anim 2s infinite; position: absolute; right: -13px; top: 15px; }
@keyframes pulse-anim { 0%, 100% { transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } }
#chat-close { background: none; border: none; cursor: pointer; opacity: 0.5; transition: 0.2s; }

.tab-content { flex: 1; display: flex; flex-direction: column; height: 100%; overflow: hidden; position: relative; }
.home-hero { padding: 35px 25px !important; text-align: center; flex-shrink: 0; }
.home-hero h1 { font-size: 28px; margin-bottom: 8px; font-weight: 800; }
.home-hero p { font-size: 15px; opacity: 0.9; line-height: 1.5; }

.home-scroll-area { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 20px; }
.home-card { 
  background: white; padding: 24px !important; border-radius: 18px; margin: 0 20px !important;
  display: flex; align-items: center; justify-content: space-between; 
  box-shadow: 0 4px 15px rgba(0,0,0,0.05); cursor: pointer; transition: 0.2s;
}
.home-card:hover { transform: translateY(-3px); }
.card-text strong { display: block; font-size: 17px; margin-bottom: 4px; color: #1e293b; }
.card-text span { font-size: 13px; color: #64748b; }
.card-arrow { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; }

.promo-section { text-align: center; padding: 20px 0; }
.promo-section h3 { font-size: 19px; color: #1e293b; margin-bottom: 6px; }
.promo-section p { font-size: 14px; color: #64748b; }

.step-container { flex: 1; display: flex; flex-direction: column; height: 100%; overflow: hidden; }
#chat-messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
.msg { max-width: 82%; display: flex; flex-direction: column; }
.msg.user { align-self: flex-end; }
.msg.bot { align-self: flex-start; }
.msg-content { padding: 12px 16px; border-radius: 18px; font-size: var(--chat-font-size); line-height: 1.5; word-wrap: break-word; }

.registration-form { padding: 30px !important; }
.input-group { display: flex; flex-direction: column; gap: 12px; }
.input-group input { padding: 14px !important; border: 1px solid #e2e8f0; border-radius: 12px; outline: none; font-size: 15px; width: 100%; }
.input-group button { padding: 15px !important; border: none; border-radius: 12px; color: white; font-weight: 700; cursor: pointer; margin-top: 10px; transition: all 0.3s; }
.input-group button:disabled { opacity: 0.5; cursor: not-allowed; }
.input-group button:not(:disabled) { background: var(--chat-primary); }
.input-group button:disabled { background: #94a3b8; }

#chat-footer { padding: 15px; background: #fff; border-top: 1px solid #f1f5f9; flex-shrink: 0; position: relative; }
.input-wrapper { display: flex; align-items: center; background: #f3f4f6; border-radius: 14px; padding: 6px 12px; gap: 8px; }
#chat-input { flex: 1; border: none; background: transparent; outline: none; padding: 10px 5px; font-size: 15px; }
.tool-btn { background: none; border: none; cursor: pointer; font-size: 1.3em; color: #94a3b8; }
#chat-send { color: #fff; border: none; border-radius: 10px; padding: 9px; cursor: pointer; display: flex; align-items: center; background: var(--chat-primary); }

#chat-nav { display: flex; border-top: 1px solid #f1f5f9; background: #fff; padding: 10px 0; flex-shrink: 0; }
.nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 5px; cursor: pointer; font-size: 11px; color: #94a3b8; gap: 4px; }
.nav-item.active { color: var(--chat-primary); font-weight: 700; }

.hidden-picker { display: none !important; }
#emoji-picker { position: absolute; bottom: 85px; left: 15px; right: 15px; background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 12px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; z-index: 100; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }

.faq-container { flex: 1; display: flex; flex-direction: column; height: 100%; overflow: hidden; }
.faq-header { padding: 25px 20px; color: white; flex-shrink: 0; }
.faq-header h2 { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
.faq-header p { font-size: 14px; opacity: 0.9; }
.faq-search { padding: 15px 20px; background: white; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; }
.faq-search input { width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; transition: border-color 0.2s; }
.faq-search input:focus { border-color: var(--chat-primary); }
.faq-scroll-area { flex: 1; overflow-y: auto; padding: 20px; }
.faq-loading { text-align: center; padding: 40px 20px; color: #64748b; }
.loading-spinner { width: 40px; height: 40px; margin: 0 auto 15px; border: 3px solid #e2e8f0; border-top-color: var(--chat-primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.faq-category { margin-bottom: 25px; }
.faq-category-title { font-size: 18px; font-weight: 700; color: #1e293b; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
.faq-category-badge { display: inline-block; background: var(--chat-primary); color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
.faq-item { background: white; border: 1px solid #e2e8f0; border-radius: 12px; margin-bottom: 10px; overflow: hidden; transition: all 0.2s; }
.faq-item:hover { border-color: var(--chat-primary); box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
.faq-question { padding: 16px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none; }
.faq-question-text { font-size: 15px; font-weight: 600; color: #1e293b; flex: 1; }
.faq-toggle-icon { width: 20px; height: 20px; transition: transform 0.3s; color: var(--chat-primary); flex-shrink: 0; }
.faq-toggle-icon.open { transform: rotate(180deg); }
.faq-answer { padding: 0 16px; max-height: 0; overflow: hidden; transition: all 0.3s; }
.faq-answer.open { padding: 0 16px 16px 16px; max-height: 500px; }
.faq-answer-text { font-size: 14px; line-height: 1.6; color: #64748b; }
.faq-empty { text-align: center; padding: 40px 20px; }
.faq-empty-icon { font-size: 48px; margin-bottom: 15px; }
.faq-empty-text { font-size: 16px; color: #1e293b; font-weight: 600; margin-bottom: 8px; }
.faq-empty-subtext { color: #94a3b8; font-size: 14px; }

.search-container { flex: 1; display: flex; flex-direction: column; height: 100%; overflow: hidden; }
.search-header { padding: 25px 20px; color: white; flex-shrink: 0; }
.search-header h2 { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
.search-header p { font-size: 14px; opacity: 0.9; }
.search-box { padding: 15px 20px; background: white; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; display: flex; gap: 10px; }
.search-box input { flex: 1; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; }
.search-box select { padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; cursor: pointer; }
.search-scroll-area { flex: 1; overflow-y: auto; padding: 20px; }
.search-empty { text-align: center; padding: 40px 20px; }
.search-empty-icon { font-size: 48px; margin-bottom: 15px; }
.search-empty-text { font-size: 16px; color: #1e293b; font-weight: 600; margin-bottom: 8px; }
.search-empty-subtext { color: #94a3b8; font-size: 14px; }
.search-result-item { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 12px; cursor: pointer; transition: all 0.2s; }
.search-result-item:hover { border-color: var(--chat-primary); box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
.search-result-header { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 8px; }
.search-result-image { width: 60px; height: 60px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
.search-result-info { flex: 1; }
.search-result-title { font-size: 15px; font-weight: 600; color: #1e293b; margin-bottom: 4px; }
.search-result-type { display: inline-block; background: var(--chat-primary); color: white; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; }
.search-result-description { font-size: 13px; color: #64748b; line-height: 1.4; margin-bottom: 8px; }
.search-result-meta { font-size: 12px; color: #94a3b8; }
.search-loading { text-align: center; padding: 20px; color: #64748b; }

@media (max-width: 480px) {
  #chat-widget {
    width: 100%;
    height: 100%;
    max-height: 100vh;
    bottom: 0;
    right: 0;
    border-radius: 0;
  }
  
  #chat-launcher {
    bottom: 20px;
    right: 20px;
    width: 56px;
    height: 56px;
  }
  
  .home-card {
    margin: 0 10px !important;
    padding: 18px !important;
  }
  
  .faq-header, .search-header {
    padding: 20px 15px;
  }
  
  .faq-scroll-area, .search-scroll-area {
    padding: 15px;
  }
}
</style>

<script>
(() => {
  const shop = "{{ shop.permanent_domain }}";
  const BASE_URL = "https://talksy-production-2e93.up.railway.app"; 
  const widget = document.getElementById("chat-widget");
  const launcher = document.getElementById("chat-launcher");
  const chatInput = document.getElementById("chat-input");
  const msgBox = document.getElementById("chat-messages");
  const submitBtn = document.getElementById("chat-submit-info");
  const fnameInput = document.getElementById("chat-fname");
  const lnameInput = document.getElementById("chat-lname");
  const emailInput = document.getElementById("chat-email");
  
  let selectedImg = null;
  let pollInterval = null; 
  let currentConfig = {};
  let seenMsgs = new Set();
  let faqData = [];
  let searchTimeout = null;
  let isSessionChecked = false;

  const STORAGE_KEYS = {
    SESSION_ID: `chat_session_${shop}`,
    USER_EMAIL: `chat_email_${shop}`,
    USER_FNAME: `chat_fname_${shop}`,
    USER_LNAME: `chat_lname_${shop}`
  };

  try {
    localStorage.setItem("__test", "1");
    localStorage.removeItem("__test");
  } catch (e) {
    console.warn("LocalStorage blocked");
  }

  function getOrCreateSessionId() {
    let sId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    if (!sId || sId === "null" || sId === "undefined") {
      sId = "s_" + crypto.randomUUID();
      localStorage.setItem(STORAGE_KEYS.SESSION_ID, sId);
    }
    return sId;
  }

  function validateForm() {
    const fname = fnameInput.value.trim();
    const email = emailInput.value.trim();
    const isValid = fname && email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    submitBtn.disabled = !isValid;
  }

  fnameInput.addEventListener('input', validateForm);
  lnameInput.addEventListener('input', validateForm);
  emailInput.addEventListener('input', validateForm);

  const ICON_SVGS = {
    bubble: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>',
    send: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>',
    defaultCustom: '<img src="https://alert-lime-e4qtqvlkob.edgeone.app/icon-frame.png" style="width:30px;height:30px;object-fit:contain;"/>'
  };

  async function loadSettings() {
    try {
      const r = await fetch(`${BASE_URL}/api/chat-settings?shop=${shop}`);
      const s = await r.json();
      currentConfig = s;
      
      let cleanFont = s.fontFamily.replace(/['"]+/g, "'"); 
      
      document.documentElement.style.setProperty('--chat-primary', s.primaryColor);
      document.documentElement.style.setProperty('--chat-font', cleanFont);
      document.documentElement.style.setProperty('--chat-font-size', s.baseFontSize);

      widget.style.border = `1px solid ${s.widgetBorderColor}`;
      widget.style.background = s.chatBoxBgColor;
      launcher.style.color = s.primaryColor;

      const header = document.getElementById("chat-header");
      header.style.background = s.headerBgColor;
      header.style.color = s.headerTextColor;
      header.style.borderBottom = `1px solid ${s.widgetBorderColor}`;
      document.getElementById("header-title-text").innerText = s.headerTitle;

      const hero = document.getElementById("home-hero-bg");
      hero.style.background = s.heroBgColor;
      hero.style.color = s.heroTextColor;
      document.getElementById("welcome-h1").innerText = s.welcomeText;
      document.getElementById("welcome-p").innerText = s.welcomeSubtext;

      document.getElementById("home-scroll-area-bg").style.background = s.chatBoxBgColor;

      const card = document.getElementById("start-chat-trigger");
      card.style.background = s.messageBgColor;
      card.style.border = `1px solid ${s.widgetBorderColor}`;
      document.getElementById("card-msg-text").innerText = s.startConversationText;
      document.getElementById("card-msg-text").style.color = s.cardTitleColor;
      document.getElementById("card-reply-time").innerText = s.replyTimeText;
      document.getElementById("card-reply-time").style.color = s.cardSubtitleColor;
      document.getElementById("card-arrow-bg").style.background = s.primaryColor;

      document.getElementById("onboarding-title-text").innerText = s.onboardingTitle;
      document.getElementById("onboarding-subtitle-text").innerText = s.onboardingSubtitle;
      document.getElementById("onboarding-title-text").style.color = s.onboardingTextColor;
      document.getElementById("onboarding-subtitle-text").style.color = s.onboardingTextColor;

      document.getElementById("main-support-avatar").src = s.welcomeImg;
      document.getElementById("onboarding-form-title").innerText = s.onboardingTitle;
      document.getElementById("onboarding-form-subtitle").innerText = s.onboardingSubtitle;

      document.querySelectorAll('.faq-header, .search-header').forEach(el => {
        el.style.background = s.primaryColor;
      });

      if (s.launcherIcon === 'custom' && s.customLauncherImg) {
        document.getElementById("launcher-icon").innerHTML = `<img src="${s.customLauncherImg}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>`;
      } else {
        document.getElementById("launcher-icon").innerHTML = ICON_SVGS[s.launcherIcon] || ICON_SVGS.bubble;
      }

      await checkExistingSession();

    } catch (e) { 
      console.error("Setup Error", e); 
    }
  }

  async function checkExistingSession() {
    if (isSessionChecked) return;
    isSessionChecked = true;

    const existingSession = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    const existingEmail = localStorage.getItem(STORAGE_KEYS.USER_EMAIL);
    const existingFname = localStorage.getItem(STORAGE_KEYS.USER_FNAME);

    console.log("🔍 Checking session:", { existingSession, existingEmail, existingFname });

    if(!existingSession || !existingEmail || !existingFname) {
      console.log("❌ No complete session data");
      return;
    }

    try {
      const response = await fetch(`${BASE_URL}/app/chat/validate-session`, {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ 
          shop, 
          sessionId: existingSession,
          email: existingEmail 
        })
      });

      const data = await response.json();
      console.log("📡 Validation response:", data);

      if(response.ok && data.valid) {
        console.log("✅ Session valid - auto login");
        showChatInterface();
        startPolling();
      } else {
        console.log("❌ Session invalid");
        clearSession();
      }
    } catch(e) {
      console.error("❌ Validation error:", e);
      clearSession();
    }
  }

  function clearSession() {
    Object.values(STORAGE_KEYS).forEach(key => localStorage.removeItem(key));
    document.getElementById("chat-onboarding-step").style.display = "flex";
    document.getElementById("chat-chat-step").style.display = "none";
  }

  function showChatInterface() {
    document.getElementById("chat-onboarding-step").style.display = "none";
    document.getElementById("chat-chat-step").style.display = "flex";
  }

  async function performSearch(query, type = 'all') {
    if (!query || query.length < 2) {
      document.getElementById("search-results").innerHTML = `
        <div class="search-empty">
          <div class="search-empty-icon">🔍</div>
          <div class="search-empty-text">Start typing to search</div>
          <p class="search-empty-subtext">Search for products, orders, pages or collections</p>
        </div>
      `;
      return;
    }

    document.getElementById("search-results").innerHTML = '<div class="search-loading"><div class="loading-spinner"></div><p>Searching...</p></div>';

    try {
      const response = await fetch(`${BASE_URL}/app/chat/search?shop=${shop}&query=${encodeURIComponent(query)}&type=${type}`);
      const data = await response.json();

      if (!data.success) throw new Error(data.error || "Search failed");
      renderSearchResults(data.results);
    } catch (error) {
      console.error("Search error:", error);
      document.getElementById("search-results").innerHTML = `
        <div class="search-empty">
          <div class="search-empty-icon">❌</div>
          <div class="search-empty-text">Search failed</div>
          <p class="search-empty-subtext">${error.message}</p>
        </div>
      `;
    }
  }

  function renderSearchResults(results) {
    const container = document.getElementById("search-results");
    const allResults = [
      ...results.products || [],
      ...results.pages || [],
      ...results.orders || [],
      ...results.collections || []
    ];

    if (allResults.length === 0) {
      container.innerHTML = `
        <div class="search-empty">
          <div class="search-empty-icon">🔍</div>
          <div class="search-empty-text">No results found</div>
          <p class="search-empty-subtext">Try different keywords</p>
        </div>
      `;
      return;
    }

    container.innerHTML = allResults.map(item => {
      let content = '';
      
      if (item.type === 'product') {
        const price = item.price !== 'N/A' 
          ? `${item.currency} ${parseFloat(item.price).toFixed(2)}` 
          : 'Price not available';
        
        content = `
          <div class="search-result-item" onclick="window.open('${item.url}', '_blank')">
            <div class="search-result-header">
              ${item.image ? `<img src="${item.image}" class="search-result-image" alt="${item.title}" />` : ''}
              <div class="search-result-info">
                <span class="search-result-type">🛍️ Product</span>
                <div class="search-result-title">${item.title}</div>
                <div class="search-result-meta" style="color: var(--chat-primary); font-weight: 600; margin-top: 4px;">${price}</div>
              </div>
            </div>
            ${item.description ? `<div class="search-result-description">${item.description}...</div>` : ''}
          </div>
        `;
      }
      else if (item.type === 'collection') {
        content = `
          <div class="search-result-item" onclick="window.open('${item.url}', '_blank')">
            <div class="search-result-header">
              ${item.image ? `<img src="${item.image}" class="search-result-image" alt="${item.title}" />` : ''}
              <div class="search-result-info">
                <span class="search-result-type">📁 Collection</span>
                <div class="search-result-title">${item.title}</div>
                ${item.productCount ? `<div class="search-result-meta">${item.productCount} products</div>` : ''}
              </div>
            </div>
            ${item.description ? `<div class="search-result-description">${item.description}...</div>` : ''}
          </div>
        `;
      }
      else if (item.type === 'page') {
        content = `
          <div class="search-result-item" onclick="window.open('${item.url}', '_blank')">
            <div class="search-result-header">
              <div class="search-result-info">
                <span class="search-result-type">📄 Page</span>
                <div class="search-result-title">${item.title}</div>
              </div>
            </div>
            ${item.description ? `<div class="search-result-description">${item.description}...</div>` : ''}
          </div>
        `;
      }
      else if (item.type === 'order') {
        const orderDate = new Date(item.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });
        
        const totalPrice = `${item.currency} ${parseFloat(item.total).toFixed(2)}`;
        
        content = `
          <div class="search-result-item">
            <div class="search-result-header">
              <div class="search-result-info">
                <span class="search-result-type">📦 Order</span>
                <div class="search-result-title">Order ${item.orderNumber}</div>
                <div class="search-result-meta" style="margin-top: 6px;">
                  <div style="margin-bottom: 4px;">📧 ${item.email}</div>
                  <div style="margin-bottom: 4px;">💰 ${totalPrice}</div>
                  <div style="margin-bottom: 4px;">📅 ${orderDate}</div>
                  <div>
                    <span style="background: ${item.status === 'PAID' ? '#22c55e' : '#f59e0b'}; color: white; padding: 2px 8px; border-radius: 4px; font-size: 11px; margin-right: 4px;">${item.status}</span>
                    ${item.fulfillment ? `<span style="background: #3b82f6; color: white; padding: 2px 8px; border-radius: 4px; font-size: 11px;">${item.fulfillment}</span>` : ''}
                  </div>
                </div>
              </div>
            </div>
            ${item.items && item.items.length > 0 ? `
              <div class="search-result-description" style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #e2e8f0;">
                <strong>Items:</strong>
                <div style="margin-top: 6px;">
                  ${item.items.map(lineItem => `
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                      ${lineItem.image ? `<img src="${lineItem.image}" style="width: 30px; height: 30px; object-fit: cover; border-radius: 4px;" />` : ''}
                      <span style="font-size: 13px;">${lineItem.quantity}x ${lineItem.title}</span>
                    </div>
                  `).join('')}
                </div>
              </div>
            ` : ''}
          </div>
        `;
      }
      
      return content;
    }).join('');
  }

  async function loadFAQs() {
    try {
      const response = await fetch(`${BASE_URL}/api/faq/categories?shop=${shop}`);
      const data = await response.json();
      faqData = data.categories || [];
      renderFAQs();
    } catch (error) {
      console.error("Error loading FAQs:", error);
      document.getElementById("faq-categories-list").innerHTML = `
        <div class="faq-empty">
          <div class="faq-empty-icon">❌</div>
          <div class="faq-empty-text">Failed to load FAQs</div>
          <p class="faq-empty-subtext">Please try again later</p>
        </div>
      `;
    }
  }

  function renderFAQs() {
    const container = document.getElementById("faq-categories-list");
    
    if (!faqData.length || !faqData.some(cat => cat.isActive && cat.faqs.length > 0)) {
      container.innerHTML = `
        <div class="faq-empty">
          <div class="faq-empty-icon">❓</div>
          <div class="faq-empty-text">No FAQs Available</div>
          <p class="faq-empty-subtext">Check back later for helpful information</p>
        </div>
      `;
      return;
    }

    container.innerHTML = '';

    faqData.forEach(category => {
      if (!category.isActive || !category.faqs.length) return;

      const categoryDiv = document.createElement('div');
      categoryDiv.className = 'faq-category';
      
      let categoryHTML = `
        <div class="faq-category-title">
          <span>${category.title}</span>
          <span class="faq-category-badge">${category.faqs.filter(f => f.isActive).length}</span>
        </div>
      `;

      category.faqs.forEach(faq => {
        if (!faq.isActive) return;

        const faqId = `faq-${faq.id}`;
        categoryHTML += `
          <div class="faq-item" data-faq-id="${faqId}">
            <div class="faq-question" onclick="toggleFaq('${faqId}')">
              <span class="faq-question-text">${faq.question}</span>
              <svg class="faq-toggle-icon" id="${faqId}-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </div>
            <div class="faq-answer" id="${faqId}-answer">
              <div class="faq-answer-text">${faq.answer}</div>
            </div>
          </div>
        `;
      });

      categoryDiv.innerHTML = categoryHTML;
      container.appendChild(categoryDiv);
    });
  }

  window.toggleFaq = function(faqId) {
    const answer = document.getElementById(`${faqId}-answer`);
    const icon = document.getElementById(`${faqId}-icon`);
    
    answer.classList.toggle('open');
    icon.classList.toggle('open');
  };

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById("faq-search-input");
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const searchTerm = e.target.value.toLowerCase();
        const faqItems = document.querySelectorAll('.faq-item');

        faqItems.forEach(item => {
          const question = item.querySelector('.faq-question-text').textContent.toLowerCase();
          const answer = item.querySelector('.faq-answer-text').textContent.toLowerCase();
          
          if (question.includes(searchTerm) || answer.includes(searchTerm)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });

        document.querySelectorAll('.faq-category').forEach(category => {
          const visibleItems = category.querySelectorAll('.faq-item:not([style*="display: none"])');
          category.style.display = visibleItems.length > 0 ? '' : 'none';
        });
      });
    }

    const storeSearchInput = document.getElementById("store-search-input");
    const searchTypeFilter = document.getElementById("search-type-filter");
    
    if (storeSearchInput) {
      storeSearchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        const query = e.target.value;
        const type = searchTypeFilter.value;
        
        searchTimeout = setTimeout(() => {
          performSearch(query, type);
        }, 500);
      });
    }

    if (searchTypeFilter) {
      searchTypeFilter.addEventListener('change', () => {
        const query = storeSearchInput.value;
        const type = searchTypeFilter.value;
        performSearch(query, type);
      });
    }
  });

  async function fetchMessages() {
    const sId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    if (!sId) return;
    try {
      const res = await fetch(`${BASE_URL}/app/chat/messages?shop=${shop}&sessionId=${sId}`);
      const data = await res.json();
      data.sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt)).forEach(renderMsg);
    } catch (e) {}
  }

  function renderMsg(m) {
    if (seenMsgs.has(m.id)) return;
    seenMsgs.add(m.id);
    const div = document.createElement("div");
    const isBot = (m.sender === 'admin' || m.sender === 'bot');
    div.className = `msg ${isBot ? 'bot' : 'user'}`;
    const bg = isBot ? (currentConfig.messageBgColor || "#fff") : "var(--chat-primary)";
    const color = isBot ? "#1e293b" : "#fff";
    const border = isBot ? `1px solid ${currentConfig.widgetBorderColor}` : 'none';
    div.innerHTML = `<div class="msg-content" style="background:${bg}; color:${color}; border:${border}">${m.message ? `<div>${m.message}</div>` : ''}${m.fileUrl ? `<img src="${m.fileUrl}" style="max-width:100%; border-radius:10px; margin-top:8px; display:block;" />` : ''}</div>`;
    msgBox.appendChild(div);
    msgBox.scrollTop = msgBox.scrollHeight;
  }

  async function postMessage(txt = "", file = null) {
    const sId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    const message = txt || chatInput.value.trim();
    if ((!message && !file) || !sId) return;
    chatInput.value = "";
    try {
      await fetch(`${BASE_URL}/app/chat/message`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ 
          sessionId: sId, 
          shop, 
          message, 
          fileUrl: file, 
          email: localStorage.getItem(STORAGE_KEYS.USER_EMAIL), 
          fname: localStorage.getItem(STORAGE_KEYS.USER_FNAME) 
        })
      });
      fetchMessages();
    } catch (e) {}
  }

  launcher.onclick = () => {
    const open = widget.classList.toggle("chat-visible");
    widget.classList.toggle("chat-hidden", !open);
    document.getElementById("launcher-icon").style.display = open ? "none" : "block";
    document.getElementById("close-launcher-icon").style.display = open ? "flex" : "none";
  };

  document.querySelectorAll('.nav-item').forEach(nav => {
    nav.onclick = () => {
      const tab = nav.dataset.tab;
      document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
      document.getElementById(`tab-${tab}`).style.display = 'flex';
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      nav.classList.add('active');
      
      if(tab === 'chat') { 
        fetchMessages(); 
        setTimeout(() => msgBox.scrollTop = msgBox.scrollHeight, 100); 
      }
      
      if(tab === 'faq' && faqData.length === 0) {
        loadFAQs();
      }
    };
  });

  submitBtn.onclick = async () => {
    const f = fnameInput.value.trim();
    const l = lnameInput.value.trim();
    const e = emailInput.value.trim();
    
    if(!f || !e) return alert("Required fields missing");

    submitBtn.disabled = true;
    submitBtn.textContent = "Connecting...";

    const sId = getOrCreateSessionId();

    try {
      const res = await fetch(`${BASE_URL}/app/chat/register`, {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ 
          shop, 
          firstName: f, 
          lastName: l,
          email: e, 
          sessionId: sId 
        })
      });

      if(res.ok) {
        const data = await res.json();
        
        localStorage.setItem(STORAGE_KEYS.SESSION_ID, sId);
        localStorage.setItem(STORAGE_KEYS.USER_FNAME, f);
        localStorage.setItem(STORAGE_KEYS.USER_LNAME, l || '');
        localStorage.setItem(STORAGE_KEYS.USER_EMAIL, e);

        console.log("✅ Registration successful, session saved");
        
        showChatInterface();
        startPolling();
        
        submitBtn.textContent = "Start Chatting";
        submitBtn.disabled = false;
      } else {
        alert("Registration failed. Please try again.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Start Chatting";
      }
    } catch(e) {
      console.error("Registration error:", e);
      alert("Connection error. Please try again.");
      submitBtn.disabled = false;
      submitBtn.textContent = "Start Chatting";
    }
  };

  const fInput = document.getElementById("chat-file-input");
  document.getElementById("file-btn").onclick = () => fInput.click();
  fInput.onchange = (e) => {
    const reader = new FileReader();
    reader.onload = (ev) => {
      selectedImg = ev.target.result;
      document.getElementById("image-preview").src = selectedImg;
      document.getElementById("image-preview-container").style.display = "";
    };
    reader.readAsDataURL(e.target.files[0]);
  };

  document.getElementById("send-image-btn").onclick = () => {
    postMessage("", selectedImg);
    selectedImg = null;
    document.getElementById("image-preview-container").style.display = "none";
  };

  document.getElementById("remove-image-btn").onclick = () => {
    selectedImg = null;
    document.getElementById("image-preview-container").style.display = "none";
  };

  const picker = document.getElementById("emoji-picker");
  const ems = ["😊","👋","🙌","🔥","✅","🤔","💡","🚀","❤️","✨","👍","🙏"];
  picker.innerHTML = ems.map(em => `<span class="e-item" style="cursor:pointer; font-size:22px;">${em}</span>`).join("");
  document.getElementById("emoji-btn").onclick = (e) => { 
    e.stopPropagation(); 
    picker.classList.toggle("hidden-picker"); 
  };
  picker.onclick = (e) => {
    if(e.target.classList.contains('e-item')) {
      chatInput.value += e.target.innerText;
      picker.classList.add("hidden-picker");
      chatInput.focus();
    }
  };

  function startPolling() {
    fetchMessages();
    if(pollInterval) clearInterval(pollInterval);
    pollInterval = setInterval(fetchMessages, 3500);
  }

  chatInput.onkeydown = (e) => { if(e.key === 'Enter') postMessage(); };
  document.getElementById("chat-send").onclick = () => postMessage();
  document.getElementById("chat-close").onclick = () => launcher.click();
  document.getElementById("start-chat-trigger").onclick = () => document.querySelector('[data-tab="chat"]').click();

  loadSettings();
  loadFAQs();
})();
</script>

