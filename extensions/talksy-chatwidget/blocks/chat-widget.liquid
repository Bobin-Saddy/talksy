<!-- ══ ANIMATED QUESTIONS CSS ══ -->
<style>
/* ── Animated Question Bubbles Container ── */
#animated-questions-container {
  position: fixed;
  bottom: 88px;
  right: 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
  z-index: 9998;
  pointer-events: none;
}

/* ── Each bubble ── */
.aq-bubble {
  background: #ffffff;
  color: #1e293b;
  border: 1px solid #e8e8e8;
  border-radius: 18px 18px 4px 18px;
  padding: 10px 16px;
  font-size: 13px;
  font-weight: 500;
  font-family: 'Plus Jakarta Sans', 'Montserrat', sans-serif;
  box-shadow: 0 6px 24px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  pointer-events: all;
  max-width: 250px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: transform 0.25s cubic-bezier(.34,1.56,.64,1), box-shadow 0.2s ease, opacity 0.35s ease;
  transform-origin: bottom right;
  opacity: 0;
  transform: translateX(30px) scale(0.85);
  will-change: transform, opacity;
}

.aq-bubble.aq-visible {
  opacity: 1;
  transform: translateX(0) scale(1);
}

/* ── Animation variants ── */
.aq-bubble.aq-anim-float  { animation: aq-float  3s ease-in-out infinite; }
.aq-bubble.aq-anim-bounce { animation: aq-bounce 2.4s ease infinite; }
.aq-bubble.aq-anim-pulse  { animation: aq-pulse  2.2s ease-in-out infinite; }
.aq-bubble.aq-anim-slide  { /* entrance only — no loop */ }

.aq-bubble:hover {
  transform: translateX(-4px) scale(1.04) !important;
  box-shadow: 0 12px 36px rgba(0,0,0,0.18) !important;
  animation-play-state: paused !important;
}

.aq-bubble:active {
  transform: scale(0.95) !important;
  transition-duration: 0.1s !important;
}

.aq-bubble-icon {
  font-size: 17px;
  flex-shrink: 0;
  line-height: 1;
}

.aq-bubble-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Close (×) button inside bubble ── */
.aq-bubble-close {
  width: 17px;
  height: 17px;
  background: rgba(0,0,0,0.07);
  border: none;
  border-radius: 50%;
  font-size: 11px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  flex-shrink: 0;
  padding: 0;
  margin-left: 4px;
  line-height: 1;
  transition: background 0.15s;
}
.aq-bubble-close:hover { background: rgba(0,0,0,0.18); }

/* ── Exit animation ── */
.aq-bubble.aq-hiding {
  opacity: 0 !important;
  transform: translateX(24px) scale(0.85) !important;
  transition: opacity 0.35s ease, transform 0.35s ease !important;
  animation: none !important;
  pointer-events: none;
}

/* ── Keyframes ── */
@keyframes aq-float {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-7px); }
}
@keyframes aq-bounce {
  0%, 100% { transform: translateY(0) scale(1); }
  40%       { transform: translateY(-10px) scale(1.02); }
  60%       { transform: translateY(-5px) scale(1.01); }
}
@keyframes aq-pulse {
  0%, 100% { box-shadow: 0 6px 24px rgba(0,0,0,0.12); }
  50%       { box-shadow: 0 6px 28px rgba(243,156,18,0.45), 0 0 0 6px rgba(243,156,18,0.1); }
}

/* ── Child Question Chips (inside chat message box) ── */
.aq-child-chips-wrap {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 2px 0 4px 0;
  align-self: flex-start;
  max-width: 90%;
  animation: aq-chips-in 0.35s cubic-bezier(.34,1.56,.64,1);
}
@keyframes aq-chips-in {
  from { opacity:0; transform: translateY(10px) scale(0.96); }
  to   { opacity:1; transform: translateY(0)    scale(1);    }
}
.aq-child-chips-label {
  font-size: 11px;
  color: #9ca3af;
  font-weight: 500;
  margin-bottom: 7px;
  padding-left: 2px;
  font-family: 'Plus Jakarta Sans','Montserrat',sans-serif;
}
.aq-child-chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}
.aq-child-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 7px 13px;
  background: #ffffff;
  border: 1.5px solid #e0d7f8;
  border-radius: 20px;
  font-size: 12.5px;
  font-weight: 500;
  color: #6d28d9;
  cursor: pointer;
  font-family: 'Plus Jakarta Sans','Montserrat',sans-serif;
  box-shadow: 0 2px 8px rgba(109,40,217,0.08);
  transition: all 0.18s ease;
  white-space: nowrap;
}
.aq-child-chip:hover {
  background: #f3eeff;
  border-color: #a78bfa;
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(109,40,217,0.18);
}
.aq-child-chip:active {
  transform: scale(0.95);
}
.aq-child-chip.aq-chip-used {
  background: #f9fafb;
  border-color: #e5e7eb;
  color: #9ca3af;
  cursor: default;
  pointer-events: none;
}
.aq-child-chip-icon {
  font-size: 14px;
  line-height: 1;
}

/* ── Typing Indicator ── */
.aq-typing-bubble {
  display: flex;
  align-self: flex-start;
  margin-bottom: 4px;
}
.aq-typing-content {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 12px 16px;
  background: #fff;
  border: 1px solid #eee;
  border-radius: 16px 16px 16px 4px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.aq-typing-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #9ca3af;
  animation: aq-typing-bounce 1.2s ease-in-out infinite;
}
.aq-typing-dot:nth-child(2) { animation-delay: 0.2s; }
.aq-typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes aq-typing-bounce {
  0%, 60%, 100% { transform: translateY(0);    opacity: 0.4; }
  30%            { transform: translateY(-6px); opacity: 1;   }
}

/* ── Static bubble (no animation) ── */
.aq-anim-none { animation: none !important; }

/* ══════════════════════════════
   Chat Message Animations
══════════════════════════════ */
/* Message animations — inline transitions handle karte hain, yahan sirf chips ke liye */
</style>

