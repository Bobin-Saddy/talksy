{% comment %}
  Talksy Chat Widget v2.6 - AUTO-SCROLL FIXED
  - Auto-scroll works when latest search results appear
  - Previous search results cleared before new search
  - Search state persists on tab change
  - Search query and results saved in localStorage
  - All previous fixes maintained (orange colors, responsive, etc.)
{% endcomment %}

{%- assign primary_color    = section.settings.primary_color    | default: '#F39C12' -%}
{%- assign grad_start       = section.settings.grad_start       | default: '#F39C12' -%}
{%- assign grad_end         = section.settings.grad_end         | default: '#E67E22' -%}
{{ 'talksy-chat.css' | asset_url | stylesheet_tag }}

<!-- ── Google Fonts ── -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<!-- ── Launcher Button ── -->
<div id="chat-launcher" aria-label="Open Chat"
     style="background:#ffffff; color:{{ primary_color }};">
  <div id="launcher-icon" style="display: flex;">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </div>
  <div id="close-launcher-icon" style="display:none;">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </div>
</div>

<!-- ── Widget Shell ── -->
<div id="chat-widget" class="chat-hidden">

  <!-- HEADER (gradient) - DEFAULT ORANGE -->
  <div id="chat-header">
    <div class="header-content">
      <h1 id="header-title-text" class="header-title">Hello 👋</h1>
      <p  id="header-subtitle-text" class="header-subtitle">How can we help you?</p>
    </div>
    <button id="chat-close" title="Close">
<img 
  src="{{ 'material-symbols-light_cancel-outline-rounded.svg' | asset_url }}" 
  alt="Cancel Icon"
  width="20"
  height="20"
>

    </button>
  </div>

  <!-- ── SCROLLABLE BODY ── -->
  <div id="widget-main-container" style="overflow-y: auto !important; height: 100%;">

    <!-- ════════ HOME TAB ════════ -->
    <div id="tab-home" class="tab-content">
      <div class="home-scroll-area">

        <!-- Contact-us card -->
        <div class="contact-card">
          <div class="contact-header">
            <strong id="contact-title">Need Help?</strong>
            <div class="online-status" id="online-status-badge">
              <span class="status-dot" id="status-dot"></span>
              <span id="status-text">We are online</span>
            </div>
          </div>
          <button class="chat-now-btn" id="chat-now-btn">
          <img src="{{ 'chat.svg' | asset_url }}" alt="Chat Icon">
            <span>Chat Now</span>
          </button>
        </div>

        <!-- Search-here card -->
        <div class="search-here-card" id="search-here-trigger">
          <div class="search-here-content">
           <strong id="search-card-title">Search Anything</strong>
<span id="search-card-subtitle">Find products, orders, pages, and more</span>
          </div>
          <div class="search-here-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        </div>

        <!-- Search input row -->
        <div class="search-box">
          <input type="text" id="home-search-input"
                 placeholder="Search for help" autocomplete="off" />
      <button class="search-icon-round" id="home-search-btn">
  <img src="{{ 'search.svg' | asset_url }}" alt="Search Icon">
</button>

        </div>

        <!-- FAQ list (flat rows) -->
        <div class="faq-list" id="home-faq-list">
          <div class="faq-loading">
            <div class="loading-spinner"></div>
            <p>Loading…</p>
          </div>
        </div>

      </div><!-- .home-scroll-area -->
    </div><!-- #tab-home -->

    <!-- ════════ CHAT TAB ════════ -->
    <div id="tab-chat" class="tab-content" style="display:none;">

      <!-- onboarding form -->
      <div id="chat-onboarding-step" class="step-container">
        <div class="registration-form">
          <h3 id="onboarding-form-title">Identify Yourself</h3>
          <p  id="onboarding-form-subtitle">How should we address you?</p>
          <div class="input-group">
            <input id="chat-fname"  type="text"  placeholder="First Name"     autocomplete="off" />
            <input id="chat-lname"  type="text"  placeholder="Last Name"      autocomplete="off" />
            <input id="chat-email"  type="email" placeholder="Email Address"  autocomplete="off" />
            <button id="chat-submit-info" disabled>Start Chatting</button>
          </div>
        </div>
      </div>

      <!-- live messages -->
      <div id="chat-chat-step" class="step-container" style="display:none;">
        <div id="chat-messages"></div>

        <!-- image preview -->
        <div id="image-preview-container" style="display:none;">
          <div id="image-preview-wrapper">
            <img id="image-preview" src="" alt="Preview" />
            <button id="remove-image-btn">×</button>
          </div>
          <button id="send-image-btn">Upload and Send</button>
        </div>

        <!-- input footer -->
        <div id="chat-footer">
          <div class="input-wrapper">
            <button id="emoji-btn" class="tool-btn">😊</button>
            <button id="file-btn" class="tool-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
              </svg>
            </button>
            <input type="file" id="chat-file-input" style="display:none;" accept="image/*" />
            <input id="chat-input" placeholder="Compose message…" autocomplete="off" />
            <button id="chat-send">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
              </svg>
            </button>
          </div>
          <div id="emoji-picker" class="hidden-picker"></div>
        </div>
      </div>
    </div><!-- #tab-chat -->

    <!-- ════════ FAQ TAB ════════ -->
    <div id="tab-faq" class="tab-content" style="display:none;">
      <div class="faq-container">
        <div class="faq-search">
          <input type="text" id="faq-search-input" placeholder="🔍 Search FAQs…" />
        </div>
        <div id="faq-categories-list" class="faq-scroll-area">
          <div class="faq-loading">
            <div class="loading-spinner"></div>
            <p>Loading…</p>
          </div>
        </div>
      </div>
    </div><!-- #tab-faq -->

    <!-- ════════ SEARCH TAB ════════ -->
<div id="tab-search" class="tab-content" style="display:none;">
  <div class="search-container-new">

    <!-- ══════ PREVIOUS SEARCH RESULTS (TOP) ══════ -->
    <div id="previous-search-wrapper" style="display:none;">
      <div class="previous-search-header">
        <h3>🕐 Previous Search</h3>
        <span class="previous-query-text" id="previous-query-text"></span>
      </div>

      <div id="prev-products-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">🛍️</span>
          <span class="section-title">Products</span>
          <span class="section-count" id="prev-products-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('prev-products','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="prev-products-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('prev-products','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="prev-collections-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">📁</span>
          <span class="section-title">Collections</span>
          <span class="section-count" id="prev-collections-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('prev-collections','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="prev-collections-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('prev-collections','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="prev-pages-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">📄</span>
          <span class="section-title">Pages</span>
          <span class="section-count" id="prev-pages-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('prev-pages','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="prev-pages-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('prev-pages','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="prev-orders-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">📦</span>
          <span class="section-title">Orders</span>
          <span class="section-count" id="prev-orders-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('prev-orders','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="prev-orders-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('prev-orders','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div><!-- #previous-search-wrapper -->

    <!-- ══════ LATEST SEARCH RESULTS (MIDDLE) ══════ -->
    <div id="search-results-wrapper" style="display:none;">
      <div class="results-header"><h3>✨ Latest Search Results</h3></div>

      <div id="products-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">🛍️</span>
          <span class="section-title">Products</span>
          <span class="section-count" id="products-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('products','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="products-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('products','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="collections-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">📁</span>
          <span class="section-title">Collections</span>
          <span class="section-count" id="collections-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('collections','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="collections-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('collections','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="pages-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">📄</span>
          <span class="section-title">Pages</span>
          <span class="section-count" id="pages-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('pages','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="pages-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('pages','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="orders-results-section" class="results-section" style="display:none;">
        <div class="section-header">
          <span class="section-icon">📦</span>
          <span class="section-title">Orders</span>
          <span class="section-count" id="orders-count">0</span>
        </div>
        <div class="scroll-wrapper">
          <button class="scroll-btn scroll-left" onclick="scrollSection('orders','left')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="horizontal-scroll" id="orders-scroll"></div>
          <button class="scroll-btn scroll-right" onclick="scrollSection('orders','right')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div><!-- #search-results-wrapper -->

    <!-- ══════ EMPTY STATE (WHEN NO SEARCHES) ══════ -->
    <div id="search-empty-state" class="search-empty-new">
      <div class="search-hero">
        <div class="search-icon-large">🔍</div>
        <h2>What are you looking for?</h2>
        <p>Search products, collections, pages & orders</p>
      </div>
    </div>

    <!-- ══════ NO RESULTS STATE ══════ -->
    <div id="no-results-state" class="search-empty-new" style="display:none;">
      <div class="empty-icon">😕</div>
      <p class="empty-text">No results found</p>
      <p class="empty-subtext">Try different keywords or check spelling</p>
    </div>

    <!-- ══════ SEARCH FIELD (FIXED AT BOTTOM) ══════ -->
    <div class="search-bottom-fixed">
      <div class="search-textarea-wrapper">
        <textarea id="store-search-input-new"
                  placeholder="Search Anything"
                  rows="2" autocomplete="off"></textarea>
        <button id="search-icon-btn" class="search-icon-btn-inner" title="Search">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
          </svg>
        </button>
        <div id="search-loading-indicator" style="display:none;">
          <div class="mini-spinner"></div>
        </div>
      </div>
    </div>

  </div>
</div>


  </div><!-- #widget-main-container -->

  <!-- ══════ BOTTOM NAV ══════ -->
  <div id="chat-nav">
    <div class="nav-item active" data-tab="home">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span>Home</span>
    </div>
    <div class="nav-item" data-tab="chat">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span>Message</span>
    </div>
    <div class="nav-item" data-tab="search">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <span>Search</span>
    </div>
<div class="nav-item" data-tab="faq">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10" />
    
    <path d="M9 9c0-1.7 1.3-3 3-3s3 1.3 3 3c0 2-3 2.5-3 5" />
    
    <circle cx="12" cy="17" r="0.5" fill="currentColor"/>
  </svg>
  <span>FAQ's</span>
</div>

  </div>
<a href="https://apps.shopify.com/talksy" target="_blank" class="powered-by-talksy" >Powered by talksy</a>
