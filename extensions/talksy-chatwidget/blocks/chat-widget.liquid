<script>
(() => {
  /* ══════════════════════════════════════════
     🔥 FIREBASE CONFIG
  ══════════════════════════════════════════ */
  const FIREBASE_CONFIG = {
    apiKey: "AIzaSyDOVZ95b_MZ7Ba5TVvpluX2Jz5h-7FXNNA",
    authDomain: "talksy-b24e4.firebaseapp.com",
    projectId: "talksy-b24e4",
    storageBucket: "talksy-b24e4.firebasestorage.app",
    messagingSenderId: "19294207700",
    appId: "1:19294207700:web:b4cd33123321f8eb784541",
    measurementId: "G-Q7BYVQGTEP"
  };
  const FIREBASE_VAPID_KEY = "BByGfcXLNVQBVZdVUvPgsdK3lP6Avvw6FD_OcTauED_QyCUfqjyqvGDTxdgNhuh8YffyTdWuoQBFDnmiPfRHAU8";

  /* ── config ── */
  const shop     = "{{ shop.permanent_domain }}";
  const BASE_URL = "https://talksy-production-5d43.up.railway.app";

  /* ── DOM refs ── */
  const widget     = document.getElementById("chat-widget");
  const launcher   = document.getElementById("chat-launcher");
  const chatInput  = document.getElementById("chat-input");
  const msgBox     = document.getElementById("chat-messages");
  const submitBtn  = document.getElementById("chat-submit-info");
  const fnameInput = document.getElementById("chat-fname");
  const lnameInput = document.getElementById("chat-lname");
  const emailInput = document.getElementById("chat-email");

  /* ── state ── */
  let selectedImg          = null;
  let pollInterval         = null;
  let statusInterval       = null;
  let currentConfig        = {};
  let seenMsgs             = new Set();
  let faqData              = [];
  let adminOnline          = true;
  let fcmToken             = null;
  let searchBusy           = false;

  /* ── localStorage keys ── */
  const SK = {
    SID         : `chat_session_${shop}`,
    EMAIL       : `chat_email_${shop}`,
    FNAME       : `chat_fname_${shop}`,
    LNAME       : `chat_lname_${shop}`,
    FCM_TOKEN   : `chat_fcm_token_${shop}`,
    SEARCH_HIST : `chat_search_history_${shop}`
  };

  /* ══════════════════════════════════════════
     🎯 ANIMATED QUESTIONS — State
  ══════════════════════════════════════════ */
  let aqQuestions   = [];
  let aqSettings    = { enabled: true, maxVisible: 3, showDelay: 1000, autoHide: false, autoHideDelay: 0 };
  let aqHideTimer   = null;
  const aqContainer = document.getElementById('animated-questions-container');

  /* ── All questions flat (parents + children) ── */
  let aqAllQuestions = [];

  /* ── Load animated questions from backend ── */
  async function loadAnimatedQuestions() {
    try {
      const res  = await fetch(`${BASE_URL}/api/animated-questions?shop=${encodeURIComponent(shop)}`);
      const data = await res.json();
      if (data.questions) {
        // Keep all active questions (both parents + children)
        aqAllQuestions = data.questions.filter(q => q.isActive !== false);
        // Only null-parentId ones float as bubbles
        aqQuestions    = aqAllQuestions.filter(q => !q.parentId);
      }
      if (data.settings) {
        aqSettings.enabled    = data.settings.enabled !== false;
        aqSettings.maxVisible = data.settings.maxVisible || 3;
        aqSettings.showDelay  = data.settings.showDelay  || 2000;
      }
      if (aqSettings.enabled && aqQuestions.length > 0) {
        setTimeout(showAnimatedBubbles, aqSettings.showDelay);
      }
    } catch (_) { /* silent */ }
  }

  /* ── Get active child questions for a given parentId ── */
  function getChildQuestions(parentId) {
    return aqAllQuestions.filter(q => q.parentId === parentId && q.isActive !== false);
  }

  /* ── Render all bubbles ── */
  function showAnimatedBubbles() {
    if (!aqContainer) return;
    // Don't show if widget is open
    if (widget.classList.contains('chat-visible')) return;

    const toShow = aqQuestions.slice(0, aqSettings.maxVisible);
    aqContainer.innerHTML = '';

    toShow.forEach((q, i) => {
      const bubble = document.createElement('div');
      // 'none' animationType pe koi animation class nahi — bubble static rahega
      const animClass = (q.animationType && q.animationType !== 'none')
        ? `aq-anim-${q.animationType}`
        : '';
      bubble.className = `aq-bubble ${animClass}`.trim();
      bubble.style.animationDelay = animClass ? `${i * 0.55}s` : '0s';

      bubble.innerHTML = `
        <span class="aq-bubble-icon">${q.icon || '💬'}</span>
        <span class="aq-bubble-text">${escapeHtml(q.text)}</span>
        <button class="aq-bubble-close" title="Dismiss" type="button"><i class="fa-solid fa-xmark"></i></button>
      `;

      /* Click on bubble text → open chat + send question */
      bubble.addEventListener('click', e => {
        if (e.target.classList.contains('aq-bubble-close')) {
          dismissSingleBubble(bubble, q.id);
          return;
        }
        handleAQClick(q);
      });

      aqContainer.appendChild(bubble);

      /* Staggered entrance */
      requestAnimationFrame(() => {
        setTimeout(() => bubble.classList.add('aq-visible'), 30 + i * 130);
      });
    });

    /* ✅ NO auto-hide — bubbles stay until user dismisses or opens widget */
  }

  /* ── Dismiss a single bubble (× button) ── */
  function dismissSingleBubble(bubbleEl, questionId) {
    bubbleEl.classList.add('aq-hiding');
    setTimeout(() => { if (bubbleEl.parentNode) bubbleEl.remove(); }, 400);
    /* Track dismiss (non-blocking) */
    fetch(`${BASE_URL}/api/animated-questions/${questionId}/dismiss`, {
      method : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify({ shop, sessionId: localStorage.getItem(SK.SID) || null })
    }).catch(() => {});
  }

  /* ── Hide all bubbles (with stagger) ── */
  function hideAllBubbles() {
    if (!aqContainer) return;
    Array.from(aqContainer.querySelectorAll('.aq-bubble')).forEach((b, i) => {
      setTimeout(() => {
        b.classList.add('aq-hiding');
        setTimeout(() => { if (b.parentNode) b.remove(); }, 400);
      }, i * 70);
    });
  }

