      method : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify({ shop, sessionId: localStorage.getItem(SK.SID) || null })
    }).catch(() => {});

    /* 2. Hide all bubbles */
    hideAllBubbles();

    /* 3. Open widget if closed */
/* 3. Open widget if closed — switch to chat tab BEFORE making visible */
const chatNav = document.querySelector('[data-tab="chat"]');

if (!widget.classList.contains('chat-visible')) {
  // Tab pehle switch karo — user ko home flash nahi dikhega
  if (chatNav) chatNav.click();
