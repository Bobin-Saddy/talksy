{% comment %}
  Talksy Chat Widget v2.9 - CHAT-STYLE SEARCH + ANON PERSISTENCE
{% endcomment %}

{%- assign primary_color = section.settings.primary_color | default: '#F39C12' -%}
{{ 'talksy-chat.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-messaging-compat.js"></script>



<!-- Launcher Button -->
<div id="chat-launcher" aria-label="Open Chat" style="background:#ffffff; color:{{ primary_color }};">
  <div id="launcher-icon" style="display: flex;">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </div>
  <div id="close-launcher-icon" style="display:none;">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </div>
</div>

<!-- Widget Shell -->
<div id="chat-widget" class="chat-hidden">

  <div id="chat-header">
    <div class="header-content">
      <h1 id="header-title-text" class="header-title">Hello 👋</h1>
      <p id="header-subtitle-text" class="header-subtitle">How can we help you?</p>
    </div>
    <button id="chat-close" title="Close">
      <img src="{{ 'material-symbols-light_cancel-outline-rounded.svg' | asset_url }}" alt="Cancel Icon" width="20" height="20">
    </button>
  </div>

  <div id="widget-main-container" style="overflow-y: auto !important; height: 100%;">

    <!-- HOME TAB -->
    <div id="tab-home" class="tab-content">
      <div class="home-scroll-area">
        <div class="contact-card">
          <div class="contact-header">
            <strong id="contact-title">Need Help?</strong>
            <div class="online-status" id="online-status-badge">
              <span class="status-dot" id="status-dot"></span>
              <span id="status-text">We are online</span>
            </div>
          </div>
          <button class="chat-now-btn" id="chat-now-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none">
<g clip-path="url(#clip0_509_342)">
<path d="M15.5 8.5H9.5M16.5 3.5C17.0304 3.5 17.5391 3.71071 17.9142 4.08579C18.2893 4.46086 18.5 4.96957 18.5 5.5V15.5C18.5 16.0304 18.2893 16.5391 17.9142 16.9142C17.5391 17.2893 17.0304 17.5 16.5 17.5L13.501 17.499L11.207 19.793C11.0348 19.9652 10.8057 20.0686 10.5627 20.0839C10.3197 20.0992 10.0794 20.0253 9.887 19.876L9.793 19.793L7.499 17.499L4.5 17.5C3.96957 17.5 3.46086 17.2893 3.08579 16.9142C2.71071 16.5391 2.5 16.0304 2.5 15.5V5.5C2.5 4.96957 2.71071 4.46086 3.08579 4.08579C3.46086 3.71071 3.96957 3.5 4.5 3.5H16.5Z" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
<path fill-rule="evenodd" clip-rule="evenodd" d="M6.499 9.5C6.999 9.5 7.499 9 7.499 8.5C7.499 8 6.999 7.5 6.499 7.5C5.999 7.5 5.5 8 5.5 8.5C5.5 9 5.999 9.5 6.499 9.5ZM6.499 13.5C6.999 13.5 7.499 13 7.499 12.5C7.499 12 6.999 11.5 6.499 11.5C5.999 11.5 5.5 12 5.5 12.5C5.5 13 5.999 13.5 6.499 13.5Z" fill="white"/>
<path d="M15.5 12.5H9.5" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
</g>
<defs>
<clipPath id="clip0_509_342">
<rect width="21" height="21" fill="white"/>
</clipPath>
</defs>
</svg>
            <span>Chat Now</span>
          </button>
        </div>

        <div class="search-here-card" id="search-here-trigger">
          <div class="search-here-content">
            <strong id="search-card-title">Search Anything</strong>
            <span id="search-card-subtitle">Find products, orders, pages, and more</span>
          </div>
          <div class="search-here-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
          </div>
        </div>

        <div class="search-box">
          <input type="text" id="home-search-input" placeholder="Search for help" autocomplete="off" />
          <button class="search-icon-round" id="home-search-btn">
            <img src="{{ 'search.svg' | asset_url }}" alt="Search Icon">
          </button>
        </div>

        <div class="faq-list" id="home-faq-list">
          <div class="faq-loading"><div class="loading-spinner"></div><p>Loading…</p></div>
        </div>
      </div>
    </div>

    <!-- CHAT TAB -->
    <div id="tab-chat" class="tab-content" style="display:none;">
      <div id="chat-onboarding-step" class="step-container">
        <div class="registration-form">
          <h3 id="onboarding-form-title">Identify Yourself</h3>
          <p id="onboarding-form-subtitle">How should we address you?</p>
          <div class="input-group">
            <input id="chat-fname" type="text" placeholder="First Name" autocomplete="off" />
            <input id="chat-lname" type="text" placeholder="Last Name" autocomplete="off" />
            <input id="chat-email" type="email" placeholder="Email Address" autocomplete="off" />
            <button id="chat-submit-info" disabled>Start Chatting</button>
          </div>
        </div>
      </div>

      <div id="chat-chat-step" class="step-container" style="display:none;">
        <div id="chat-messages"></div>
        <div id="image-preview-container" style="display:none;">
          <div id="image-preview-wrapper">
            <img id="image-preview" src="" alt="Preview" />
            <button id="remove-image-btn">×</button>
          </div>
          <button id="send-image-btn">Upload and Send</button>
        </div>
        <div id="chat-footer">
          <div class="input-wrapper">
            <button id="emoji-btn" class="tool-btn">😊</button>
            <button id="file-btn" class="tool-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
              </svg>
            </button>
            <input type="file" id="chat-file-input" style="display:none;" accept="image/*" />
            <input id="chat-input" placeholder="Compose message…" autocomplete="off" />
            <button id="chat-send">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
              </svg>
            </button>
          </div>
          <div id="emoji-picker" class="hidden-picker"></div>
        </div>
      </div>
    </div>

    <!-- FAQ TAB -->
    <div id="tab-faq" class="tab-content" style="display:none;">
      <div class="faq-container">
        <div class="faq-search">
          <input type="text" id="faq-search-input" placeholder="🔍 Search FAQs…" />
        </div>
        <div id="faq-categories-list" class="faq-scroll-area">
          <div class="faq-loading"><div class="loading-spinner"></div><p>Loading…</p></div>
        </div>
      </div>
    </div>

    <!-- ══ SEARCH TAB — Premium v3.0 ══ -->
    <div id="tab-search" class="tab-content" style="display:none; flex-direction:column; height:100%;">

      <!-- scrollable conversation area -->
      <div class="search-chat-area" id="search-chat-area">

        <!-- Empty state -->
        <div class="search-chat-empty" id="search-chat-empty">
          <div class="search-empty-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg>
          </div>
          <h3>What are you looking for?</h3>
          <p>Search products, collections,<br>pages &amp; orders instantly</p>
          <div class="search-empty-chips">
            <div class="search-empty-chip" onclick="document.getElementById('store-search-input-new').value='shoes';document.getElementById('search-icon-btn').click()">👟 Shoes</div>
            <div class="search-empty-chip" onclick="document.getElementById('store-search-input-new').value='sale';document.getElementById('search-icon-btn').click()">🏷️ Sale</div>
            <div class="search-empty-chip" onclick="document.getElementById('store-search-input-new').value='new arrivals';document.getElementById('search-icon-btn').click()">✨ New</div>
          </div>
        </div>

      </div>

      <!-- Fixed search input bar -->
      <div class="search-input-bar">
        <div class="search-input-wrap">
          <textarea
            id="store-search-input-new"
            placeholder="Search products, orders, pages…"
            rows="1"
            autocomplete="off"
          ></textarea>
        </div>
        <button class="search-send-btn" id="search-icon-btn" title="Search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
          </svg>
        </button>
      </div>

    </div>

  </div><!-- #widget-main-container -->

  <!-- BOTTOM NAV -->
  <div id="chat-nav">
    <div class="nav-item active" data-tab="home">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Home</span>
    </div>
    <div class="nav-item" data-tab="chat">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>Message</span>
    </div>
    <div class="nav-item" data-tab="search">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <span>Search</span>
    </div>
    <div class="nav-item" data-tab="faq">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 9c0-1.7 1.3-3 3-3s3 1.3 3 3c0 2-3 2.5-3 5"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg>
      <span>FAQ's</span>
    </div>
  </div>
  <a href="https://apps.shopify.com/talksy" target="_blank" class="powered-by-talksy">Powered by talksy</a>
</div><!-- #chat-widget -->

<script>
(() => {
  /* ══════════════════════════════════════════
     🔥 FIREBASE CONFIG
  ══════════════════════════════════════════ */
  const FIREBASE_CONFIG = {
    apiKey: "AIzaSyDOVZ95b_MZ7Ba5TVvpluX2Jz5h-7FXNNA",
    authDomain: "talksy-b24e4.firebaseapp.com",
    projectId: "talksy-b24e4",
    storageBucket: "talksy-b24e4.firebasestorage.app",
    messagingSenderId: "19294207700",
    appId: "1:19294207700:web:b4cd33123321f8eb784541",
    measurementId: "G-Q7BYVQGTEP"
  };
  const FIREBASE_VAPID_KEY = "BByGfcXLNVQBVZdVUvPgsdK3lP6Avvw6FD_OcTauED_QyCUfqjyqvGDTxdgNhuh8YffyTdWuoQBFDnmiPfRHAU8";

  /* ── config ── */
  const shop     = "{{ shop.permanent_domain }}";
  const BASE_URL = "https://talksy-production-5d43.up.railway.app";

  /* ── DOM refs ── */
  const widget     = document.getElementById("chat-widget");
  const launcher   = document.getElementById("chat-launcher");
  const chatInput  = document.getElementById("chat-input");
  const msgBox     = document.getElementById("chat-messages");
  const submitBtn  = document.getElementById("chat-submit-info");
  const fnameInput = document.getElementById("chat-fname");
  const lnameInput = document.getElementById("chat-lname");
  const emailInput = document.getElementById("chat-email");

  /* ── state ── */
  let selectedImg          = null;
  let pollInterval         = null;
  let statusInterval       = null;
  let currentConfig        = {};
  let seenMsgs             = new Set();
  let faqData              = [];
  let adminOnline          = true;
  let fcmToken             = null;
  let searchBusy           = false; // prevents double-send

  /* ── localStorage keys ── */
  const SK = {
    SID          : `chat_session_${shop}`,
    EMAIL        : `chat_email_${shop}`,
    FNAME        : `chat_fname_${shop}`,
    LNAME        : `chat_lname_${shop}`,
    FCM_TOKEN    : `chat_fcm_token_${shop}`,
    SEARCH_HIST  : `chat_search_history_${shop}`  // ✅ anon users only
  };
  // ✅ Search history saved for anonymous users, cleared on login/registration

  /* ══════════════════════════════════════════
     🔥 FIREBASE PUSH NOTIFICATION SETUP
  ══════════════════════════════════════════ */
  async function initFirebasePush() {
    if (!('serviceWorker' in navigator) || !('Notification' in window)) return;
    try {
      if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
      const messaging = firebase.messaging();
      let swReg;
      try {
        swReg = await navigator.serviceWorker.register(
          '{{ "firebase-messaging-sw.js" | asset_url }}',
          { scope: '/' }
        );
      } catch (e) { console.warn('SW reg failed:', e); return; }

      const perm = await Notification.requestPermission();
      if (perm !== 'granted') return;

      const token = await messaging.getToken({ vapidKey: FIREBASE_VAPID_KEY, serviceWorkerRegistration: swReg });
      if (token) {
        fcmToken = token;
        localStorage.setItem(SK.FCM_TOKEN, token);
        await registerTokenWithBackend(token);
      }

      messaging.onMessage(payload => {
        if (document.hidden) {
          new Notification(payload.notification?.title || '💬 New Reply', {
            body: payload.notification?.body || 'You have a new message',
            icon: '/favicon.ico'
          });
        }
      });

      messaging.onTokenRefresh(async () => {
        const t = await messaging.getToken({ vapidKey: FIREBASE_VAPID_KEY });
        if (t) { fcmToken = t; localStorage.setItem(SK.FCM_TOKEN, t); await registerTokenWithBackend(t); }
      });
    } catch (err) { console.warn('Firebase push setup failed:', err); }
  }

  async function registerTokenWithBackend(token) {
    try {
      await fetch(`${BASE_URL}/app/chat/register-fcm-token`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ shop, fcmToken: token, sessionId: localStorage.getItem(SK.SID) || null, email: localStorage.getItem(SK.EMAIL) || null, userAgent: navigator.userAgent, registeredAt: new Date().toISOString() })
      });
    } catch (e) { console.warn('Token registration failed:', e); }
  }

  async function updateTokenAfterLogin() {
    const token = fcmToken || localStorage.getItem(SK.FCM_TOKEN);
    if (token) await registerTokenWithBackend(token);
  }

  /* ══════════════════════════════════════════
     ADMIN STATUS
  ══════════════════════════════════════════ */
  function applyStatus(online) {
    adminOnline = online;
    const dot = document.getElementById("status-dot"), txt = document.getElementById("status-text");
    if (!dot || !txt) return;
    dot.style.background = online ? "#22c55e" : "#ef4444";
    txt.textContent      = online ? "We are online" : "We are offline";
  }
  async function pollAdminStatus() {
    try { const r = await fetch(`${BASE_URL}/app/admin-status?shop=${shop}`); applyStatus((await r.json()).online); }
    catch (_) { applyStatus(false); }
  }
  function startStatusPolling() { pollAdminStatus(); if (statusInterval) clearInterval(statusInterval); statusInterval = setInterval(pollAdminStatus, 10000); }

  /* ── form validation ── */
  function validateForm() {
    const f = fnameInput.value.trim(), e = emailInput.value.trim();
    submitBtn.disabled = !(f && e && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e));
  }
  fnameInput.addEventListener('input', validateForm);
  lnameInput.addEventListener('input', validateForm);
  emailInput.addEventListener('input', validateForm);

  const ICON_SVGS = {
    bubble: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>',
    send  : '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>'
  };

  /* ── settings ── */
  async function loadSettings() {
    try {
      const s = await (await fetch(`${BASE_URL}/api/chat-settings?shop=${shop}`)).json();
      currentConfig = s;
      const hdr = document.getElementById("chat-header");
      const poweredByEl = document.querySelector(".powered-by-talksy");
      if (poweredByEl) {
        poweredByEl.style.display = (s.showPoweredBy === false || s.showPoweredBy === "false") ? "none" : "block";
      }
      hdr.style.background = (s.headerGradientStart && s.headerGradientEnd)
        ? `linear-gradient(135deg, ${s.headerGradientStart}, ${s.headerGradientEnd})`
        : "linear-gradient(135deg, #F39C12, #E67E22)";
      hdr.style.color = s.headerTextColor || "#fff";
      const tc = s.headerTextColor || "#fff";
      document.getElementById("header-title-text").style.color    = tc;
      document.getElementById("header-subtitle-text").style.color = tc;
      document.getElementById("header-title-text").innerText    = s.welcomeText    || "Hello 👋";
      document.getElementById("header-subtitle-text").innerText = s.welcomeSubtext || "How can we help you?";
      document.getElementById("contact-title").innerText        = s.startConversationText || "Contact us";
      if (s.searchCardTitle)    document.getElementById("search-card-title").innerText    = s.searchCardTitle;
      if (s.searchCardSubtitle) document.getElementById("search-card-subtitle").innerText = s.searchCardSubtitle;
      document.getElementById("onboarding-form-title").innerText    = s.onboardingTitle    || "Identify Yourself";
      document.getElementById("onboarding-form-subtitle").innerText = s.onboardingSubtitle || "How should we address you?";
      document.documentElement.style.setProperty('--tw-primary', s.primaryColor || '#F39C12');
      if (s.launcherIcon === 'custom' && s.customLauncherImg)
        document.getElementById("launcher-icon").innerHTML = `<img src="${s.customLauncherImg}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>`;
      else
        document.getElementById("launcher-icon").innerHTML = ICON_SVGS[s.launcherIcon] || ICON_SVGS.bubble;
    } catch (e) {
      document.documentElement.style.setProperty('--tw-primary', '#F39C12');
    }
  }

  /* ── session ── */
  function getOrCreateSessionId() {
    let id = localStorage.getItem(SK.SID);
    if (!id || id === "null" || id === "undefined") { id = "s_" + crypto.randomUUID(); localStorage.setItem(SK.SID, id); }
    return id;
  }
  async function checkExistingSession() {
    const sid = localStorage.getItem(SK.SID), email = localStorage.getItem(SK.EMAIL), fname = localStorage.getItem(SK.FNAME);
    if (!sid || !email || !fname) return false;
    try {
      const r = await fetch(`${BASE_URL}/app/chat/validate-session`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ shop, sessionId: sid, email }) });
      const d = await r.json();
      if (r.ok && d.valid) { showChatInterface(); startPolling(); await updateTokenAfterLogin(); return true; }
      clearSession(); return false;
    } catch (_) { clearSession(); return false; }
  }
  function clearSession() {
    Object.values(SK).forEach(k => localStorage.removeItem(k));
    document.getElementById("chat-onboarding-step").style.display = "flex";
    document.getElementById("chat-chat-step").style.display        = "none";
  }
  function showChatInterface() {
    document.getElementById("chat-onboarding-step").style.display = "none";
    document.getElementById("chat-chat-step").style.display        = "flex";
  }

  /* ── messages ── */
  async function fetchMessages() {
    const sid = localStorage.getItem(SK.SID); if (!sid) return;
    try {
      const data = await (await fetch(`${BASE_URL}/app/chat/messages?shop=${shop}&sessionId=${sid}`)).json();
      data.sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt)).forEach(renderMsg);
    } catch (_) {}
  }
  function renderMsg(m) {
    if (seenMsgs.has(m.id)) return;
    seenMsgs.add(m.id);
    const div = document.createElement("div");
    const isBot = (m.sender === 'admin' || m.sender === 'bot');
    div.className = `msg ${isBot ? 'bot' : 'user'}`;
    const bg  = isBot ? (currentConfig.messageBgColor || "#fff") : "#F39C12";
    const col = isBot ? "#1e293b" : "#fff";
    const bdr = isBot ? `1px solid ${currentConfig.widgetBorderColor || '#eee'}` : 'none';
    div.innerHTML = `<div class="msg-content" style="background:${bg};color:${col};border:${bdr}">
      ${m.message ? `<div>${m.message}</div>` : ''}
      ${m.fileUrl  ? `<img src="${m.fileUrl}" class="msg-image" style="max-width:100%;border-radius:10px;margin-top:6px;display:block;cursor:pointer;" onclick="window.openImagePopup('${m.fileUrl}')" />` : ''}
    </div>`;
    msgBox.appendChild(div);
    msgBox.scrollTop = msgBox.scrollHeight;
  }

  window.openImagePopup = function(url) {
    const p = document.createElement('div');
    p.id = 'image-popup-overlay';
    p.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);display:flex;align-items:center;justify-content:center;z-index:999999;cursor:pointer;';
    p.innerHTML = `<div style="position:relative;max-width:90%;max-height:90%;padding:20px;"><button onclick="document.getElementById('image-popup-overlay').remove()" style="position:absolute;top:10px;right:10px;background:#fff;border:none;width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:24px;display:flex;align-items:center;justify-content:center;">×</button><img src="${url}" style="max-width:100%;max-height:90vh;border-radius:10px;display:block;" /></div>`;
    p.addEventListener('click', e => { if (e.target === p) p.remove(); });
    document.body.appendChild(p);
  };

  /* ── postMessage ── */
  async function postMessage(txt = "", file = null) {
    const sid = localStorage.getItem(SK.SID);
    const message = txt || chatInput.value.trim();
    if ((!message && !file) || !sid) return;
    chatInput.value = "";
    try {
      await fetch(`${BASE_URL}/app/chat/message`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sessionId: sid, shop, message, fileUrl: file, email: localStorage.getItem(SK.EMAIL), fname: localStorage.getItem(SK.FNAME), triggerPush: true })
      });
      await fetchMessages();
    } catch (err) { console.error("postMessage error:", err); throw err; }
  }

  /* ══════════════════════════════════════════
     🔍 CHAT-STYLE SEARCH
     Rules:
       • Query goes in as RIGHT bubble
       • Results come back as LEFT bubble
       • Each search APPENDS — old ones stay above
       • Anonymous users: history saved in localStorage, restored on refresh
       • Registered users: results gone on refresh (session-based)
       • Empty state shown only when no searches yet
  ══════════════════════════════════════════ */

  const searchArea  = document.getElementById('search-chat-area');
  const searchEmpty = document.getElementById('search-chat-empty');
  const searchInput = document.getElementById('store-search-input-new');
  const searchBtn   = document.getElementById('search-icon-btn');

  // ── Anonymous search history (in-memory + localStorage for anon users) ──
  // Each entry: { query: string, results: object|null, error: boolean }
  let searchHistory = [];

  function isAnonymousUser() {
    const email = localStorage.getItem(SK.EMAIL);
    return !email || email === 'null' || email === 'undefined' || email === '';
  }

  function saveSearchHistory() {
    // ✅ ALL users (registered + anonymous) get search history saved
    try {
      const trimmed = searchHistory.slice(-20);
      localStorage.setItem(SK.SEARCH_HIST, JSON.stringify(trimmed));
    } catch (_) {}
  }

  function loadSearchHistory() {
    // ✅ Restore for ALL users — registered and anonymous
    try {
      const raw = localStorage.getItem(SK.SEARCH_HIST);
      if (!raw) return;
      const saved = JSON.parse(raw);
      if (!Array.isArray(saved) || !saved.length) return;
      // Restore each entry into the DOM (no animation — instant restore)
      if (searchEmpty) searchEmpty.style.display = 'none';
      // Show a subtle session divider
      const divider = document.createElement('div');
      divider.className = 'search-session-divider';
      divider.innerHTML = `<span>Previous searches</span>`;
      searchArea.appendChild(divider);
      saved.forEach(entry => {
        // Re-append query bubble (no animation on restore)
        const qEl = document.createElement('div');
        qEl.className = 'search-query-bubble';
        qEl.style.animation = 'none';
        qEl.innerHTML = `
          <div class="search-query-bubble-inner">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            ${escapeHtml(entry.query)}
          </div>`;
        searchArea.appendChild(qEl);
        // Re-append result block
        if (entry.error) {
          appendErrorBlock(true);
        } else {
          appendResultBlock(entry.results || {}, true);
        }
      });
      searchHistory = saved;
      scrollSearchToBottom();
    } catch (_) {}
  }

  // Clear search history when user registers/logs in
  function clearSearchHistoryForRegisteredUser() {
    localStorage.removeItem(SK.SEARCH_HIST);
    searchHistory = [];
  }

  function scrollSearchToBottom() {
    requestAnimationFrame(() => {
      searchArea.scrollTop = searchArea.scrollHeight;
    });
  }

  // Append the user query bubble (RIGHT side)
  function appendQueryBubble(query) {
    if (searchEmpty) searchEmpty.style.display = 'none';
    const el = document.createElement('div');
    el.className = 'search-query-bubble';
    el.innerHTML = `
      <div class="search-query-bubble-inner">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        ${escapeHtml(query)}
      </div>`;
    searchArea.appendChild(el);
    scrollSearchToBottom();
  }

  // Append the loading indicator (LEFT side)
  function appendLoadingBubble() {
    const el = document.createElement('div');
    el.className = 'search-loading-bubble';
    el.id = 'search-loading-' + Date.now();
    el.innerHTML = `
      <div class="search-loading-inner">
        <div class="search-loading-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg>
        </div>
        <div class="search-loading-dots">
          <div class="search-loading-dot"></div>
          <div class="search-loading-dot"></div>
          <div class="search-loading-dot"></div>
        </div>
        <span class="search-loading-text">Searching…</span>
      </div>`;
    searchArea.appendChild(el);
    scrollSearchToBottom();
    return el.id;
  }

  // Remove loading bubble by id
  function removeLoadingBubble(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
  }

  // Build a product/collection card (horizontal scroll)
  function buildSrCard(type, item) {
    const pc = currentConfig.primaryColor || '#F39C12';
    if (type === 'product') {
      return `<div class="sr-card" onclick="window.open('${item.url}','_blank')">
        ${item.image
          ? `<img class="sr-card-img" src="${item.image}" alt="${escapeHtml(item.title)}" loading="lazy"/>`
          : `<div class="sr-card-img-placeholder">🛍️</div>`}
        <div class="sr-card-body">
          <div class="sr-card-title">${escapeHtml(item.title)}</div>
          <div class="sr-card-price">${item.currency} ${parseFloat(item.price).toFixed(2)}</div>
        </div>
      </div>`;
    }
    if (type === 'collection') {
      return `<div class="sr-card" onclick="window.open('${item.url}','_blank')">
        ${item.image
          ? `<img class="sr-card-img" src="${item.image}" alt="${escapeHtml(item.title)}" loading="lazy"/>`
          : `<div class="sr-card-img-placeholder">📁</div>`}
        <div class="sr-card-body">
          <div class="sr-card-title">${escapeHtml(item.title)}</div>
          <div class="sr-card-meta">${item.productCount || 0} products</div>
        </div>
      </div>`;
    }
    return '';
  }

  // Build a page/order list item (vertical list style)
  function buildSrListItem(type, item) {
    if (type === 'page') {
      return `<div class="sr-list-item" onclick="window.open('${item.url}','_blank')">
        <div class="sr-list-icon">📄</div>
        <div class="sr-list-info">
          <div class="sr-list-title">${escapeHtml(item.title)}</div>
          ${item.description ? `<div class="sr-list-sub">${escapeHtml(item.description.substring(0,55))}</div>` : '<div class="sr-list-sub">View page</div>'}
        </div>
        <svg class="sr-list-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </div>`;
    }
    if (type === 'order') {
      return `<div class="sr-list-item">
        <div class="sr-list-icon">📦</div>
        <div class="sr-list-info">
          <div class="sr-list-title">${escapeHtml(item.orderNumber)}</div>
          <div class="sr-list-sub">${item.currency} ${parseFloat(item.total).toFixed(2)} · ${escapeHtml(item.email)}</div>
        </div>
        <span class="sr-card-badge" style="font-size:9px;">Order</span>
      </div>`;
    }
    return '';
  }

  // Build a section block HTML string
  function buildSection(label, icon, items, type) {
    if (!items || !items.length) return '';
    const isCard = (type === 'product' || type === 'collection');
    const itemsHtml = isCard
      ? `<div class="sr-scroll-row">${items.map(i => buildSrCard(type, i)).join('')}</div>`
      : items.map(i => buildSrListItem(type, i)).join('');
    return `
      <div class="sr-section">
        <div class="sr-section-label">
          <span class="sr-section-icon">${icon}</span>
          <span class="sr-section-title">${label}</span>
          <span class="sr-section-badge">${items.length}</span>
        </div>
        ${itemsHtml}
      </div>`;
  }

  // Count total results
  function countResults(results) {
    return (results.products?.length||0) + (results.collections?.length||0) +
           (results.pages?.length||0) + (results.orders?.length||0);
  }

  // Append result block (LEFT side)
  function appendResultBlock(results, restore = false) {
    const sections =
      buildSection('Products',    '🛍️', results.products,    'product')    +
      buildSection('Collections', '📁', results.collections, 'collection') +
      buildSection('Pages',       '📄', results.pages,       'page')       +
      buildSection('Orders',      '📦', results.orders,      'order');

    const total = countResults(results);
    const el = document.createElement('div');
    el.className = 'search-result-block';
    if (restore) el.style.animation = 'none';

    if (!sections.trim()) {
      el.innerHTML = `<div class="search-result-inner">
        <div class="search-result-card-wrap">
          <div class="sr-no-results">
            <div class="sr-no-results-icon">🔍</div>
            <div class="sr-no-results-text">No results found</div>
            <div class="sr-no-results-sub">Try different keywords</div>
          </div>
        </div>
      </div>`;
    } else {
      el.innerHTML = `<div class="search-result-inner">
        <div class="search-result-card-wrap">
          <div class="sr-result-header">
            <div class="sr-result-header-left">
              <div class="sr-bot-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg>
              </div>
              <span class="sr-result-label">Search Results</span>
            </div>
            <span class="sr-result-count-pill">${total} found</span>
          </div>
          ${sections}
        </div>
      </div>`;
    }

    searchArea.appendChild(el);
    scrollSearchToBottom();
  }

  // Append error block (LEFT side)
  function appendErrorBlock(restore = false) {
    const el = document.createElement('div');
    el.className = 'search-result-block';
    if (restore) el.style.animation = 'none';
    el.innerHTML = `<div class="search-result-inner">
      <div class="search-result-card-wrap">
        <div class="sr-no-results">
          <div class="sr-no-results-icon">⚠️</div>
          <div class="sr-no-results-text">Something went wrong</div>
          <div class="sr-no-results-sub">Please try again</div>
        </div>
      </div>
    </div>`;
    searchArea.appendChild(el);
    scrollSearchToBottom();
  }

  // Main search handler
  async function performSearch(query) {
    query = query.trim();
    if (!query || query.length < 2 || searchBusy) return;
    searchBusy = true;
    searchBtn.disabled = true;

    // 1. Show user query bubble on RIGHT
    appendQueryBubble(query);

    // 2. Show typing indicator on LEFT
    const loadingId = appendLoadingBubble();

    // 3. Log search (non-blocking)
    fetch(`${BASE_URL}/app/chat/search-log`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ shop, query, searchType: 'frontend', userEmail: localStorage.getItem(SK.EMAIL) || 'anonymous', sessionId: localStorage.getItem(SK.SID) || 'no-session', firstName: localStorage.getItem(SK.FNAME) || '', lastName: localStorage.getItem(SK.LNAME) || '', createdAt: new Date() })
    }).catch(() => {});

    // 4. Fetch results
    try {
      const res  = await fetch(`${BASE_URL}/app/chat/search?shop=${encodeURIComponent(shop)}&query=${encodeURIComponent(query)}&type=all`);
      const data = await res.json();
      removeLoadingBubble(loadingId);
      // 5. Append result block on LEFT
      const results = (data.success ? data.results : null) || {};
      appendResultBlock(results);
      // ✅ Save to history for anonymous users
      searchHistory.push({ query, results, error: false });
      saveSearchHistory();
    } catch (_) {
      removeLoadingBubble(loadingId);
      appendErrorBlock();
      // ✅ Save error entry too so conversation shape is restored correctly
      searchHistory.push({ query, results: {}, error: true });
      saveSearchHistory();
    }

    searchBusy = false;
    searchBtn.disabled = false;
    searchInput.value = '';
    searchInput.focus();
  }

  // Bind search input events
  searchBtn && searchBtn.addEventListener('click', () => {
    const q = searchInput.value.trim();
    if (q) performSearch(q);
  });
  searchInput && searchInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      const q = searchInput.value.trim();
      if (q) performSearch(q);
    }
  });

  // Auto-resize textarea
  searchInput && searchInput.addEventListener('input', () => {
    searchInput.style.height = 'auto';
    searchInput.style.height = Math.min(searchInput.scrollHeight, 80) + 'px';
  });

  /* ── utility ── */
  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── FAQs ── */
  async function loadFAQs() {
    try {
      const data = await (await fetch(`${BASE_URL}/api/faq/categories?shop=${shop}`)).json();
      faqData = data.categories || [];
      renderHomeFAQs(); renderFAQs();
    } catch (_) { document.getElementById("faq-categories-list").innerHTML = '<div style="text-align:center;padding:40px 20px;color:#888;">❌ Failed to load FAQs</div>'; }
  }
  function renderHomeFAQs() {
    const c = document.getElementById("home-faq-list"); c.innerHTML = '';
    faqData.forEach(cat => {
      if (!cat.isActive || !cat.faqs) return;
      cat.faqs.filter(f => f.isActive).forEach(faq => {
        const item = document.createElement("div"); item.className = "faq-item";
        item.innerHTML = `<div class="faq-item-header"><div class="faq-question">${faq.question}</div><div class="faq-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg></div></div>`;
        item.onclick = () => { item.classList.toggle('open'); if (item.classList.contains('open') && !item.querySelector('.faq-answer')) { const a = document.createElement('div'); a.className='faq-answer'; a.innerHTML=`<div class="faq-answer-text">${faq.answer}</div>`; item.appendChild(a); } };
        c.appendChild(item);
      });
    });
    if (!c.children.length) c.innerHTML = '<div style="text-align:center;padding:30px;color:#999;">❓ No FAQs available</div>';
  }
  function renderFAQs() {
    const c = document.getElementById("faq-categories-list"); c.innerHTML = '';
    faqData.forEach(cat => {
      if (!cat.isActive || !cat.faqs) return;
      const active = cat.faqs.filter(f => f.isActive); if (!active.length) return;
      const catDiv = document.createElement('div'); catDiv.className = 'faq-category';
      const pc = currentConfig.primaryColor || '#F39C12';
      let html = `<div class="faq-category-title"><span>${cat.title}</span><span class="faq-category-badge" style="background:${pc} !important">${active.length}</span></div>`;
      active.forEach(faq => {
        const id = `faq-${faq.id}`;
        html += `<div class="faq-item" onclick="window.toggleFaq('${id}')"><div class="faq-item-header"><div class="faq-question">${faq.question}</div><div class="faq-arrow" id="${id}-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg></div></div><div class="faq-answer" id="${id}-answer" style="display:none;"><div class="faq-answer-text">${faq.answer}</div></div></div>`;
      });
      catDiv.innerHTML = html; c.appendChild(catDiv);
    });
  }
  window.toggleFaq = function(id) { const a = document.getElementById(`${id}-answer`), item = a?.closest('.faq-item'); if (a && item) { const open = a.style.display==='block'; a.style.display=open?'none':'block'; item.classList.toggle('open',!open); } };

  /* ── DOM ready ── */
  document.addEventListener('DOMContentLoaded', () => {
    const hsi = document.getElementById("home-search-input"), hsb = document.getElementById("home-search-btn");
    function goSearch(q) { if (!faqData.length) { loadFAQs().then(()=>switchToFAQ(q)); } else { switchToFAQ(q); } }
    function switchToFAQ(q) { document.querySelector('[data-tab="faq"]').click(); setTimeout(()=>{ const fi=document.getElementById("faq-search-input"); if(fi){fi.value=q;fi.dispatchEvent(new Event('input',{bubbles:true}));} },80); }
    hsb && hsb.addEventListener('click', ()=>{ const q=hsi.value.trim(); if(q) goSearch(q); });
    hsi && hsi.addEventListener('keydown', e=>{ if(e.key==='Enter'){e.preventDefault();const q=hsi.value.trim();if(q)goSearch(q);} });
    const fsi = document.getElementById("faq-search-input");
    fsi && fsi.addEventListener('input', e => {
      const term = e.target.value.toLowerCase();
      document.querySelectorAll('#faq-categories-list .faq-item').forEach(item => { const q=(item.querySelector('.faq-question')?.textContent||'').toLowerCase(), a=(item.querySelector('.faq-answer-text')?.textContent||'').toLowerCase(); item.style.display=(q.includes(term)||a.includes(term))?'':'none'; });
      document.querySelectorAll('.faq-category').forEach(cat => { cat.style.display=cat.querySelectorAll('.faq-item:not([style*="display: none"])').length?'':'none'; });
    });
  });

  /* ── polling ── */
  function startPolling() { fetchMessages(); if (pollInterval) clearInterval(pollInterval); pollInterval = setInterval(fetchMessages, 3500); }

  /* ── launcher ── */
  launcher.onclick = () => {
    const open = widget.classList.toggle("chat-visible");
    widget.classList.toggle("chat-hidden", !open);
    document.getElementById("launcher-icon").style.display       = open ? "none" : "flex";
    document.getElementById("close-launcher-icon").style.display = open ? "flex" : "none";
  };

  /* ── tabs ── */
  document.querySelectorAll('.nav-item').forEach(nav => {
    nav.onclick = () => {
      const tab = nav.dataset.tab;
      document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
      const tabEl = document.getElementById(`tab-${tab}`);
      tabEl.style.display = tab === 'search' ? 'flex' : 'flex';
      tabEl.style.flexDirection = tab === 'search' ? 'column' : '';
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      nav.classList.add('active');
      if (tab === 'chat') { fetchMessages(); setTimeout(() => msgBox.scrollTop = msgBox.scrollHeight, 80); }
      if (tab === 'faq' && !faqData.length) loadFAQs();
      if (tab === 'search') {
        setTimeout(scrollSearchToBottom, 80);
        setTimeout(() => searchInput && searchInput.focus(), 120);
      }
    };
  });

  document.getElementById("search-here-trigger").onclick = () => document.querySelector('[data-tab="search"]').click();
  document.querySelector('.contact-card').addEventListener('click', e => { if(e.target.closest('.chat-now-btn')) document.querySelector('[data-tab="chat"]').click(); });

  /* ── onboarding submit ── */
  submitBtn.onclick = async () => {
    const f=fnameInput.value.trim(), l=lnameInput.value.trim(), e=emailInput.value.trim();
    if (!f||!e) return alert("Required fields missing");
    submitBtn.disabled=true; submitBtn.textContent="Connecting…";
    const sid = getOrCreateSessionId();
    try {
      const res = await fetch(`${BASE_URL}/app/chat/register`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ shop, firstName:f, lastName:l, email:e, sessionId:sid }) });
      if (res.ok) {
        localStorage.setItem(SK.SID,sid); localStorage.setItem(SK.FNAME,f); localStorage.setItem(SK.LNAME,l||''); localStorage.setItem(SK.EMAIL,e);
        showChatInterface(); startPolling();
        await updateTokenAfterLogin();
      } else alert("Registration failed.");
    } catch (_) { alert("Connection error."); }
    submitBtn.disabled=false; submitBtn.textContent="Start Chatting";
  };

  /* ── file ── */
  const fInput = document.getElementById("chat-file-input");
  document.getElementById("file-btn").onclick = () => fInput.click();
  fInput.onchange = async e => {
    const file = e.target.files[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = async ev => {
      selectedImg = ev.target.result;
      const ld = document.createElement("div"); ld.className="msg user"; ld.id="upload-loader-msg";
      ld.innerHTML=`<div class="msg-content" style="background:#F39C12;color:#fff;border:none;"><div style="display:flex;align-items:center;gap:10px;"><div class="upload-spinner"></div><span>Uploading image...</span></div></div>`;
      msgBox.appendChild(ld); msgBox.scrollTop=msgBox.scrollHeight;
      try { await postMessage("", selectedImg); document.getElementById("upload-loader-msg")?.remove(); selectedImg=null; fInput.value=""; }
      catch (err) {
        document.getElementById("upload-loader-msg")?.remove();
        const ed=document.createElement("div"); ed.className="msg user"; ed.innerHTML=`<div class="msg-content" style="background:#ef4444;color:#fff;border:none;"><span>❌ Upload failed. Please try again.</span></div>`;
        msgBox.appendChild(ed); msgBox.scrollTop=msgBox.scrollHeight; setTimeout(()=>ed.remove(),3000);
      }
    };
    reader.readAsDataURL(file);
  };
  document.getElementById("send-image-btn").onclick = async () => {
    if (!selectedImg) { alert("No image selected"); return; }
    const btn=document.getElementById("send-image-btn"), orig=btn.innerHTML;
    try { btn.disabled=true; btn.innerHTML='<span class="img-loader"></span> Uploading...'; await postMessage("",selectedImg); selectedImg=null; document.getElementById("image-preview-container").style.display="none"; }
    catch (_) { alert("Failed to send image. Please try again."); }
    finally { btn.disabled=false; btn.innerHTML=orig; }
  };
  document.getElementById("remove-image-btn").onclick = () => { selectedImg=null; document.getElementById("image-preview-container").style.display="none"; };

  /* ── emoji ── */
  const picker = document.getElementById("emoji-picker");
  picker.innerHTML = ["😊","👋","🙌","🔥","✅","🤔","💡","🚀","❤️","✨","👍","🙏"].map(em=>`<span class="e-item" style="cursor:pointer;font-size:20px;">${em}</span>`).join('');
  document.getElementById("emoji-btn").onclick = e => { e.stopPropagation(); picker.classList.toggle("hidden-picker"); };
  picker.onclick = e => { if(e.target.classList.contains('e-item')){ chatInput.value+=e.target.innerText; picker.classList.add("hidden-picker"); chatInput.focus(); } };

  chatInput.onkeydown = e => { if(e.key==='Enter') postMessage(); };
  document.getElementById("chat-send").onclick  = () => postMessage();
  document.getElementById("chat-close").onclick  = () => launcher.click();

  /* ── INIT ── */
  async function initialize() {
    await loadSettings();
    await loadFAQs();
    await checkExistingSession();
    startStatusPolling();
    // ✅ Restore anonymous user's search history into DOM immediately on page load
    // Must run AFTER checkExistingSession() so isAnonymousUser() returns correct value
    loadSearchHistory();
    if ('serviceWorker' in navigator && 'Notification' in window) {
      initFirebasePush().catch(e => console.warn('Push unavailable:', e));
    }
  }
  initialize();
})();
</script>

