{% comment %}
  Talksy Chat Widget v2.1
  - Orange gradient header (configurable start/end)
  - Contact card: white bg, inline online/offline status (green/red dot)
  - "Search here" card with subtitle + orange arrow
  - Flat FAQ list rows
  - Admin online/offline polling every 10s
  - Updated colors and structure matching screenshot
{% endcomment %}

{%- assign primary_color    = section.settings.primary_color    | default: '#F39C12' -%}
{%- assign grad_start       = section.settings.grad_start       | default: '#F39C12' -%}
{%- assign grad_end         = section.settings.grad_end         | default: '#E67E22' -%}

<!-- ── Google Fonts ── -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<!-- ── Launcher Button ── -->
<div id="chat-launcher" aria-label="Open Chat"
     style="background:#ffffff; color:{{ primary_color }};">
  <div id="launcher-icon">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </div>
  <div id="close-launcher-icon" style="display:none;">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </div>
</div>

<!-- ── Widget Shell ── -->
<div id="chat-widget" class="chat-hidden">

  <!-- HEADER (gradient) -->
  <div id="chat-header">
    <div class="header-content">
      <h1 id="header-title-text" class="header-title">Hello 👋</h1>
      <p  id="header-subtitle-text" class="header-subtitle">How can we help you?</p>
    </div>
    <button id="chat-close" title="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- ── SCROLLABLE BODY ── -->
  <div id="widget-main-container">

    <!-- ════════ HOME TAB ════════ -->
    <div id="tab-home" class="tab-content">
      <div class="home-scroll-area">

        <!-- Contact-us card -->
        <div class="contact-card">
          <div class="contact-header">
            <strong id="contact-title">Contact us</strong>
            <div class="online-status" id="online-status-badge">
              <span class="status-dot" id="status-dot"></span>
              <span id="status-text">We are online</span>
            </div>
          </div>
          <button class="chat-now-btn" id="chat-now-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            <span>Chat Now</span>
          </button>
        </div>

        <!-- Search-here card -->
        <div class="search-here-card" id="search-here-trigger">
          <div class="search-here-content">
            <strong id="search-card-title">Search here</strong>
            <span id="search-card-subtitle">This is Search</span>
          </div>
          <div class="search-here-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        </div>

        <!-- Search input row -->
        <div class="search-box">
          <input type="text" id="home-search-input"
                 placeholder="Search for help" autocomplete="off" />
          <button class="search-icon-round" id="home-search-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
          </button>
        </div>

        <!-- FAQ list (flat rows) -->
        <div class="faq-list" id="home-faq-list">
          <div class="faq-loading">
            <div class="loading-spinner"></div>
            <p>Loading…</p>
          </div>
        </div>

      </div><!-- .home-scroll-area -->
    </div><!-- #tab-home -->

    <!-- ════════ CHAT TAB ════════ -->
    <div id="tab-chat" class="tab-content" style="display:none;">

      <!-- onboarding form -->
      <div id="chat-onboarding-step" class="step-container">
        <div class="registration-form">
          <h3 id="onboarding-form-title">Identify Yourself</h3>
          <p  id="onboarding-form-subtitle">How should we address you?</p>
          <div class="input-group">
            <input id="chat-fname"  type="text"  placeholder="First Name"     autocomplete="off" />
            <input id="chat-lname"  type="text"  placeholder="Last Name"      autocomplete="off" />
            <input id="chat-email"  type="email" placeholder="Email Address"  autocomplete="off" />
            <button id="chat-submit-info" disabled>Start Chatting</button>
          </div>
        </div>
      </div>

      <!-- live messages -->
      <div id="chat-chat-step" class="step-container" style="display:none;">
        <div id="chat-messages"></div>

        <!-- image preview -->
        <div id="image-preview-container" style="display:none;">
          <div id="image-preview-wrapper">
            <img id="image-preview" src="" alt="Preview" />
            <button id="remove-image-btn">×</button>
          </div>
          <button id="send-image-btn">Upload and Send</button>
        </div>

        <!-- input footer -->
        <div id="chat-footer">
          <div class="input-wrapper">
            <button id="emoji-btn" class="tool-btn">😊</button>
            <button id="file-btn" class="tool-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
              </svg>
            </button>
            <input type="file" id="chat-file-input" style="display:none;" accept="image/*" />
            <input id="chat-input" placeholder="Compose message…" autocomplete="off" />
            <button id="chat-send">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
              </svg>
            </button>
          </div>
          <div id="emoji-picker" class="hidden-picker"></div>
        </div>
      </div>
    </div><!-- #tab-chat -->

    <!-- ════════ FAQ TAB ════════ -->
    <div id="tab-faq" class="tab-content" style="display:none;">
      <div class="faq-container">
        <div class="faq-search">
          <input type="text" id="faq-search-input" placeholder="🔍 Search FAQs…" />
        </div>
        <div id="faq-categories-list" class="faq-scroll-area">
          <div class="faq-loading">
            <div class="loading-spinner"></div>
            <p>Loading…</p>
          </div>
        </div>
      </div>
    </div><!-- #tab-faq -->

    <!-- ════════ SEARCH TAB ════════ -->
    <div id="tab-search" class="tab-content" style="display:none;">
      <div class="search-container-new">

        <!-- results (hidden until query runs) -->
        <div id="search-results-wrapper" style="display:none;">
          <div class="results-header"><h3>✨ Search Results</h3></div>

          <!-- Products -->
          <div id="products-results-section" class="results-section" style="display:none;">
            <div class="section-header">
              <span class="section-icon">🛍️</span>
              <span class="section-title">Products</span>
              <span class="section-count" id="products-count">0</span>
            </div>
            <div class="scroll-wrapper">
              <button class="scroll-btn scroll-left" onclick="scrollSection('products','left')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <div class="horizontal-scroll" id="products-scroll"></div>
              <button class="scroll-btn scroll-right" onclick="scrollSection('products','right')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>

          <!-- Collections -->
          <div id="collections-results-section" class="results-section" style="display:none;">
            <div class="section-header">
              <span class="section-icon">📁</span>
              <span class="section-title">Collections</span>
              <span class="section-count" id="collections-count">0</span>
            </div>
            <div class="scroll-wrapper">
              <button class="scroll-btn scroll-left" onclick="scrollSection('collections','left')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <div class="horizontal-scroll" id="collections-scroll"></div>
              <button class="scroll-btn scroll-right" onclick="scrollSection('collections','right')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>

          <!-- Pages -->
          <div id="pages-results-section" class="results-section" style="display:none;">
            <div class="section-header">
              <span class="section-icon">📄</span>
              <span class="section-title">Pages</span>
              <span class="section-count" id="pages-count">0</span>
            </div>
            <div class="scroll-wrapper">
              <button class="scroll-btn scroll-left" onclick="scrollSection('pages','left')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <div class="horizontal-scroll" id="pages-scroll"></div>
              <button class="scroll-btn scroll-right" onclick="scrollSection('pages','right')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>

          <!-- Orders -->
          <div id="orders-results-section" class="results-section" style="display:none;">
            <div class="section-header">
              <span class="section-icon">📦</span>
              <span class="section-title">Orders</span>
              <span class="section-count" id="orders-count">0</span>
            </div>
            <div class="scroll-wrapper">
              <button class="scroll-btn scroll-left" onclick="scrollSection('orders','left')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <div class="horizontal-scroll" id="orders-scroll"></div>
              <button class="scroll-btn scroll-right" onclick="scrollSection('orders','right')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div><!-- #search-results-wrapper -->

        <!-- hero + textarea -->
        <div class="search-center-wrapper">
          <div class="search-hero">
            <div class="search-icon-large">🔍</div>
            <h2>What are you looking for?</h2>
            <p>Search products, collections, pages & orders</p>
          </div>
          <div class="search-textarea-wrapper">
            <textarea id="store-search-input-new"
                      placeholder="Type your search query and press Enter…"
                      rows="3" autocomplete="off"></textarea>
            <button id="search-icon-btn" class="search-icon-btn-inner" title="Search">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8"/>
                <path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
              </svg>
            </button>
            <div id="search-loading-indicator" style="display:none;">
              <div class="mini-spinner"></div>
            </div>
          </div>
        </div>

        <!-- empty / no-results states -->
        <div id="search-empty-state" class="search-empty-new">
          <div class="empty-icon">🎯</div>
          <p class="empty-text">Type your query and press Enter to search</p>
        </div>
        <div id="no-results-state" class="search-empty-new" style="display:none;">
          <div class="empty-icon">😕</div>
          <p class="empty-text">No results found</p>
          <p class="empty-subtext">Try different keywords or check spelling</p>
        </div>
      </div>
    </div><!-- #tab-search -->

  </div><!-- #widget-main-container -->

  <!-- ══════ BOTTOM NAV ══════ -->
  <div id="chat-nav">
    <div class="nav-item active" data-tab="home">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span>Home</span>
    </div>
    <div class="nav-item" data-tab="chat">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span>Message</span>
    </div>
    <div class="nav-item" data-tab="search">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <span>Search</span>
    </div>
    <div class="nav-item" data-tab="faq">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <span>Help</span>
    </div>
  </div>

</div><!-- #chat-widget -->


<!-- ═══════════════════════════════════════════════════════════
     STYLES
     ═══════════════════════════════════════════════════════════ -->
<style>
/* ── reset ── */
#chat-widget *, #chat-launcher * {
  box-sizing: border-box;
  margin: 0;
  font-family: 'Montserrat', -apple-system, sans-serif !important;
}

:root {
  --tw-primary : {{ primary_color }};
  --tw-grad-s  : {{ grad_start }};
  --tw-grad-e  : {{ grad_end }};
}

/* ── launcher ── */
#chat-launcher {
  position: fixed; bottom: 25px; right: 25px;
  width: 62px; height: 62px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; z-index: 999999;
  box-shadow: 0 10px 30px rgba(0,0,0,0.22);
  transition: transform .3s;
}
#chat-launcher:hover { transform: scale(1.08); }

/* ── widget frame ── */
#chat-widget {
  position: fixed; bottom: 100px; right: 25px;
  width: 380px; height: 680px;
  max-height: calc(100vh - 130px);
  background: #fff; border-radius: 24px;
  display: flex; flex-direction: column;
  overflow: hidden;
  box-shadow: 0 15px 50px rgba(0,0,0,0.18);
  z-index: 999998;
  transition: all .4s cubic-bezier(.165,.84,.44,1);
}
.chat-hidden  { opacity:0; transform:translateY(30px) scale(.9); pointer-events:none; }
.chat-visible { opacity:1; transform:translateY(0)   scale(1);   pointer-events:all;  }

/* ── HEADER – gradient ── */
#chat-header {
  background: linear-gradient(135deg, var(--tw-grad-s), var(--tw-grad-e));
  color: #fff;
  padding: 28px 22px 24px;
  display: flex; justify-content: space-between; align-items: flex-start;
  flex-shrink: 0;
  border-radius: 24px 24px 0 0;
}
.header-title   { font-size: 26px; font-weight: 700; margin-bottom: 4px; }
.header-subtitle{ font-size: 15px; font-weight: 400; opacity: .92; }
#chat-close {
  background: none; border: none; cursor: pointer;
  color: #fff; opacity: .85; transition: .2s;
  display: flex; align-items: center; justify-content: center;
}
#chat-close:hover { opacity: 1; }

/* ── body scroll ── */
#widget-main-container {
  flex: 1; overflow: hidden; display: flex; flex-direction: column;
}
.tab-content {
  flex: 1; display: flex; flex-direction: column;
  height: 100%; overflow: hidden; position: relative;
}
.home-scroll-area {
  flex: 1; overflow-y: auto;
  padding: 18px 16px;
  display: flex; flex-direction: column; gap: 12px;
  background: #f5f5f5;
}

/* ── Contact card ── (white, inline status) */
.contact-card {
  background: #fff;
  border-radius: 14px;
  padding: 18px 18px 16px;
  box-shadow: 0 1px 4px rgba(0,0,0,.07);
}
.contact-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 14px;
}
.contact-header strong {
  font-size: 16px; font-weight: 700; color: #1a1a1a;
}
.online-status {
  display: flex; align-items: center; gap: 6px;
}
.status-dot {
  width: 9px; height: 9px; border-radius: 50%;
  background: #22c55e;
  transition: background .4s;
}
#status-text {
  font-size: 13px; color: #555; font-weight: 500;
}
/* ── Chat Now button ── */
.chat-now-btn {
  width: 100%;
  background: var(--tw-primary);
  color: #fff;
  border: none;
  padding: 14px 16px;
  border-radius: 12px;
  font-size: 15px; font-weight: 700;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  transition: filter .2s, transform .15s;
}
.chat-now-btn:hover { filter: brightness(.92); transform: translateY(-1px); }

/* ── Search-here card ── */
.search-here-card {
  background: #fff;
  border-radius: 14px;
  padding: 16px 18px;
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer;
  box-shadow: 0 1px 4px rgba(0,0,0,.07);
  transition: box-shadow .2s, transform .15s;
}
.search-here-card:hover {
  box-shadow: 0 4px 12px rgba(0,0,0,.1);
  transform: translateY(-1px);
}
.search-here-content {
  display: flex; flex-direction: column; gap: 2px;
}
.search-here-content strong { font-size: 15px; font-weight: 700; color: #1a1a1a; }
.search-here-content span  { font-size: 13px; color: #777; }
.search-here-arrow {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--tw-primary);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

/* ── Search input row ── */
.search-box {
  position: relative;
}
#home-search-input {
  width: 100%;
  padding: 13px 48px 13px 16px;
  border: 1px solid #ddd;
  border-radius: 12px;
  font-size: 14px;
  outline: none;
  background: #fff;
  transition: border-color .2s;
}
#home-search-input:focus { border-color: var(--tw-primary); }
.search-icon-round {
  position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--tw-primary);
  color: #fff; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: filter .2s;
}
.search-icon-round:hover { filter: brightness(.9); }

/* ── FAQ flat list ── */
.faq-list { display: flex; flex-direction: column; }
.faq-item {
  background: #fff;
  padding: 14px 16px;
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer;
  border-bottom: 1px solid #eee;
  transition: background .15s;
}
.faq-item:first-child { border-radius: 12px 12px 0 0; }
.faq-item:last-child  { border-radius: 0 0 12px 12px; border-bottom: none; }
.faq-item:hover { background: #fafafa; }
.faq-question { font-size: 14px; font-weight: 500; color: #222; flex: 1; padding-right: 12px; }
.faq-arrow { color: #999; display: flex; align-items: center; transition: transform .25s; }
.faq-answer {
  max-height: 0; overflow: hidden;
  transition: max-height .3s ease, padding .2s;
  background: #fff;
}
.faq-item.open .faq-answer {
  max-height: 300px;
  padding: 0 16px 14px;
}
.faq-answer-text { font-size: 13px; line-height: 1.6; color: #666; }
.faq-item.open .faq-arrow { transform: rotate(90deg); }

/* ── Chat tab ── */
.step-container { flex:1; display:flex; flex-direction:column; height:100%; overflow:hidden; }
#chat-messages  { flex:1; overflow-y:auto; padding:18px; display:flex; flex-direction:column; gap:12px; background:#f5f5f5; }
.msg            { max-width:82%; display:flex; flex-direction:column; }
.msg.user       { align-self:flex-end; }
.msg.bot        { align-self:flex-start; }
.msg-content    { padding:11px 15px; border-radius:18px; font-size:14px; line-height:1.5; word-wrap:break-word; }

.registration-form { padding:30px; text-align:center; background:#fff; }
.registration-form h3 { font-size:20px; font-weight:700; margin-bottom:6px; color:#1a1a1a; }
.registration-form p  { font-size:14px; color:#777; margin-bottom:22px; }
.input-group { display:flex; flex-direction:column; gap:10px; }
.input-group input { padding:13px; border:1px solid #ddd; border-radius:12px; outline:none; font-size:14px; }
.input-group button {
  padding:14px; border:none; border-radius:12px;
  color:#fff; font-weight:700; cursor:pointer; margin-top:8px;
  background: var(--tw-primary); transition: filter .2s;
}
.input-group button:disabled { opacity:.5; cursor:not-allowed; background:#aaa; }
.input-group button:not(:disabled):hover { filter:brightness(.9); }

#chat-footer { padding:12px; background:#fff; border-top:1px solid #eee; flex-shrink:0; position:relative; }
.input-wrapper {
  display:flex; align-items:center;
  background:#f3f4f6; border-radius:14px;
  padding:5px 10px; gap:6px;
}
#chat-input { flex:1; border:none; background:transparent; outline:none; padding:10px 4px; font-size:14px; }
.tool-btn  { background:none; border:none; cursor:pointer; font-size:1.25em; color:#999; }
#chat-send {
  color:#fff; border:none; border-radius:10px;
  padding:9px; cursor:pointer; display:flex; align-items:center;
  background: var(--tw-primary);
}

/* image preview */
#image-preview-container { padding:12px; background:#fff; }
div#image-preview-wrapper { position:relative; }
img#image-preview { width:100%; height:140px; object-fit:cover; border-radius:10px; }
button#send-image-btn { background:var(--tw-primary); color:#fff; border:none; padding:10px; border-radius:10px; width:100%; margin:6px 0 0; cursor:pointer; font-weight:600; }
button#remove-image-btn { position:absolute; background:rgba(0,0,0,.6); color:#fff; border:none; padding:4px 8px; border-radius:50%; right:8px; top:8px; cursor:pointer; font-size:18px; line-height:1; }

/* emoji picker */
.hidden-picker { display:none !important; }
#emoji-picker {
  position:absolute; bottom:75px; left:12px; right:12px;
  background:#fff; border:1px solid #eee; border-radius:16px;
  padding:10px; display:grid; grid-template-columns:repeat(6,1fr);
  gap:8px; z-index:100; box-shadow:0 8px 22px rgba(0,0,0,.1);
}

/* ── FAQ full tab ── */
.faq-container { flex:1; display:flex; flex-direction:column; height:100%; overflow:hidden; background:#f5f5f5; }
.faq-search { padding:12px 16px; background:#fff; border-bottom:1px solid #eee; flex-shrink:0; }
.faq-search input { width:100%; padding:11px 14px; border:1px solid #ddd; border-radius:10px; font-size:14px; outline:none; }
.faq-search input:focus { border-color: var(--tw-primary); }
.faq-scroll-area { flex:1; overflow-y:auto; padding:16px; }
