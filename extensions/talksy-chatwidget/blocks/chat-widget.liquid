  /* ── messages ── */
  async function fetchMessages() {
    const sid = localStorage.getItem(SK.SID); if (!sid) return;
    try {
      const data = await (await fetch(`${BASE_URL}/app/chat/messages?shop=${shop}&sessionId=${sid}`)).json();
      const sorted = data.sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt));
      sorted.forEach(m => renderMsg(m));
    } catch (_) {}
  }

  function renderMsg(m) {
    if (seenMsgs.has(m.id)) return;
    seenMsgs.add(m.id);

    const isBot = (m.sender === 'admin' || m.sender === 'bot');

    // ── User message: local element in-place update (no DOM jump) ──
    if (!isBot && m.message) {
      const localEl = msgBox.querySelector(`[data-local-text="${CSS.escape(m.message)}"]`);
      if (localEl) {
        localEl.removeAttribute('data-local-text');
        localEl.dataset.msgId = m.id;
        _pendingLocalText = null;
        return; // already visible, no scroll needed
      }
    }

    // ── Bot message: replace typing indicator in-place if exists ──
    // Typing indicator ki jagah pe bot message aayega — zero scroll jump
    // Always find the LAST typing bubble (most recent one)
const typingEl = isBot ? msgBox.querySelector('.aq-typing-bubble:last-of-type') || msgBox.querySelector('.aq-typing-bubble') : null;
    const bg  = isBot ? (currentConfig.messageBgColor || '#fff') : '#F39C12';
    const col = isBot ? '#1e293b' : '#fff';
    const bdr = isBot ? `1px solid ${currentConfig.widgetBorderColor || '#eee'}` : 'none';

    const div = document.createElement('div');
    div.className     = `msg ${isBot ? 'bot' : 'user'}`;
    div.dataset.msgId = m.id;
    // Start invisible, same height placeholder feel
    div.innerHTML = `<div class="msg-content" style="background:${bg};color:${col};border:${bdr};opacity:0;transition:opacity 0.28s ease-out;">
      ${m.message ? `<div>${m.message}</div>` : ''}
      ${m.fileUrl ? `<img src="${m.fileUrl}" class="msg-image" style="max-width:100%;border-radius:10px;margin-top:6px;display:block;cursor:pointer;" onclick="window.openImagePopup('${m.fileUrl}')" />` : ''}
    </div>`;

if (isBot && typingEl) {
  // Scroll position lock karo before DOM change
  const scrollLocked = msgBox.scrollTop + msgBox.clientHeight >= msgBox.scrollHeight - 10;
  const typingTop = typingEl.getBoundingClientRect().top;

  // In-place replace — typing ki exact position pe bot message
  msgBox.insertBefore(div, typingEl);
  typingEl.remove();

  // Agar user bottom pe tha toh smooth scroll, warna position hold
  if (scrollLocked) {
    requestAnimationFrame(() => {
      msgBox.scrollTo({ top: msgBox.scrollHeight, behavior: 'smooth' });
    });
  }
} else {
  msgBox.appendChild(div);
  requestAnimationFrame(() => {
    msgBox.scrollTo({ top: msgBox.scrollHeight, behavior: 'smooth' });
  });
}
    // Fade in — no translateY, no position change, sirf opacity
requestAnimationFrame(() => {
  requestAnimationFrame(() => {
    const mc = div.querySelector('.msg-content');
    if (mc) {
      mc.style.opacity = '1';
      // Smooth scroll after message fades in
      setTimeout(() => {
        msgBox.scrollTo({ top: msgBox.scrollHeight, behavior: 'smooth' });
      }, 100);
    }
  });
});
