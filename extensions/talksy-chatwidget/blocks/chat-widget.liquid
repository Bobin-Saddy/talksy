<style>
/* ── reset ── */
#chat-widget *, #chat-launcher * {
  box-sizing: border-box;
  margin: 0;
  font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
}

:root {
  --tw-primary : {{ primary_color }};
  --tw-grad-s  : {{ grad_start }};
  --tw-grad-e  : {{ grad_end }};
  --tw-font-family: "Plus Jakarta Sans";
}

/* ── launcher ── */
#chat-launcher {
  position: fixed; bottom: 25px; right: 25px;
  width: 62px; height: 62px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; z-index: 999999;
  box-shadow: 0 10px 30px rgba(0,0,0,0.22);
  transition: transform .3s;
}
#chat-launcher:hover { transform: scale(1.08); }

/* ── widget frame ── */
#chat-widget {
  position: fixed; bottom: 100px; right: 25px;
  width: 380px; height: 680px;
  max-height: calc(100vh - 130px);
  background: #fff; border-radius: 24px;
  display: flex; flex-direction: column;
  overflow: hidden;
  box-shadow: 0 15px 50px rgba(0,0,0,0.18);
  z-index: 999998;
  transition: all .4s cubic-bezier(.165,.84,.44,1);
}
.chat-hidden  { opacity:0; transform:translateY(30px) scale(.9); pointer-events:none; }
.chat-visible { opacity:1; transform:translateY(0)   scale(1);   pointer-events:all;  }

/* ── HEADER – ORANGE GRADIENT BY DEFAULT ── */
#chat-header {
    padding: 28px 22px 60px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-shrink: 0;
    border-radius: 24px 24px 0 0;
    background: linear-gradient(167deg,rgba(227, 131, 25, 1) 0%, rgba(235, 156, 30, 1) 50%, rgba(227, 131, 25, 1) 100%);
}
.header-title {
    font-size: 26px;
    font-weight: 600;
    margin-bottom: 4px;
    color: inherit;
}
.header-subtitle {
    font-size: 16px;
    font-weight: 500;
    color: white !important;
}
#chat-close {
  background: none; border: none; cursor: pointer;
  color: #fff; opacity: .85; transition: .2s;
  display: flex; align-items: center; justify-content: center;
}
#chat-close:hover { opacity: 1; }

/* ── body scroll ── */
#widget-main-container {
    flex: 1;
    overflow: visible;
    display: flex;
    flex-direction: column;
}

.tab-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: visible;
    position: relative;
}
.home-scroll-area {
    /* flex: 1; */
    overflow-y: auto;
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #f5f5f5;
    height: 428px;
    scrollbar-width: none;
}

/* ── Contact card ── */
.contact-card {
    background: #fff;
    border-radius: 14px;
    padding: 12px 18px 16px;
    margin-top: -40px;
    position: absolute;
    z-index: 99999;
    width: 92%;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
    border: 1px solid #ddd;
    flex-shrink: 0;
    top: -23px;
}
.contact-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 13px !important;
}
.contact-header strong {
    font-size: 15px;
    font-weight: 600;
    color: black;
}
.online-status {
  display: flex; align-items: center; gap: 6px;
}
.status-dot {
  width: 9px; height: 9px; border-radius: 50%;
  background: #ef4444;
  transition: background .4s;
}
#status-text {
    font-size: 12px;
    color: #5C5C5C;
    font-weight: 500;
}
/* ── Chat Now button (ORANGE) ── */
.chat-now-btn {
    width: 100%;
    background: #F39C12;
    color: #fff;
    border: none;
    padding: 7px 16px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: filter .2s, transform .15s;
}
.chat-now-btn:hover { filter: brightness(.92); transform: translateY(-1px); }

/* ── Search-here card ── */
.search-here-card {
    background: #fff;
    border-radius: 14px;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,.07);
    transition: box-shadow .2s, transform .15s;
    border: 1px solid #ddd;
    padding-right: 4px;
    flex-shrink: 0;
    margin-top: 82px !important;
}

.search-here-card:hover {
  box-shadow: 0 4px 12px rgba(0,0,0,.1);
  transform: translateY(-1px);
}
.search-here-content {
  display: flex; flex-direction: column; gap: 2px;
}
.search-here-content strong {
    font-size: 15px;
    font-weight: 600;
    color: black;
}
.search-here-content span {
    font-size: 13px;
    font-weight: 500;
    color: #5C5C5C;
}
.search-here-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #E8912B;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* ── Search input row ── */
.search-box {
  position: relative;
}
#home-search-input {
  width: 100%;
  padding: 13px 48px 13px 16px;
  border: 1px solid #ddd;
  border-radius: 12px;
  font-size: 14px;
  outline: none;
  background: #fff;
  transition: border-color .2s;
}
#home-search-input:focus { border-color: #F39C12; }
.search-icon-round {
  position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
  width: 36px; height: 36px; border-radius: 50%;
  background: #F39C12;
  color: #fff; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: filter .2s;
}
.search-icon-round:hover { filter: brightness(.9); }

/* ── FAQ flat list ── */
.faq-list { display: flex; flex-direction: column; }
.faq-item {
    background: #fff;
    padding: 14px 16px;
    display: block;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    border-bottom: 1px solid #eee;
    transition: background .15s;
    position: relative;
}

.faq-item:first-child { border-radius: 12px 12px 0 0; }
.faq-item:last-child  { border-radius: 0 0 12px 12px; border-bottom: none; }
.faq-item:hover { background: #fafafa; }
.faq-question { font-size: 14px; font-weight: 500; color: #222; flex: 1; padding-right: 12px; }
.faq-arrow {
    color: #999;
    display: flex;
    align-items: center;
    transition: transform .25s;
    position: absolute;
    right: 6px;
    top: 16px;
}
.faq-answer {
  max-height: 0; overflow: hidden;
  transition: max-height .3s ease, padding .2s;
  background: #fff;
}
.faq-item.open .faq-answer {
    max-height: 300px;
    padding: 0 16px 14px 0;
}
.faq-answer-text {
    font-size: 14px;
    line-height: 1.7;
    color: #64748b;
    padding-left: 0 !important;
}

.faq-item.open .faq-arrow { transform: rotate(90deg); }

/* ── Chat tab ── */
.step-container {
    display: flex;
    flex-direction: column;
    height: 427px !important;
    overflow: scroll;
    scrollbar-width: none;
}
#chat-messages  { flex:1; overflow-y:auto; padding:18px; display:flex; flex-direction:column; gap:12px; background:#f5f5f5; }
.msg            { max-width:82%; display:flex; flex-direction:column; }
.msg.user       { align-self:flex-end; }
.msg.bot        { align-self:flex-start; }
.msg-content    { padding:11px 15px; border-radius:18px; font-size:14px; line-height:1.5; word-wrap:break-word; }

.registration-form { padding:30px; text-align:center; background:#fff; }
.registration-form h3 { font-size:20px; font-weight:700; margin-bottom:6px; color:#1a1a1a; }
.registration-form p  { font-size:14px; color:#777; margin-bottom:22px; }
.input-group { display:flex; flex-direction:column; gap:10px; }
.input-group input { padding:13px; border:1px solid #ddd; border-radius:12px; outline:none; font-size:14px; }
.input-group button {
    padding: 14px;
    border: none;
    border-radius: 12px !important;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
    background: #F39C12;
    transition: filter .2s;
}

.input-group button:disabled { opacity:.5; cursor:not-allowed; background:#aaa; }
.input-group button:not(:disabled):hover { filter:brightness(.9); }

#chat-footer { padding:12px; background:#fff; border-top:1px solid #eee; flex-shrink:0; position:relative; }
.input-wrapper {
    display: flex;
    align-items: center;
    background: #f3f4f6;
    border-radius: 14px;
    padding: 5px 10px;
    gap: 6px;
    border: 1px solid #ccc;
}
#chat-input { flex:1; border:none; background:transparent; outline:none; padding:10px 4px; font-size:14px; }
.tool-btn  { background:none; border:none; cursor:pointer; font-size:1.25em; color:#999; }
#chat-send {
  color:#fff; border:none; border-radius:10px;
  padding:9px; cursor:pointer; display:flex; align-items:center;
  background: #F39C12;
}
#chat-input:focus {
    outline: none;
    box-shadow: none;
}

/* image preview */
#image-preview-container { padding:12px; background:#fff; }
div#image-preview-wrapper { position:relative; }
img#image-preview { width:100%; height:140px; object-fit:cover; border-radius:10px; }
button#send-image-btn { background:#F39C12; color:#fff; border:none; padding:10px; border-radius:10px; width:100%; margin:6px 0 0; cursor:pointer; font-weight:600; }
button#remove-image-btn { position:absolute; background:rgba(0,0,0,.6); color:#fff; border:none; padding:4px 8px; border-radius:50%; right:8px; top:8px; cursor:pointer; font-size:18px; line-height:1; }

/* emoji picker */
.hidden-picker { display:none !important; }
#emoji-picker {
  position:absolute; bottom:75px; left:12px; right:12px;
  background:#fff; border:1px solid #eee; border-radius:16px;
  padding:10px; display:grid; grid-template-columns:repeat(6,1fr);
  gap:8px; z-index:100; box-shadow:0 8px 22px rgba(0,0,0,.1);
}

/* ── FAQ full tab ── */
.faq-container {
    /* flex: 1; */
    display: flex;
    flex-direction: column;
    height: 428px;
    overflow: scroll;
    background: #f5f5f5;
    scrollbar-width: none !important;
}
.faq-search { padding:12px 16px; background:#fff; border-bottom:1px solid #eee; flex-shrink:0; }
.faq-search input { width:100%; padding:11px 14px; border:1px solid #ddd; border-radius:10px; font-size:14px; outline:none; }
.faq-search input:focus { border-color: #F39C12; }
.faq-scroll-area {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    overflow: scroll;
    scrollbar-width: none !important;
}
.faq-loading { text-align:center; padding:40px 20px; color:#888; }
.loading-spinner {
  width:36px; height:36px; margin:0 auto 12px;
  border:3px solid #eee; border-top-color: #F39C12;
  border-radius:50%; animation:spin .7s linear infinite;
}
@keyframes spin { to { transform:rotate(360deg); } }
.faq-category { margin-bottom:20px; background:#fff; border-radius:12px; padding:16px; }
.faq-category-title {
  font-size:16px; font-weight:700; color:#222;
  margin-bottom:10px; padding-bottom:8px;
  border-bottom:2px solid #eee;
  display:flex; align-items:center; justify-content:space-between;
}
.faq-category-badge {
  background: #F39C12; color:#fff;
  padding:3px 10px; border-radius:18px; font-size:11px; font-weight:600;
}

/* ── Search tab ── */
.search-container-new {
  flex:1; display:flex; flex-direction:column;
  height:100%; overflow-y:auto;
  background: linear-gradient(135deg, #f7f7f7, #fff);
  padding:18px;
}
.results-header h3 { font-size:17px; font-weight:700; color:#222; margin:0 0 16px; text-align:center; }
.results-section { margin-bottom:20px; }
.section-header { display:flex; align-items:center; gap:6px; margin-bottom:10px; }
.section-icon  { font-size:18px; }
.section-title { font-size:15px; font-weight:600; color:#222; flex:1; }
.section-count { background: #F39C12; color:#fff; padding:2px 9px; border-radius:10px; font-size:11px; font-weight:600; }
.scroll-wrapper { position:relative; display:flex; align-items:center; gap:6px; }
.scroll-btn {
  background:#fff; border:2px solid #F39C12;
  border-radius:50%; width:32px; height:32px;
  display:flex; align-items:center; justify-content:center;
  cursor:pointer; flex-shrink:0; transition:.2s; z-index:2;
}
.scroll-btn:hover { background: #F39C12; }
.scroll-btn:hover svg { stroke:#fff; }
.scroll-btn svg { stroke: #F39C12; transition:stroke .2s; }
.horizontal-scroll {
  display:flex; gap:10px; overflow-x:auto;
  padding:6px 2px; scroll-behavior:smooth;
  flex:1; scrollbar-width:none; -ms-overflow-style:none;
}
.horizontal-scroll::-webkit-scrollbar { display:none; }
.horizontal-scroll.few-results { justify-content:center; }
.result-card {
  min-width:180px; max-width:180px;
  background:#fff; border-radius:12px; overflow:hidden;
  box-shadow:0 2px 8px rgba(0,0,0,.08);
  cursor:pointer; transition:.2s; flex-shrink:0;
}
.result-card:hover { transform:translateY(-3px); box-shadow:0 4px 14px rgba(0,0,0,.12); }
.result-card-image { width:100%; height:120px; object-fit:cover; background:#f0f0f0; }
.result-card-content { padding:10px; }
.result-card-type {
  display:inline-block; background: #F39C12;
  color:#fff; padding:2px 7px; border-radius:4px;
  font-size:10px; font-weight:600; text-transform:uppercase; margin-bottom:6px;
}
.result-card-title {
  font-size:13px; font-weight:600; color:#222; margin-bottom:4px;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
}
.result-card-price { font-size:15px; font-weight:700; color: #F39C12; margin-bottom:3px; }
.result-card-meta  { font-size:11px; color:#888; }

.search-center-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 0;
    gap: 19px;
}

.search-hero { text-align:center; margin-bottom:24px; }
.search-icon-large {
    font-size: 36px;
    margin-bottom: 12px;
    animation: float 3s ease-in-out infinite;
}
@keyframes float { 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-8px); } }
.search-hero h2 { font-size:21px; font-weight:700; color:#222; margin:0 0 6px; }
.search-hero p  { font-size:13px; color:#888; margin:0; }
.search-textarea-wrapper { width:100%; max-width:380px; position:relative; }
#store-search-input-new {
  width:100%; padding:14px 18px 18px 44px;
  border:2px solid #ddd; border-radius:16px;
  font-size:14px; outline:none; background:#fff;
  box-shadow:0 3px 10px rgba(0,0,0,.05);
  resize:none; line-height:1.5; min-height:74px;
  transition: border-color .3s;
}
#store-search-input-new:focus { border-color: #F39C12; }
.search-icon-btn-inner {
  position:absolute; left:8px; top:16px;
  width:28px; height:28px; background: #F39C12;
  border:none; border-radius:10px; color:#fff;
  cursor:pointer; display:flex; align-items: center; justify-content:center;
  transition:.2s; box-shadow:0 3px 10px rgba(0,0,0,.15);
}
.search-icon-btn-inner:hover { transform:scale(1.05); }
#search-loading-indicator { position:absolute; right:60px; bottom:20px; }
.mini-spinner { width:18px; height:18px; border:2px solid #ddd; border-top-color: #F39C12; border-radius:50%; animation:spin .6s linear infinite; }
.search-empty-new {
    text-align: center;
    padding: 0 16px;
}
.empty-icon    { font-size:48px; margin-bottom:12px; }
.empty-text    { font-size:15px; font-weight:600; color:#222; margin:0 0 6px; }
.empty-subtext { font-size:13px; color:#999; margin:0; }

/* ── Bottom nav ── */
#chat-nav {
  display:flex; border-top:1px solid #eee;
  background:#fff; padding:8px 0; flex-shrink:0;
}
.nav-item {
  flex:1; display:flex; flex-direction:column; align-items:center;
  padding:6px 4px; cursor:pointer; font-size:11px;
  color:#aaa; gap:3px; transition:.2s;
}
.nav-item.active {
    color: #F39C12;
    font-weight: 700;
    border-top: 2px solid #F39C12;
}
.nav-item.active svg { stroke: #F39C12; }

/* ── mobile ── */
@media screen and (max-width:480px){
  #chat-widget { width:100%; height:100%; max-height:100vh; bottom:0; right:0; border-radius:0; }
  #chat-launcher { bottom:20px; right:20px; width:56px; height:56px; }
}
@media screen and (max-width:375px){
.faq-container {
    /* flex: 1; */
    display: flex;
    flex-direction: column;
    height: 579px;
    overflow: scroll;
    background: #f5f5f5;
    scrollbar-width: none !important;
}
}
@media screen and (max-width:1299px){
.step-container {
    display: flex;
    flex-direction: column;
    height: 406px !important;
    overflow: scroll;
    scrollbar-width: none;
}
.search-center-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 0;
    gap: 7px;
}
.faq-container {
    /* flex: 1; */
    display: flex;
    flex-direction: column;
    height: 406px;
    overflow: scroll;
    background: #f5f5f5;
    scrollbar-width: none !important;
}
}
</style>


<!-- ═══════════════════════════════════════════════════════════
     JAVASCRIPT
     ═══════════════════════════════════════════════════════════ -->
<script>
(() => {
  /* ── config ── */
  const shop     = "{{ shop.permanent_domain }}";
  const BASE_URL = "https://talksy-production-2e93.up.railway.app";

  /* ── DOM refs ── */
  const widget      = document.getElementById("chat-widget");
  const launcher    = document.getElementById("chat-launcher");
  const chatInput   = document.getElementById("chat-input");
  const msgBox      = document.getElementById("chat-messages");
  const submitBtn   = document.getElementById("chat-submit-info");
  const fnameInput  = document.getElementById("chat-fname");
  const lnameInput  = document.getElementById("chat-lname");
  const emailInput  = document.getElementById("chat-email");

  /* ── state ── */
  let selectedImg    = null;
  let pollInterval   = null;
  let statusInterval = null;
  let currentConfig  = {};
  let seenMsgs       = new Set();
  let faqData        = [];
  let adminOnline    = false;

  /* ── localStorage keys ── */
  const SK = {
    SID   : `chat_session_${shop}`,
    EMAIL : `chat_email_${shop}`,
    FNAME : `chat_fname_${shop}`,
    LNAME : `chat_lname_${shop}`
  };

  /* ─────────────────────────────────────────────
     ADMIN ONLINE / OFFLINE STATUS
     Polls GET /app/admin-status?shop=… every 10s
     ───────────────────────────────────────────── */
  function applyStatus(online) {
    adminOnline = online;
    const dot  = document.getElementById("status-dot");
    const txt  = document.getElementById("status-text");
    if (!dot || !txt) return;

    if (online) {
      dot.style.background = "#22c55e";
      txt.textContent      = "We are online";
    } else {
      dot.style.background = "#ef4444";
      txt.textContent      = "We are offline";
    }
  }

  async function pollAdminStatus() {
    try {
      const res  = await fetch(`${BASE_URL}/app/admin-status?shop=${encodeURIComponent(shop)}`);
      if (!res.ok) {
        applyStatus(false);
        return;
      }
      const data = await res.json();
      applyStatus(data.online === true);
    } catch (err) {
      console.error('Admin status poll error:', err);
      applyStatus(false);
    }
  }

  function startStatusPolling() {
    pollAdminStatus();  // immediate first check
    if (statusInterval) clearInterval(statusInterval);
    statusInterval = setInterval(pollAdminStatus, 10000);  // every 10 seconds
  }

  /* ── form validation ── */
  function validateForm() {
    const f = fnameInput.value.trim();
    const e = emailInput.value.trim();
    submitBtn.disabled = !(f && e && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e));
  }
  fnameInput.addEventListener('input', validateForm);
  lnameInput.addEventListener('input', validateForm);
  emailInput.addEventListener('input', validateForm);

  /* ── icon helpers ── */
  const ICON_SVGS = {
    bubble: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>',
    send  : '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>',
    defaultCustom: '<img src="https://alert-lime-e4qtqvlkob.edgeone.app/icon-frame.png" style="width:30px;height:30px;object-fit:contain;"/>'
  };

  /* ── load remote settings ── */
  async function loadSettings() {
    try {
      const r = await fetch(`${BASE_URL}/api/chat-settings?shop=${shop}`);
      const s = await r.json();
      currentConfig = s;

      const hdr = document.getElementById("chat-header");
      if (s.headerGradientStart && s.headerGradientEnd) {
        hdr.style.background = `linear-gradient(135deg, ${s.headerGradientStart}, ${s.headerGradientEnd})`;
      } else {
        hdr.style.background = "linear-gradient(135deg, #F39C12, #E67E22)";
      }

      hdr.style.color = s.headerTextColor || "#fff";

      const textColor = s.headerTextColor || "#fff";
      document.getElementById("header-title-text").style.color    = textColor;
      document.getElementById("header-subtitle-text").style.color = textColor;
      document.getElementById("header-title-text").innerText    = s.welcomeText    || "Hello 👋";
      document.getElementById("header-subtitle-text").innerText = s.welcomeSubtext || "How can we help you?";
      document.getElementById("contact-title").innerText        = s.startConversationText || "Contact us";

      if (s.searchCardTitle)    document.getElementById("search-card-title").innerText    = s.searchCardTitle;
      if (s.searchCardSubtitle) document.getElementById("search-card-subtitle").innerText = s.searchCardSubtitle;

      document.getElementById("onboarding-form-title").innerText    = s.onboardingTitle    || "Identify Yourself";
      document.getElementById("onboarding-form-subtitle").innerText = s.onboardingSubtitle || "How should we address you?";

      if (s.primaryColor) {
        document.documentElement.style.setProperty('--tw-primary', s.primaryColor);
      } else {
        document.documentElement.style.setProperty('--tw-primary', '#F39C12');
      }

      if (s.fontFamily) {
        document.documentElement.style.setProperty('--tw-font-family', s.fontFamily);
      }

      if (s.launcherIcon === 'custom' && s.customLauncherImg)
        document.getElementById("launcher-icon").innerHTML = `<img src="${s.customLauncherImg}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>`;
      else
        document.getElementById("launcher-icon").innerHTML = ICON_SVGS[s.launcherIcon] || ICON_SVGS.bubble;

    } catch (e) { 
      console.error("loadSettings", e); 
      document.documentElement.style.setProperty('--tw-primary', '#F39C12');
    }
  }

  /* ── session helpers ── */
  function getOrCreateSessionId() {
    let id = localStorage.getItem(SK.SID);
    if (!id || id === "null" || id === "undefined") {
      id = "s_" + crypto.randomUUID();
      localStorage.setItem(SK.SID, id);
    }
    return id;
  }

  async function checkExistingSession() {
    const sid   = localStorage.getItem(SK.SID);
    const email = localStorage.getItem(SK.EMAIL);
    const fname = localStorage.getItem(SK.FNAME);
    if (!sid || !email || !fname) return false;

    try {
      const res  = await fetch(`${BASE_URL}/app/chat/validate-session`, {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ shop, sessionId: sid, email })
      });
      const data = await res.json();
      if (res.ok && data.valid) { showChatInterface(); startPolling(); return true; }
      clearSession(); return false;
    } catch (_) { clearSession(); return false; }
  }

  function clearSession() {
    Object.values(SK).forEach(k => localStorage.removeItem(k));
    document.getElementById("chat-onboarding-step").style.display = "flex";
    document.getElementById("chat-chat-step").style.display        = "none";
  }
  function showChatInterface() {
    document.getElementById("chat-onboarding-step").style.display = "none";
    document.getElementById("chat-chat-step").style.display        = "flex";
  }

  /* ── messages ── */
  async function fetchMessages() {
    const sid = localStorage.getItem(SK.SID);
    if (!sid) return;
    try {
      const res  = await fetch(`${BASE_URL}/app/chat/messages?shop=${shop}&sessionId=${sid}`);
      const data = await res.json();
      data.sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt)).forEach(renderMsg);
    } catch (_) {}
  }

  function renderMsg(m) {
    if (seenMsgs.has(m.id)) return;
    seenMsgs.add(m.id);
    const div   = document.createElement("div");
    const isBot = (m.sender === 'admin' || m.sender === 'bot');
    div.className = `msg ${isBot ? 'bot' : 'user'}`;
    const bg    = isBot ? (currentConfig.messageBgColor || "#fff") : (currentConfig.primaryColor || "#F39C12");
    const color = isBot ? "#1e293b" : "#fff";
    const bdr   = isBot ? `1px solid ${currentConfig.widgetBorderColor || '#eee'}` : 'none';
    div.innerHTML = `<div class="msg-content" style="background:${bg};color:${color};border:${bdr}">
      ${m.message ? `<div>${m.message}</div>` : ''}
      ${m.fileUrl  ? `<img src="${m.fileUrl}" style="max-width:100%;border-radius:10px;margin-top:6px;display:block;" />` : ''}
    </div>`;
    msgBox.appendChild(div);
    msgBox.scrollTop = msgBox.scrollHeight;
  }

  async function postMessage(txt = "", file = null) {
    const sid     = localStorage.getItem(SK.SID);
    const message = txt || chatInput.value.trim();
    if ((!message && !file) || !sid) return;
    chatInput.value = "";
    try {
      await fetch(`${BASE_URL}/app/chat/message`, {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({
          sessionId: sid, shop, message,
          fileUrl : file,
          email   : localStorage.getItem(SK.EMAIL),
          fname   : localStorage.getItem(SK.FNAME)
        })
      });
      fetchMessages();
    } catch (_) {}
  }

  /* ── search ── */
  async function performSearchNew(query) {
    if (!query || query.length < 2) {
      document.getElementById("search-results-wrapper").style.display = "none";
      document.getElementById("search-empty-state").style.display     = "block";
      document.getElementById("no-results-state").style.display       = "none";
      document.querySelector(".search-hero").style.display             = "block";
      return;
    }

    document.getElementById("search-loading-indicator").style.display = "flex";
    document.getElementById("search-empty-state").style.display       = "none";
    document.getElementById("no-results-state").style.display         = "none";
    document.querySelector(".search-hero").style.display               = "block";

    try {
      await fetch(`${BASE_URL}/app/chat/search-log`, {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({
          shop, query, searchType: "frontend",
          userEmail : localStorage.getItem(SK.EMAIL) || 'anonymous',
          sessionId : localStorage.getItem(SK.SID)   || 'no-session',
          firstName : localStorage.getItem(SK.FNAME) || '',
          lastName  : localStorage.getItem(SK.LNAME) || '',
          createdAt : new Date()
        })
      });
    } catch (_) {}

    try {
      const res  = await fetch(`${BASE_URL}/app/chat/search?shop=${encodeURIComponent(shop)}&query=${encodeURIComponent(query)}&type=all`);
      const data = await res.json();
      document.getElementById("search-loading-indicator").style.display = "none";
      if (!data.success) {
        document.getElementById("no-results-state").style.display = "block";
        document.querySelector(".search-hero").style.display       = "none";
        return;
      }
      document.querySelector(".search-hero").style.display = "none";
      renderSearchResultsNew(data.results);
    } catch (_) {
      document.getElementById("search-loading-indicator").style.display = "none";
      document.getElementById("no-results-state").style.display         = "block";
      document.querySelector(".search-hero").style.display               = "none";
    }
  }

  function renderSearchResultsNew(results) {
    const has = (results.products    && results.products.length)    ||
                (results.collections && results.collections.length) ||
                (results.pages       && results.pages.length)       ||
                (results.orders      && results.orders.length);
    if (!has) {
      document.getElementById("search-results-wrapper").style.display = "none";
      document.getElementById("no-results-state").style.display       = "block";
      return;
    }
    document.getElementById("search-results-wrapper").style.display = "block";
    document.getElementById("search-empty-state").style.display     = "none";
    document.getElementById("no-results-state").style.display       = "none";

    function fill(section, items, cardFn) {
      const wrap  = document.getElementById(`${section}-results-section`);
      const count = document.getElementById(`${section}-count`);
      const scroll= document.getElementById(`${section}-scroll`);
      if (items && items.length) {
        wrap.style.display = "block";
        count.textContent  = items.length;
        scroll.innerHTML   = items.map(cardFn).join('');
        scroll.classList.toggle('few-results', items.length <= 2);
        const lb = wrap.querySelector('.scroll-left');
        const rb = wrap.querySelector('.scroll-right');
        if (items.length <= 1) { if(lb) lb.style.display='none'; if(rb) rb.style.display='none'; }
        else { if(lb) lb.style.display='flex'; if(rb) rb.style.display='flex'; }
      } else {
        wrap.style.display = "none";
      }
    }

    const primaryColor = currentConfig.primaryColor || '#F39C12';

    fill('products', results.products, p =>
      `<div class="result-card" onclick="window.open('${p.url}','_blank')">
        ${p.image ? `<img src="${p.image}" class="result-card-image" alt="${p.title}"/>` : '<div class="result-card-image"></div>'}
        <div class="result-card-content">
          <div class="result-card-title">${p.title}</div>
          <div class="result-card-price" style="color:${primaryColor}">${p.currency} ${parseFloat(p.price).toFixed(2)}</div>
        </div>
      </div>`
    );

    fill('collections', results.collections, c =>
      `<div class="result-card" onclick="window.open('${c.url}','_blank')">
        ${c.image ? `<img src="${c.image}" class="result-card-image" alt="${c.title}"/>` : '<div class="result-card-image"></div>'}
        <div class="result-card-content">
          <div class="result-card-title">${c.title}</div>
          <div class="result-card-meta">${c.productCount || 0} products</div>
        </div>
      </div>`
    );

    fill('pages', results.pages, pg =>
      `<div class="result-card" onclick="window.open('${pg.url}','_blank')">
        <div class="result-card-image"></div>
        <div class="result-card-content">
          <div class="result-card-type" style="background:${primaryColor}">Page</div>
          <div class="result-card-title">${pg.title}</div>
          ${pg.description ? `<div class="result-card-meta">${pg.description.substring(0,55)}…</div>` : ''}
        </div>
      </div>`
    );

    fill('orders', results.orders, o =>
      `<div class="result-card">
        <div class="result-card-image"></div>
        <div class="result-card-content">
          <div class="result-card-type" style="background:${primaryColor}">Order</div>
          <div class="result-card-title">${o.orderNumber}</div>
          <div class="result-card-price" style="color:${primaryColor}">${o.currency} ${parseFloat(o.total).toFixed(2)}</div>
          <div class="result-card-meta">${o.email}</div>
        </div>
      </div>`
    );
  }

  window.scrollSection = function(section, dir) {
    const el = document.getElementById(`${section}-scroll`);
    el.scrollBy({ left: dir === 'left' ? -200 : 200, behavior: 'smooth' });
  };

  /* ── FAQs ── */
  async function loadFAQs() {
    try {
      const res  = await fetch(`${BASE_URL}/api/faq/categories?shop=${shop}`);
      const data = await res.json();
      faqData = data.categories || [];
      renderHomeFAQs();
      renderFAQs();
    } catch (_) {
      document.getElementById("faq-categories-list").innerHTML =
        '<div style="text-align:center;padding:40px 20px;color:#888;">❌ Failed to load FAQs</div>';
    }
  }

  function renderHomeFAQs() {
    const c = document.getElementById("home-faq-list");
    c.innerHTML = '';
    faqData.forEach(cat => {
      if (!cat.isActive || !cat.faqs) return;
      cat.faqs.filter(f => f.isActive).forEach(faq => {
        const item = document.createElement("div");
        item.className = "faq-item";
        item.setAttribute('data-faq-id', faq.id);  // Store FAQ ID for later reference
        item.innerHTML = `
          <div class="faq-question">${faq.question}</div>
          <div class="faq-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>`;
        
        // NEW: Navigate to FAQ tab and expand this specific FAQ
        item.onclick = () => {
          // Switch to FAQ tab
          document.querySelector('[data-tab="faq"]').click();
          
          // Wait for tab to render, then find and expand the matching FAQ
          setTimeout(() => {
            const faqTabItem = document.querySelector(`#faq-categories-list .faq-item[data-faq-id="${faq.id}"]`);
            if (faqTabItem && !faqTabItem.classList.contains('open')) {
              faqTabItem.click();
              // Scroll into view
              faqTabItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }, 100);
        };
        c.appendChild(item);
      });
    });
    if (!c.children.length)
      c.innerHTML = '<div style="text-align:center;padding:30px;color:#999;">❓ No FAQs available</div>';
  }

  function renderFAQs() {
    const c = document.getElementById("faq-categories-list");
    c.innerHTML = '';
    faqData.forEach(cat => {
      if (!cat.isActive || !cat.faqs) return;
      const active = cat.faqs.filter(f => f.isActive);
      if (!active.length) return;
      const catDiv = document.createElement('div');
      catDiv.className = 'faq-category';
      const primaryColor = currentConfig.primaryColor || '#F39C12';
      let html = `<div class="faq-category-title"><span>${cat.title}</span><span class="faq-category-badge" style="background:${primaryColor}">${active.length}</span></div>`;
      active.forEach(faq => {
        const id = `faq-${faq.id}`;
        html += `<div class="faq-item" data-faq-id="${faq.id}" onclick="window.toggleFaq('${id}')">
          <div class="faq-question">${faq.question}</div>
          <div class="faq-arrow" id="${id}-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
          </div>
          <div class="faq-answer" id="${id}-answer" style="display:none;">
            <div class="faq-answer-text">${faq.answer}</div>
          </div>
        </div>`;
      });
      catDiv.innerHTML = html;
      c.appendChild(catDiv);
    });
  }

  window.toggleFaq = function(id) {
    const item  = document.querySelector(`[data-faq-id]`);
    const ans   = document.getElementById(`${id}-answer`);
    const arrow = document.getElementById(`${id}-arrow`);
    if (ans && arrow) {
      const open = ans.style.display === 'block';
      ans.style.display = open ? 'none' : 'block';
      if (arrow.parentElement) {
        if (open) {
          arrow.parentElement.classList.remove('open');
        } else {
          arrow.parentElement.classList.add('open');
        }
      }
    }
  };

  /* ── DOM-ready bindings ── */
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById("store-search-input-new");
    const searchBtn   = document.getElementById("search-icon-btn");

    searchBtn && searchBtn.addEventListener('click', () => {
      const q = searchInput.value.trim();
      if (q) performSearchNew(q);
    });
    searchInput && searchInput.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); const q = searchInput.value.trim(); if (q) performSearchNew(q); }
    });

    const hsi = document.getElementById("home-search-input");
    const hsb = document.getElementById("home-search-btn");
    
    function goSearch(q) {
      if (!faqData.length) {
        loadFAQs().then(() => switchToFAQ(q));
      } else {
        switchToFAQ(q);
      }
    }
    function switchToFAQ(q) {
      document.querySelector('[data-tab="faq"]').click();
      setTimeout(() => {
        const faqInput = document.getElementById("faq-search-input");
        if (faqInput) {
          faqInput.value = q;
          faqInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }, 80);
    }
    hsb && hsb.addEventListener('click', () => { const q = hsi.value.trim(); if (q) goSearch(q); });
    hsi && hsi.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); const q = hsi.value.trim(); if (q) goSearch(q); } });

    const fsi = document.getElementById("faq-search-input");
    fsi && fsi.addEventListener('input', e => {
      const term = e.target.value.toLowerCase();
      document.querySelectorAll('#faq-categories-list .faq-item').forEach(item => {
        const q = (item.querySelector('.faq-question')?.textContent || '').toLowerCase();
        const a = (item.querySelector('.faq-answer-text')?.textContent || '').toLowerCase();
        item.style.display = (q.includes(term) || a.includes(term)) ? '' : 'none';
      });
      document.querySelectorAll('.faq-category').forEach(cat => {
        cat.style.display = cat.querySelectorAll('.faq-item:not([style*="display: none"])').length ? '' : 'none';
      });
    });
  });

  /* ── polling helpers ── */
  function startPolling() {
    fetchMessages();
    if (pollInterval) clearInterval(pollInterval);
    pollInterval = setInterval(fetchMessages, 3500);
  }

  /* ── launcher toggle ── */
  launcher.onclick = () => {
    const open = widget.classList.toggle("chat-visible");
    widget.classList.toggle("chat-hidden", !open);
    document.getElementById("launcher-icon").style.display       = open ? "none"  : "block";
    document.getElementById("close-launcher-icon").style.display = open ? "flex"  : "none";
  };

  /* ── tab nav ── */
  document.querySelectorAll('.nav-item').forEach(nav => {
    nav.onclick = () => {
      const tab = nav.dataset.tab;
      document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
      document.getElementById(`tab-${tab}`).style.display = 'flex';
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      nav.classList.add('active');

      if (tab === 'chat') { fetchMessages(); setTimeout(() => msgBox.scrollTop = msgBox.scrollHeight, 80); }
      if (tab === 'faq'  && !faqData.length) loadFAQs();
      if (tab === 'search') {
        document.getElementById("store-search-input-new").value       = "";
        document.getElementById("search-results-wrapper").style.display = "none";
        document.getElementById("search-empty-state").style.display     = "block";
        document.getElementById("no-results-state").style.display       = "none";
        document.querySelector(".search-hero").style.display            = "block";
      }
    };
  });

  /* ── search-here card → search tab ── */
  document.getElementById("search-here-trigger").onclick = () =>
    document.querySelector('[data-tab="search"]').click();

  /* ── contact card → chat tab ── */
  document.querySelector('.contact-card').addEventListener('click', (e) => {
    if (e.target.closest('.chat-now-btn'))
      document.querySelector('[data-tab="chat"]').click();
  });

  /* ── onboarding submit ── */
  submitBtn.onclick = async () => {
    const f = fnameInput.value.trim(), l = lnameInput.value.trim(), e = emailInput.value.trim();
    if (!f || !e) return alert("Required fields missing");
    submitBtn.disabled = true; submitBtn.textContent = "Connecting…";
    const sid = getOrCreateSessionId();
    try {
      const res = await fetch(`${BASE_URL}/app/chat/register`, {
        method: "POST", headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ shop, firstName: f, lastName: l, email: e, sessionId: sid })
      });
      if (res.ok) {
        localStorage.setItem(SK.SID, sid);
        localStorage.setItem(SK.FNAME, f);
        localStorage.setItem(SK.LNAME, l || '');
        localStorage.setItem(SK.EMAIL, e);
        showChatInterface(); startPolling();
      } else alert("Registration failed.");
    } catch (_) { alert("Connection error."); }
    submitBtn.disabled = false; submitBtn.textContent = "Start Chatting";
  };

  /* ── file / image ── */
  const fInput = document.getElementById("chat-file-input");
  document.getElementById("file-btn").onclick = () => fInput.click();
  fInput.onchange = e => {
    const reader = new FileReader();
    reader.onload = ev => {
      selectedImg = ev.target.result;
      document.getElementById("image-preview").src = selectedImg;
      document.getElementById("image-preview-container").style.display = "block";
    };
    reader.readAsDataURL(e.target.files[0]);
  };
  document.getElementById("send-image-btn").onclick = () => {
    postMessage("", selectedImg); selectedImg = null;
    document.getElementById("image-preview-container").style.display = "none";
  };
  document.getElementById("remove-image-btn").onclick = () => {
    selectedImg = null;
    document.getElementById("image-preview-container").style.display = "none";
  };

  /* ── emoji ── */
  const picker = document.getElementById("emoji-picker");
  picker.innerHTML = ["😊","👋","🙌","🔥","✅","🤔","💡","🚀","❤️","✨","👍","🙏"]
    .map(em => `<span class="e-item" style="cursor:pointer;font-size:20px;">${em}</span>`).join('');
  document.getElementById("emoji-btn").onclick = e => { e.stopPropagation(); picker.classList.toggle("hidden-picker"); };
  picker.onclick = e => {
    if (e.target.classList.contains('e-item')) { chatInput.value += e.target.innerText; picker.classList.add("hidden-picker"); chatInput.focus(); }
  };

  /* ── send shortcuts ── */
  chatInput.onkeydown = e => { if (e.key === 'Enter') postMessage(); };
  document.getElementById("chat-send").onclick = () => postMessage();
  document.getElementById("chat-close").onclick = () => launcher.click();

  /* ── INIT ── */
  async function initialize() {
    await loadSettings();
    await loadFAQs();
    await checkExistingSession();
    startStatusPolling();
  }
  initialize();

})();
</script>

{% schema %}
{
  "name": "Talksy Chat",
  "target": "section",
  "settings": []
}
{% endschema %}