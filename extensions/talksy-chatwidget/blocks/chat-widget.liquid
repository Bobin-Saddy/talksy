<script>
(() => {
  /* ── config ── */
  const shop     = "{{ shop.permanent_domain }}";
  const BASE_URL = "https://talksy-production-2e93.up.railway.app";

  /* ── DOM refs ── */
  const widget      = document.getElementById("chat-widget");
  const launcher    = document.getElementById("chat-launcher");
  const chatInput   = document.getElementById("chat-input");
  const msgBox      = document.getElementById("chat-messages");
  const submitBtn   = document.getElementById("chat-submit-info");
  const fnameInput  = document.getElementById("chat-fname");
  const lnameInput  = document.getElementById("chat-lname");
  const emailInput  = document.getElementById("chat-email");

  /* ── state ── */
  let selectedImg    = null;
  let pollInterval   = null;
  let statusInterval = null;
  let currentConfig  = {};
  let seenMsgs       = new Set();
  let faqData        = [];
  let adminOnline    = true;
  
  // Store last search query and results
  let lastSearchQuery = '';
  let lastSearchResults = null;
  let previousSearchQuery = '';
  let previousSearchResults = null;

  /* ── localStorage keys ── */
  const SK = {
    SID   : `chat_session_${shop}`,
    EMAIL : `chat_email_${shop}`,
    FNAME : `chat_fname_${shop}`,
    LNAME : `chat_lname_${shop}`,
    SEARCH_QUERY: `chat_search_query_${shop}`,
    SEARCH_RESULTS: `chat_search_results_${shop}`
  };

  /* ─────────────────────────────────────────────
     ADMIN ONLINE / OFFLINE STATUS
     ───────────────────────────────────────────── */
  function applyStatus(online) {
    adminOnline = online;
    const dot  = document.getElementById("status-dot");
    const txt  = document.getElementById("status-text");
    if (!dot || !txt) return;

    if (online) {
      dot.style.background = "#22c55e";
      txt.textContent      = "We are online";
    } else {
      dot.style.background = "#ef4444";
      txt.textContent      = "We are offline";
    }
  }

  async function pollAdminStatus() {
    try {
      const res  = await fetch(`${BASE_URL}/app/admin-status?shop=${shop}`);
      const data = await res.json();
      applyStatus(data.online);
    } catch (_) {
      applyStatus(false);
    }
  }

  function startStatusPolling() {
    pollAdminStatus();
    if (statusInterval) clearInterval(statusInterval);
    statusInterval = setInterval(pollAdminStatus, 10000);
  }

  /* ── form validation ── */
  function validateForm() {
    const f = fnameInput.value.trim();
    const e = emailInput.value.trim();
    submitBtn.disabled = !(f && e && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e));
  }
  fnameInput.addEventListener('input', validateForm);
  lnameInput.addEventListener('input', validateForm);
  emailInput.addEventListener('input', validateForm);

  /* ── icon helpers ── */
  const ICON_SVGS = {
    bubble: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>',
    send  : '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>',
    defaultCustom: '<img src="https://alert-lime-e4qtqvlkob.edgeone.app/icon-frame.png" style="width:30px;height:30px;object-fit:contain;"/>'
  };

  /* ── load remote settings ── */
  async function loadSettings() {
    try {
      const r = await fetch(`${BASE_URL}/api/chat-settings?shop=${shop}`);
      const s = await r.json();
      currentConfig = s;

      const hdr = document.getElementById("chat-header");
      if (s.headerGradientStart && s.headerGradientEnd) {
        hdr.style.background = `linear-gradient(135deg, ${s.headerGradientStart}, ${s.headerGradientEnd})`;
      } else {
        hdr.style.background = "linear-gradient(135deg, #F39C12, #E67E22)";
      }

      hdr.style.color = s.headerTextColor || "#fff";

      const textColor = s.headerTextColor || "#fff";
      document.getElementById("header-title-text").style.color    = textColor;
      document.getElementById("header-subtitle-text").style.color = textColor;
      document.getElementById("header-title-text").innerText    = s.welcomeText    || "Hello 👋";
      document.getElementById("header-subtitle-text").innerText = s.welcomeSubtext || "How can we help you?";
      document.getElementById("contact-title").innerText        = s.startConversationText || "Contact us";

      if (s.searchCardTitle)    document.getElementById("search-card-title").innerText    = s.searchCardTitle;
      if (s.searchCardSubtitle) document.getElementById("search-card-subtitle").innerText = s.searchCardSubtitle;

      document.getElementById("onboarding-form-title").innerText    = s.onboardingTitle    || "Identify Yourself";
      document.getElementById("onboarding-form-subtitle").innerText = s.onboardingSubtitle || "How should we address you?";

