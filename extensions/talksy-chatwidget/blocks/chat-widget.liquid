<script>
(() => {
  const shop = "{{ shop.permanent_domain }}";
  const BASE_URL = "https://talksy-production-2e93.up.railway.app"; 
  const widget = document.getElementById("chat-widget");
  const launcher = document.getElementById("chat-launcher");
  const chatInput = document.getElementById("chat-input");
  const msgBox = document.getElementById("chat-messages");
  const submitBtn = document.getElementById("chat-submit-info");
  const fnameInput = document.getElementById("chat-fname");
  const lnameInput = document.getElementById("chat-lname");
  const emailInput = document.getElementById("chat-email");
  
  let selectedImg = null;
  let pollInterval = null; 
  let currentConfig = {};
  let seenMsgs = new Set();
  let faqData = [];

  const STORAGE_KEYS = {
    SESSION_ID: `chat_session_${shop}`,
    USER_EMAIL: `chat_email_${shop}`,
    USER_FNAME: `chat_fname_${shop}`,
    USER_LNAME: `chat_lname_${shop}`
  };

  try {
    localStorage.setItem("__test", "1");
    localStorage.removeItem("__test");
  } catch (e) {
    console.warn("LocalStorage blocked");
  }

  function getOrCreateSessionId() {
    let sId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    if (!sId || sId === "null" || sId === "undefined") {
      sId = "s_" + crypto.randomUUID();
      localStorage.setItem(STORAGE_KEYS.SESSION_ID, sId);
    }
    return sId;
  }

  function validateForm() {
    const fname = fnameInput.value.trim();
    const email = emailInput.value.trim();
    const isValid = fname && email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    submitBtn.disabled = !isValid;
  }

  fnameInput.addEventListener('input', validateForm);
  lnameInput.addEventListener('input', validateForm);
  emailInput.addEventListener('input', validateForm);

  const ICON_SVGS = {
    bubble: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>',
    send: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>',
    defaultCustom: '<img src="https://alert-lime-e4qtqvlkob.edgeone.app/icon-frame.png" style="width:30px;height:30px;object-fit:contain;"/>'
  };

  async function loadSettings() {
    try {
      const r = await fetch(`${BASE_URL}/api/chat-settings?shop=${shop}`);
      const s = await r.json();
      currentConfig = s;
      
      let cleanFont = s.fontFamily.replace(/['"]+/g, "'"); 
      
      document.documentElement.style.setProperty('--chat-primary', s.primaryColor);
      document.documentElement.style.setProperty('--chat-font', cleanFont);
      document.documentElement.style.setProperty('--chat-font-size', s.baseFontSize);

      widget.style.border = `1px solid ${s.widgetBorderColor}`;
      widget.style.background = s.chatBoxBgColor;
      launcher.style.color = s.primaryColor;

      const header = document.getElementById("chat-header");
      header.style.background = s.headerBgColor;
      header.style.color = s.headerTextColor;
      
      document.getElementById("header-title-text").innerText = s.welcomeText;
      document.getElementById("header-subtitle-text").innerText = s.welcomeSubtext;

      document.getElementById("home-scroll-area-bg").style.background = s.chatBoxBgColor;

      document.getElementById("contact-title").innerText = s.startConversationText;
      
      const chatNowBtn = document.getElementById("chat-now-btn");
      if(chatNowBtn) chatNowBtn.style.background = s.primaryColor;

      document.getElementById("onboarding-form-title").innerText = s.onboardingTitle;
      document.getElementById("onboarding-form-subtitle").innerText = s.onboardingSubtitle;

      if (s.launcherIcon === 'custom' && s.customLauncherImg) {
        document.getElementById("launcher-icon").innerHTML = `<img src="${s.customLauncherImg}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;"/>`;
      } else {
        document.getElementById("launcher-icon").innerHTML = ICON_SVGS[s.launcherIcon] || ICON_SVGS.bubble;
      }

    } catch (e) { 
      console.error("Setup Error", e); 
    }
  }

  async function checkExistingSession() {
    const existingSession = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    const existingEmail = localStorage.getItem(STORAGE_KEYS.USER_EMAIL);
    const existingFname = localStorage.getItem(STORAGE_KEYS.USER_FNAME);

    if(!existingSession || !existingEmail || !existingFname) {
      return false;
    }

    try {
      const response = await fetch(`${BASE_URL}/app/chat/validate-session`, {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ 
          shop, 
          sessionId: existingSession,
          email: existingEmail 
        })
      });

      const data = await response.json();

      if(response.ok && data.valid) {
        showChatInterface();
        startPolling();
        return true;
      } else {
        clearSession();
        return false;
      }
    } catch(e) {
      clearSession();
      return false;
    }
  }

  function clearSession() {
    Object.values(STORAGE_KEYS).forEach(key => localStorage.removeItem(key));
    document.getElementById("chat-onboarding-step").style.display = "flex";
    document.getElementById("chat-chat-step").style.display = "none";
  }

  function showChatInterface() {
    document.getElementById("chat-onboarding-step").style.display = "none";
    document.getElementById("chat-chat-step").style.display = "flex";
  }

  async function performSearchNew(query) {
    if (!query || query.length < 2) {
      document.getElementById("search-results-wrapper").style.display = "none";
      document.getElementById("search-empty-state").style.display = "block";
      document.getElementById("no-results-state").style.display = "none";
      document.querySelector(".search-hero").style.display = "block";
      return;
    }

    document.getElementById("search-loading-indicator").style.display = "flex";
    document.getElementById("search-empty-state").style.display = "none";
    document.getElementById("no-results-state").style.display = "none";
    document.querySelector(".search-hero").style.display = "block";

    try {
      const userEmail = localStorage.getItem(STORAGE_KEYS.USER_EMAIL) || 'anonymous';
      const sessionId = localStorage.getItem(STORAGE_KEYS.SESSION_ID) || 'no-session';
      const firstName = localStorage.getItem(STORAGE_KEYS.USER_FNAME) || '';
      const lastName = localStorage.getItem(STORAGE_KEYS.USER_LNAME) || '';
      
      await fetch(`${BASE_URL}/app/chat/search-log`, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({
          shop: shop,
          query: query,
          searchType: "frontend",
          userEmail: userEmail,
          sessionId: sessionId,
          firstName: firstName,
          lastName: lastName,
          createdAt: new Date()
        })
      });
      
    } catch(e) {
      console.error("Search logging failed:", e);
    }

    try {
      const searchUrl = `${BASE_URL}/app/chat/search?shop=${encodeURIComponent(shop)}&query=${encodeURIComponent(query)}&type=all`;
      
      const response = await fetch(searchUrl);
      const data = await response.json();

      document.getElementById("search-loading-indicator").style.display = "none";

      if (!data.success) {
        document.getElementById("no-results-state").style.display = "block";
        document.querySelector(".search-hero").style.display = "none";
        return;
      }
      
      document.querySelector(".search-hero").style.display = "none";
      renderSearchResultsNew(data.results);
    } catch (error) {
      console.error("Search error:", error);
      document.getElementById("search-loading-indicator").style.display = "none";
      document.getElementById("no-results-state").style.display = "block";
      document.querySelector(".search-hero").style.display = "none";
    }
  }

  function renderSearchResultsNew(results) {
    const hasResults = (
      (results.products && results.products.length > 0) ||
      (results.collections && results.collections.length > 0) ||
      (results.pages && results.pages.length > 0) ||
      (results.orders && results.orders.length > 0)
    );

    if (!hasResults) {
      document.getElementById("search-results-wrapper").style.display = "none";
      document.getElementById("no-results-state").style.display = "block";
      document.getElementById("search-empty-state").style.display = "none";
      return;
    }

    document.getElementById("search-results-wrapper").style.display = "block";
    document.getElementById("search-empty-state").style.display = "none";
    document.getElementById("no-results-state").style.display = "none";

    function updateScrollButtons(section, count) {
      const leftBtn = document.querySelector(`#${section}-results-section .scroll-left`);
      const rightBtn = document.querySelector(`#${section}-results-section .scroll-right`);
      
      if (count <= 1) {
        if (leftBtn) leftBtn.style.display = 'none';
        if (rightBtn) rightBtn.style.display = 'none';
      } else {
        if (leftBtn) leftBtn.style.display = 'flex';
        if (rightBtn) rightBtn.style.display = 'flex';
      }
    }

    if (results.products && results.products.length > 0) {
      document.getElementById("products-results-section").style.display = "block";
      document.getElementById("products-count").textContent = results.products.length;
      
      const productsHTML = results.products.map(product => `
        <div class="result-card" onclick="window.open('${product.url}', '_blank')">
          ${product.image ? `<img src="${product.image}" class="result-card-image" alt="${product.title}" />` : '<div class="result-card-image"></div>'}
          <div class="result-card-content">
            <div class="result-card-title">${product.title}</div>
            <div class="result-card-price">${product.currency} ${parseFloat(product.price).toFixed(2)}</div>
          </div>
        </div>
      `).join('');
      
      const productsScroll = document.getElementById("products-scroll");
      productsScroll.innerHTML = productsHTML;
      
      if (results.products.length <= 2) {
        productsScroll.classList.add('few-results');
      } else {
        productsScroll.classList.remove('few-results');
      }
      
      updateScrollButtons('products', results.products.length);
    } else {
      document.getElementById("products-results-section").style.display = "none";
    }

    if (results.collections && results.collections.length > 0) {
      document.getElementById("collections-results-section").style.display = "block";
      document.getElementById("collections-count").textContent = results.collections.length;
      
      const collectionsHTML = results.collections.map(collection => `
        <div class="result-card" onclick="window.open('${collection.url}', '_blank')">
          ${collection.image ? `<img src="${collection.image}" class="result-card-image" alt="${collection.title}" />` : '<div class="result-card-image"></div>'}
          <div class="result-card-content">
            <div class="result-card-title">${collection.title}</div>
            <div class="result-card-meta">${collection.productCount || 0} products</div>
          </div>
        </div>
      `).join('');
      
      const collectionsScroll = document.getElementById("collections-scroll");
      collectionsScroll.innerHTML = collectionsHTML;
      
      if (results.collections.length <= 2) {
        collectionsScroll.classList.add('few-results');
      } else {
        collectionsScroll.classList.remove('few-results');
      }
      
      updateScrollButtons('collections', results.collections.length);
    } else {
      document.getElementById("collections-results-section").style.display = "none";
    }

    if (results.pages && results.pages.length > 0) {
      document.getElementById("pages-results-section").style.display = "block";
      document.getElementById("pages-count").textContent = results.pages.length;
      
      const pagesHTML = results.pages.map(page => `
        <div class="result-card" onclick="window.open('${page.url}', '_blank')">
          <div class="result-card-image"></div>
          <div class="result-card-content">
            <div class="result-card-type">Page</div>
            <div class="result-card-title">${page.title}</div>
            ${page.description ? `<div class="result-card-meta">${page.description.substring(0, 60)}...</div>` : ''}
          </div>
        </div>
      `).join('');
      
      const pagesScroll = document.getElementById("pages-scroll");
      pagesScroll.innerHTML = pagesHTML;
      
      if (results.pages.length <= 2) {
        pagesScroll.classList.add('few-results');
      } else {
        pagesScroll.classList.remove('few-results');
      }
      
      updateScrollButtons('pages', results.pages.length);
    } else {
      document.getElementById("pages-results-section").style.display = "none";
    }

    if (results.orders && results.orders.length > 0) {
      document.getElementById("orders-results-section").style.display = "block";
      document.getElementById("orders-count").textContent = results.orders.length;
      
      const ordersHTML = results.orders.map(order => `
        <div class="result-card">
          <div class="result-card-image"></div>
          <div class="result-card-content">
            <div class="result-card-type">Order</div>
            <div class="result-card-title">${order.orderNumber}</div>
            <div class="result-card-price">${order.currency} ${parseFloat(order.total).toFixed(2)}</div>
            <div class="result-card-meta">${order.email}</div>
          </div>
        </div>
      `).join('');
      
      const ordersScroll = document.getElementById("orders-scroll");
      ordersScroll.innerHTML = ordersHTML;
      
      if (results.orders.length <= 2) {
        ordersScroll.classList.add('few-results');
      } else {
        ordersScroll.classList.remove('few-results');
      }
      
      updateScrollButtons('orders', results.orders.length);
    } else {
      document.getElementById("orders-results-section").style.display = "none";
    }
  }

  window.scrollSection = function(section, direction) {
    const scrollContainer = document.getElementById(`${section}-scroll`);
    const scrollAmount = 220;
    
    if (direction === 'left') {
      scrollContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    } else {
      scrollContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    }
  };

  async function loadFAQs() {
    try {
      const response = await fetch(`${BASE_URL}/api/faq/categories?shop=${shop}`);
      const data = await response.json();
      
      faqData = data.categories || [];
      renderHomeFAQs();
      renderFAQs();
    } catch (error) {
      console.error("Error loading FAQs:", error);
      document.getElementById("faq-categories-list").innerHTML = `
        <div class="faq-empty">
          <div class="faq-empty-icon">❌</div>
          <div class="faq-empty-text">Failed to load FAQs</div>
          <p class="faq-empty-subtext">Please try again later</p>
        </div>
      `;
    }
  }

  function renderHomeFAQs() {
    const container = document.getElementById("home-faq-list");
    
    if (!faqData.length || !faqData.some(cat => cat.isActive && cat.faqs && cat.faqs.length > 0)) {
      container.innerHTML = `
        <div class="faq-empty" style="padding: 20px;">
          <div class="faq-empty-icon">❓</div>
          <div class="faq-empty-text">No FAQs Available</div>
        </div>
      `;
      return;
    }

    container.innerHTML = '';

    faqData.forEach(category => {
      if (!category.isActive || !category.faqs || !category.faqs.length) return;

      const activeFaqs = category.faqs.filter(f => f.isActive);
      
      activeFaqs.forEach(faq => {
        const faqItem = document.createElement('div');
        faqItem.className = 'faq-item';
        faqItem.innerHTML = `
          <div class="faq-question">${faq.question}</div>
          <div class="faq-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        `;
        
        faqItem.onclick = () => {
          faqItem.classList.toggle('open');
          if (faqItem.classList.contains('open') && !faqItem.querySelector('.faq-answer')) {
            const answerDiv = document.createElement('div');
            answerDiv.className = 'faq-answer';
            answerDiv.innerHTML = `<div class="faq-answer-text">${faq.answer}</div>`;
            faqItem.appendChild(answerDiv);
          }
        };
        
        container.appendChild(faqItem);
      });
    });
  }

  function renderFAQs() {
    const container = document.getElementById("faq-categories-list");
    
    if (!faqData.length || !faqData.some(cat => cat.isActive && cat.faqs && cat.faqs.length > 0)) {
      container.innerHTML = `
        <div class="faq-empty">
          <div class="faq-empty-icon">❓</div>
          <div class="faq-empty-text">No FAQs Available</div>
          <p class="faq-empty-subtext">Check back later for helpful information</p>
        </div>
      `;
      return;
    }

    container.innerHTML = '';

    faqData.forEach(category => {
      if (!category.isActive || !category.faqs || !category.faqs.length) return;

      const categoryDiv = document.createElement('div');
      categoryDiv.className = 'faq-category';
      
      const activeFaqs = category.faqs.filter(f => f.isActive);
      
      let categoryHTML = `
        <div class="faq-category-title">
          <span>${category.title}</span>
          <span class="faq-category-badge">${activeFaqs.length}</span>
        </div>
      `;

      activeFaqs.forEach(faq => {
        const faqId = `faq-${faq.id}`;
        categoryHTML += `
          <div class="faq-item" onclick="toggleFaq('${faqId}')">
            <div class="faq-question">${faq.question}</div>
            <div class="faq-arrow" id="${faqId}-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </div>
            <div class="faq-answer" id="${faqId}-answer" style="display:none;">
              <div class="faq-answer-text">${faq.answer}</div>
            </div>
          </div>
        `;
      });

      categoryDiv.innerHTML = categoryHTML;
      container.appendChild(categoryDiv);
    });
  }

  window.toggleFaq = function(faqId) {
    const answer = document.getElementById(`${faqId}-answer`);
    const arrow = document.getElementById(`${faqId}-arrow`);
    
    if (answer && arrow) {
      const isOpen = answer.style.display === 'block';
      answer.style.display = isOpen ? 'none' : 'block';
      arrow.parentElement.classList.toggle('open');
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const storeSearchInputNew = document.getElementById("store-search-input-new");
    const searchIconBtn = document.getElementById("search-icon-btn");
    const faqSearchInput = document.getElementById("faq-search-input");
    const homeSearchInput = document.getElementById("home-search-input");
    const homeSearchBtn = document.getElementById("home-search-btn");
    
    if (searchIconBtn) {
      searchIconBtn.addEventListener('click', () => {
        const query = storeSearchInputNew.value.trim();
        if (query) {
          performSearchNew(query);
        }
      });
    }

    if (storeSearchInputNew) {
      storeSearchInputNew.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          const query = storeSearchInputNew.value.trim();
          if (query) {
            performSearchNew(query);
          }
        }
      });
    }

    if (homeSearchBtn && homeSearchInput) {
      homeSearchBtn.addEventListener('click', () => {
        const query = homeSearchInput.value.trim();
        if (query) {
          document.querySelector('[data-tab="search"]').click();
          setTimeout(() => {
            document.getElementById("store-search-input-new").value = query;
            performSearchNew(query);
          }, 100);
        }
      });

      homeSearchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const query = homeSearchInput.value.trim();
          if (query) {
            document.querySelector('[data-tab="search"]').click();
            setTimeout(() => {
              document.getElementById("store-search-input-new").value = query;
              performSearchNew(query);
            }, 100);
          }
        }
      });
    }

    if (faqSearchInput) {
      faqSearchInput.addEventListener('input', (e) => {
        const searchTerm = e.target.value.toLowerCase();
        const faqItems = document.querySelectorAll('#faq-categories-list .faq-item');

        faqItems.forEach(item => {
          const question = item.querySelector('.faq-question')?.textContent.toLowerCase() || '';
          const answer = item.querySelector('.faq-answer-text')?.textContent.toLowerCase() || '';
          
          if (question.includes(searchTerm) || answer.includes(searchTerm)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });

        document.querySelectorAll('.faq-category').forEach(category => {
          const visibleItems = category.querySelectorAll('.faq-item:not([style*="display: none"])');
          category.style.display = visibleItems.length > 0 ? '' : 'none';
        });
      });
    }
  });

  async function fetchMessages() {
    const sId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    if (!sId) return;
    try {
      const res = await fetch(`${BASE_URL}/app/chat/messages?shop=${shop}&sessionId=${sId}`);
      const data = await res.json();
      data.sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt)).forEach(renderMsg);
    } catch (e) {}
  }

  function renderMsg(m) {
    if (seenMsgs.has(m.id)) return;
    seenMsgs.add(m.id);
    const div = document.createElement("div");
    const isBot = (m.sender === 'admin' || m.sender === 'bot');
    div.className = `msg ${isBot ? 'bot' : 'user'}`;
    const bg = isBot ? (currentConfig.messageBgColor || "#fff") : "var(--chat-primary)";
    const color = isBot ? "#1e293b" : "#fff";
    const border = isBot ? `1px solid ${currentConfig.widgetBorderColor}` : 'none';
    div.innerHTML = `<div class="msg-content" style="background:${bg}; color:${color}; border:${border}">${m.message ? `<div>${m.message}</div>` : ''}${m.fileUrl ? `<img src="${m.fileUrl}" style="max-width:100%; border-radius:10px; margin-top:8px; display:block;" />` : ''}</div>`;
    msgBox.appendChild(div);
    msgBox.scrollTop = msgBox.scrollHeight;
  }

  async function postMessage(txt = "", file = null) {
    const sId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);
    const message = txt || chatInput.value.trim();
    if ((!message && !file) || !sId) return;
    chatInput.value = "";
    try {
      await fetch(`${BASE_URL}/app/chat/message`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ 
          sessionId: sId, 
          shop, 
          message, 
          fileUrl: file, 
          email: localStorage.getItem(STORAGE_KEYS.USER_EMAIL), 
          fname: localStorage.getItem(STORAGE_KEYS.USER_FNAME) 
        })
      });
      fetchMessages();
    } catch (e) {}
  }

  launcher.onclick = () => {
    const open = widget.classList.toggle("chat-visible");
    widget.classList.toggle("chat-hidden", !open);
    document.getElementById("launcher-icon").style.display = open ? "none" : "block";
    document.getElementById("close-launcher-icon").style.display = open ? "flex" : "none";
  };

  document.querySelectorAll('.nav-item').forEach(nav => {
    nav.onclick = () => {
      const tab = nav.dataset.tab;
      document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
      document.getElementById(`tab-${tab}`).style.display = 'flex';
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      nav.classList.add('active');
      
      if(tab === 'chat') { 
        fetchMessages(); 
        setTimeout(() => msgBox.scrollTop = msgBox.scrollHeight, 100); 
      }
      
      if(tab === 'faq' && faqData.length === 0) {
        loadFAQs();
      }
      
      if(tab === 'search') {
        document.getElementById("store-search-input-new").value = "";
        document.getElementById("search-results-wrapper").style.display = "none";
        document.getElementById("search-empty-state").style.display = "block";
        document.getElementById("no-results-state").style.display = "none";
        document.querySelector(".search-hero").style.display = "block";
      }
    };
  });

  const trackingCard = document.getElementById("tracking-card-trigger");
  if(trackingCard) {
    trackingCard.onclick = () => {
      document.querySelector('[data-tab="search"]').click();
    };
  }

  submitBtn.onclick = async () => {
    const f = fnameInput.value.trim();
    const l = lnameInput.value.trim();
    const e = emailInput.value.trim();
    
    if(!f || !e) return alert("Required fields missing");

    submitBtn.disabled = true;
    submitBtn.textContent = "Connecting...";

    const sId = getOrCreateSessionId();

    try {
      const res = await fetch(`${BASE_URL}/app/chat/register`, {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ 
          shop, 
          firstName: f, 
          lastName: l,
          email: e, 
          sessionId: sId 
        })
      });

      if(res.ok) {
        const data = await res.json();
        
        localStorage.setItem(STORAGE_KEYS.SESSION_ID, sId);
        localStorage.setItem(STORAGE_KEYS.USER_FNAME, f);
        localStorage.setItem(STORAGE_KEYS.USER_LNAME, l || '');
        localStorage.setItem(STORAGE_KEYS.USER_EMAIL, e);
        
        showChatInterface();
        startPolling();
        
        submitBtn.textContent = "Start Chatting";
        submitBtn.disabled = false;
      } else {
        alert("Registration failed. Please try again.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Start Chatting";
      }
    } catch(e) {
      console.error("Registration error:", e);
      alert("Connection error. Please try again.");
      submitBtn.disabled = false;
      submitBtn.textContent = "Start Chatting";
    }
  };

  const fInput = document.getElementById("chat-file-input");
  document.getElementById("file-btn").onclick = () => fInput.click();
  fInput.onchange = (e) => {
    const reader = new FileReader();
    reader.onload = (ev) => {
      selectedImg = ev.target.result;
      document.getElementById("image-preview").src = selectedImg;
      document.getElementById("image-preview-container").style.display = "";
    };
    reader.readAsDataURL(e.target.files[0]);
  };

  document.getElementById("send-image-btn").onclick = () => {
    postMessage("", selectedImg);
    selectedImg = null;
    document.getElementById("image-preview-container").style.display = "none";
  };

  document.getElementById("remove-image-btn").onclick = () => {
    selectedImg = null;
    document.getElementById("image-preview-container").style.display = "none";
  };

  const picker = document.getElementById("emoji-picker");
  const ems = ["😊","👋","🙌","🔥","✅","🤔","💡","🚀","❤️","✨","👍","🙏"];
  picker.innerHTML = ems.map(em => `<span class="e-item" style="cursor:pointer; font-size:22px;">${em}</span>`).join("");
  document.getElementById("emoji-btn").onclick = (e) => { 
    e.stopPropagation(); 
    picker.classList.toggle("hidden-picker"); 
  };
  picker.onclick = (e) => {
    if(e.target.classList.contains('e-item')) {
      chatInput.value += e.target.innerText;
      picker.classList.add("hidden-picker");
      chatInput.focus();
    }
  };

  function startPolling() {
    fetchMessages();
    if(pollInterval) clearInterval(pollInterval);
    pollInterval = setInterval(fetchMessages, 3500);
  }

  chatInput.onkeydown = (e) => { if(e.key === 'Enter') postMessage(); };
  document.getElementById("chat-send").onclick = () => postMessage();
  document.getElementById("chat-close").onclick = () => launcher.click();
  document.getElementById("start-chat-trigger").onclick = () => document.querySelector('[data-tab="chat"]').click();

  async function initialize() {
    await loadSettings();
    await loadFAQs();
    await checkExistingSession();
  }

  initialize();
})();
</script>

{% schema %}
{
  "name": "Talksy Chat",
  "target": "section",
  "settings": []
}
{% endschema %}