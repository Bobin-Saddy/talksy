}

    /* 5a. Unregistered user → pre-fill + store pending */
    const sessionId = localStorage.getItem(SK.SID);
    const email     = localStorage.getItem(SK.EMAIL);

    if (!sessionId || !email || email === 'null' || email === 'undefined') {
      window._pendingAQQuestion = question;
      const chatInputEl = document.getElementById('chat-input');
      if (chatInputEl) { chatInputEl.value = question.text; chatInputEl.focus(); }
      return;
    }

    /* 5b. Registered user → send message + typing + auto-reply */
    try {
      // STEP 1: Polling rok do — koi interference nahi hogi
      if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }

      // STEP 2: User message turant dikha (optimistic)
      renderUserMsgLocally(question.text);

      // STEP 3: Typing ON
      const typingId = showTypingIndicator();

      // STEP 4: API call AWAIT karo — yeh backend pe user msg + bot reply dono save karta hai
      //         Backend 800ms delay ke baad bot reply save karta hai
      //         Isliye hum await karte hain taaki dono DB mein ho jaayein
      await fetch(`${BASE_URL}/api/animated-questions/send`, {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({
          sessionId,
          shop,
          message    : question.text,
          email,
          fname      : localStorage.getItem(SK.FNAME) || '',
          questionId : question.id,
          autoReply  : question.defaultAnswer || null
        })
      });
      // Note: fetch ke complete hone par user msg + bot reply DONO DB mein hain

      // STEP 5: Typing hide karo (fallback — renderMsg handles it normally)
      hideTypingIndicator(typingId);

      // STEP 6: Fresh fetch — bot reply typing ki jagah smoothly aayega
      await fetchMessages();

      // STEP 7: Bot reply animation (0.25s) complete hone do, PHIR related chips
      const children = getChildQuestions(question.id);
      if (children.length > 0) {
        await new Promise(r => setTimeout(r, 350));
        showChildChips(children, question.id);
        msgBox.scrollTop = msgBox.scrollHeight;
      }

      // STEP 8: Polling resume
      pollInterval = setInterval(fetchMessages, 3500);

    } catch (err) {
      console.error('[AQ] send error:', err);
      const chatInputEl = document.getElementById('chat-input');
      if (chatInputEl) { chatInputEl.value = question.text; chatInputEl.focus(); }
    }
  }

  /* ── Render user message locally (optimistic) ──
     ✅ FIX: data-local-text attribute lagao — fetchMessages isko replace karega,
     duplicate nahi banayega                                                     */
  let _pendingLocalText = null;   // track karo kaunsa text locally rendered hai

  function renderUserMsgLocally(text) {
    _pendingLocalText = text;
    const div = document.createElement('div');
    div.className         = 'msg user';
    div.dataset.localText = text;
    div.innerHTML = `<div class="msg-content" style="background:#F39C12;color:#fff;border:none;opacity:0;transform:translateY(8px);transition:opacity 0.22s ease-out,transform 0.22s ease-out;">
      <div>${escapeHtml(text)}</div>
    </div>`;
    msgBox.appendChild(div);
    requestAnimationFrame(() => {
      const mc = div.querySelector('.msg-content');
      if (mc) { mc.style.opacity = '1'; mc.style.transform = 'translateY(0)'; }
      msgBox.scrollTo({ top: msgBox.scrollHeight, behavior: 'smooth' });
    });
  }

  /* ── Typing indicator (3 bouncing dots) ── */
  function showTypingIndicator() {
    const id  = 'aq-typing-' + Date.now();
    const div = document.createElement('div');
    div.className = 'aq-typing-bubble msg';
    div.id        = id;
    div.style.cssText = 'opacity:0;transform:translateY(8px);transition:opacity 0.22s ease-out,transform 0.22s ease-out;';
    div.innerHTML = `<div class="aq-typing-content">
      <div class="aq-typing-dot"></div>
      <div class="aq-typing-dot"></div>
      <div class="aq-typing-dot"></div>
    </div>`;
    msgBox.appendChild(div);
    requestAnimationFrame(() => {
      div.style.opacity   = '1';
      div.style.transform = 'translateY(0)';
      msgBox.scrollTo({ top: msgBox.scrollHeight, behavior: 'smooth' });
    });
    return id;
  }

function hideTypingIndicator(id) {
  // Bilkul mat hatao — renderMsg replace karega in-place
  // Sirf class change karo taaki pata chale "fading"
  const el = document.getElementById(id);
  if (el) el.dataset.typingFallback = '1';
  // Fallback: agar 4s mein koi bot message nahi aaya toh tab hatao
  setTimeout(() => {
    const stillThere = document.getElementById(id);
    if (stillThere) stillThere.remove();
  }, 4000);
}

  /* ── Show child question chips inside the chat message box ── */
  function showChildChips(children, parentId) {
    if (!children || children.length === 0) return;

    // Remove existing chips for this parent (prevent duplicates)
    const existing = document.getElementById(`aq-chips-${parentId}`);
    if (existing) existing.remove();

    // Outer wrapper — sits in message flow as a "bot row"
    const wrap = document.createElement('div');
    wrap.className = 'msg';                      // left-aligned like bot messages
    wrap.id        = `aq-chips-${parentId}`;
    wrap.style.cssText = 'display:flex;flex-direction:column;align-self:flex-start;max-width:92%;margin-bottom:4px;';
    wrap.classList.add('msg-animate-bot');

    // Label
    const label = document.createElement('div');
    label.style.cssText = 'font-size:11px;color:#9ca3af;font-weight:500;margin-bottom:7px;padding-left:2px;';
    label.textContent   = 'Related questions:';
    wrap.appendChild(label);

    // Chips row
    const row = document.createElement('div');
    row.style.cssText = 'display:flex;flex-wrap:wrap;gap:7px;';

    children.forEach(child => {
      const chip = document.createElement('button');
      chip.type      = 'button';
      chip.className = 'aq-child-chip';
      chip.innerHTML = `<span style="font-size:14px;line-height:1;">${child.icon || '💬'}</span><span>${escapeHtml(child.text)}</span>`;

      chip.addEventListener('click', async () => {
        const sid   = localStorage.getItem(SK.SID);
        const email = localStorage.getItem(SK.EMAIL);
        if (!sid || !email) return;

        // Disable all chips in this row immediately
        row.querySelectorAll('.aq-child-chip').forEach(c => {
        // Disable only the clicked chip
chip.disabled = true;
chip.classList.add('aq-chip-used');
        });

        // Analytics (non-blocking)
        fetch(`${BASE_URL}/api/animated-questions/${child.id}/click`, {
          method : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body   : JSON.stringify({ shop, sessionId: sid })
        }).catch(() => {});

        try {
          // STEP 1: Polling pause
          if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }

          // STEP 2: Child message locally dikha
          renderUserMsgLocally(child.text);

          // STEP 3: Typing ON
          const chipTypingId = showTypingIndicator();

          // STEP 4: AWAIT fetch — user msg + bot reply dono DB mein save hon
          await fetch(`${BASE_URL}/api/animated-questions/send`, {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({
              sessionId  : sid,
              shop,
              message    : child.text,
              email,
              fname      : localStorage.getItem(SK.FNAME) || '',
              questionId : child.id,
              autoReply  : child.defaultAnswer || null
            })
          });

          // STEP 5: Typing hide, messages fetch
          hideTypingIndicator(chipTypingId);
          await fetchMessages();

          // STEP 6: Polling resume
          pollInterval = setInterval(fetchMessages, 3500);

        } catch (err) {
          console.error('[AQ child chip] send error:', err);
          row.querySelectorAll('.aq-child-chip').forEach(c => {
          chip.disabled = false;
chip.classList.remove('aq-chip-used');
          });
          if (!pollInterval) pollInterval = setInterval(fetchMessages, 3500);
        }
      });

      row.appendChild(chip);
    });

    wrap.appendChild(row);
    msgBox.appendChild(wrap);
    msgBox.scrollTop = msgBox.scrollHeight;
  }

  /* ══════════════════════════════════════════
     🔥 FIREBASE PUSH NOTIFICATION SETUP
  ══════════════════════════════════════════ */
  async function initFirebasePush() {
    if (!('serviceWorker' in navigator) || !('Notification' in window)) return;
    try {
      if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
      const messaging = firebase.messaging();
      let swReg;
      try {
        swReg = await navigator.serviceWorker.register(
          '{{ "firebase-messaging-sw.js" | asset_url }}',
          { scope: '/' }
        );
      } catch (e) { console.warn('SW reg failed:', e); return; }

      const perm = await Notification.requestPermission();
      if (perm !== 'granted') return;

      const token = await messaging.getToken({ vapidKey: FIREBASE_VAPID_KEY, serviceWorkerRegistration: swReg });
      if (token) {
        fcmToken = token;
        localStorage.setItem(SK.FCM_TOKEN, token);
        await registerTokenWithBackend(token);
      }

      messaging.onMessage(payload => {
        if (document.hidden) {
          new Notification(payload.notification?.title || '💬 New Reply', {
            body: payload.notification?.body || 'You have a new message',
            icon: '/favicon.ico'
          });
        }
      });

      messaging.onTokenRefresh(async () => {
        const t = await messaging.getToken({ vapidKey: FIREBASE_VAPID_KEY });
        if (t) { fcmToken = t; localStorage.setItem(SK.FCM_TOKEN, t); await registerTokenWithBackend(t); }
      });
    } catch (err) { console.warn('Firebase push setup failed:', err); }
  }

  async function registerTokenWithBackend(token) {
    try {
      await fetch(`${BASE_URL}/app/chat/register-fcm-token`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ shop, fcmToken: token, sessionId: localStorage.getItem(SK.SID) || null, email: localStorage.getItem(SK.EMAIL) || null, userAgent: navigator.userAgent, registeredAt: new Date().toISOString() })
      });
    } catch (e) { console.warn('Token registration failed:', e); }
  }

  async function updateTokenAfterLogin() {
    const token = fcmToken || localStorage.getItem(SK.FCM_TOKEN);
    if (token) await registerTokenWithBackend(token);
  }

