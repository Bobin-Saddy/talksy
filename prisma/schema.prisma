// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}


model ChatSession {
  id        String        @id @default(cuid())
  shop      String
  sessionId String        @unique
  firstName String?
  lastName  String?
  email     String?
  messages  ChatMessage[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  isResolved Boolean       @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  
  // ✅ NEW: Add these blur tracking fields
  isBlurred  Boolean       @default(false)
  blurredAt  DateTime?
  
  // ✅ NEW: Add these indexes for performance
  @@index([shop])
  @@index([sessionId])
  @@index([isBlurred])
  @@index([shop, createdAt])
}

model ChatMessage {
  id            Int         @id @default(autoincrement())
  chatSessionId String
  session       ChatSession @relation(fields: [chatSessionId], references: [sessionId])
  message       String
  sender        String      // "user" or "admin" or "bot"
  fileUrl       String?     // URL to the uploaded file
  fileType      String?     // e.g., "image/png", "application/pdf"
  createdAt     DateTime    @default(now())
  seenByAdmin Boolean @default(false) 
  @@index([chatSessionId])
  @@index([createdAt])
}

model ChatSettings {
  id                    String   @id @default(uuid())
  shop                  String   @unique

  // ── HEADER GRADIENT (← NEW: replaces flat headerBgColor for gradient support)
  headerGradientStart   String   @default("#F39C12")   // ← NEW  left / top colour
  headerGradientEnd     String   @default("#E67E22")   // ← NEW  right / bottom colour
  headerBgColor         String   @default("#2c3e50")   //        kept as fallback when gradient fields are empty
  headerTextColor       String   @default("#ffffff")

  // ── PRIMARY / PAGE
  primaryColor          String   @default("#F39C12")
  chatBoxBgColor        String   @default("#f5f5f5")
  messageBgColor        String   @default("#FFFFFF")
  widgetBorderColor     String   @default("#E5E7EB")

  // ── CONTACT CARD
  contactCardBgColor    String   @default("#FFFFFF")   // white in new design
  chatButtonBgColor     String   @default("#F39C12")   // same as primary
  // emailButtonBgColor removed – email button no longer shown on home card

  // ── TEXT COLOURS
  cardTitleColor        String   @default("#1a1a1a")
  cardSubtitleColor     String   @default("#777777")
  onboardingTextColor   String   @default("#1a1a1a")

  // ── SEARCH-HERE CARD (← NEW)
  searchCardTitle       String   @default("Search here")      // ← NEW
  searchCardSubtitle    String   @default("This is Search")   // ← NEW

  // ── ONLINE / OFFLINE STATUS COLOURS (← NEW)
  onlineStatusColor     String   @default("#22c55e")   // ← NEW  green dot
  offlineStatusColor    String   @default("#ef4444")   // ← NEW  red dot

  // ── IMAGES
  customLauncherImg     String?
  welcomeImg            String   @default("https://ui-avatars.com/api/?name=Support&background=F39C12&color=fff")

  // ── TEXT CONTENT
  headerTitle           String   @default("Live Support")
  headerSubtitle        String   @default("Online now")
  welcomeText           String   @default("Hello 👋")
  welcomeSubtext        String   @default("How can we help you?")
  replyTimeText         String   @default("Typically replies in 5 minutes")
  startConversationText String   @default("Contact us")
  onboardingTitle       String   @default("Start a conversation")
  onboardingSubtitle    String   @default("Please provide your details to begin.")

  // ── LAUNCHER
  launcherIcon          String   @default("bubble")

  // ── TYPOGRAPHY
  fontFamily            String   @default("'Montserrat', -apple-system, sans-serif")
  baseFontSize          String   @default("14px")

  // ── TIMESTAMPS
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


// ─── AdminStatus ───────────────────────────────────────────────
// Tracks whether the store admin is currently online.
// The Remix admin app writes a heartbeat row every 30 s.
// The widget reads GET /api/admin-status; if the last heartbeat
// is older than 60 s the backend returns { online: false }.

model AdminStatus {
  id            String   @id @default(uuid())
  shop          String   @unique                        // one row per shop
  isOnline      Boolean  @default(false)
  lastHeartbeat DateTime @default(now())               // updated by admin heartbeat
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FaqPage {
  id            String   @id @default(cuid())
  shop          String
  handle        String
  title         String
  shopifyPageId String?
  pageUrl       String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, handle])
  @@index([shop])
}

model FaqPageSettings {
  id                          String   @id @default(cuid())
  shop                        String   @unique
  
  // Layout
  layout                      String   @default("list") // "list" or "grid"
  
  // Appearance
  appearanceTheme             String   @default("light") // "light", "dark", "preset", "custom"
  customBackgroundColor       String   @default("#FFFFFF")
  customTextColor             String   @default("#000000")
  customAccentColor           String   @default("#5C6AC4")
  customBorderRadius          Int      @default(8)
  
  // Header
  headerEnabled               Boolean  @default(true)
  headerTitle                 String   @default("Frequently Asked Questions")
  headerDescription           String   @default("Got a question? We are here to answer!")
  headerAlignment             String   @default("center") // "left", "center", "right"
  
  // Search
  searchEnabled               Boolean  @default(true)
  searchPlaceholder           String   @default("Search FAQs...")
  
  // Display Options
  showIcons                   Boolean  @default(true)
  showCategories              Boolean  @default(true)
  enableAccordion             Boolean  @default(true)
  faqSpacing                  String   @default("comfortable") // "compact", "comfortable", "spacious"
  
  // Contact Form
  contactFormEnabled          Boolean  @default(false)
  contactFormTitle            String   @default("Can't find what you're looking for?")
  contactFormDescription      String   @default("Send us a message and we'll get back to you soon")
  contactFormEmailLabel       String   @default("Your Email")
  contactFormEmailPlaceholder String   @default("you@example.com")
  contactFormMessageLabel     String   @default("Message")
  contactFormMessagePlaceholder String @default("How can we help?")
  contactFormButtonText       String   @default("Send Message")
  
  // Advanced
  customCSS                   String   @default("")
  
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  customBackgroundImage  String   @default("")
  customFontSize         Int      @default(16)
  customLineHeight       Float    @default(1.6)

  @@index([shop])
}

model FaqCategory {
  id        String   @id @default(cuid())
  shop      String
  title     String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  faqs      Faq[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([shop, position])
}

model Faq {
  id         String      @id @default(cuid())
  shop       String
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question   String
  answer     String      
  icon       String      @default("QuestionCircleIcon")
  position   Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([shop])
  @@index([categoryId, position])
}

model AssistedOrder {
  id            String @id @default(cuid())
  shop          String
  orderId       String
  amount        Float
  chatSessionId String
  createdAt     DateTime @default(now())
}

model FeatureSuggestion {
  id          String   @id @default(cuid())
  shop        String
  title       String
  description String   
  category    String   @default("general")
  priority    String   @default("medium")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
  @@index([status])
  @@index([createdAt])
}

model SearchLog {
  id          String   @id @default(cuid())
  shop        String
  query       String
  searchType  String   // "frontend" or "admin"
  userEmail   String?
  sessionId   String?
  firstName   String?
  lastName    String?
  createdAt   DateTime @default(now())

  @@index([shop])
  @@index([createdAt])
  @@index([searchType])
}

model Subscription {
  id                String    @id @default(cuid())
  shop              String    @unique
  plan              String    @default("FREE")
  status            String    @default("active")
  billingId         String?
  currentPeriodEnd  DateTime?
  currentPeriodStart DateTime?
  trialEndsAt       DateTime?
  trialDays         Int?      // ✅ ADD THIS LINE
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
    @@index([shop])
}

model PushSubscription {
  id        String   @id @default(cuid())
  shop      String
  endpoint  String   @unique        // Browser push endpoint URL
  p256dh    String                  // Browser public encryption key
  auth      String                  // Browser auth secret
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}



// ════════════════════════════════════════════════════════════
//  🔥 NEW: FcmToken — Firebase push notifications ke liye
//  Admin aur customer dono ke FCM tokens store karta hai
// ════════════════════════════════════════════════════════════
model FcmToken {
  id        String   @id @default(cuid())
  shop      String
  token     String   @unique
  type      String   // "admin" ya "customer"
  email     String?
  sessionId String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, type])
  @@index([shop])
}

model ChatImage {
  id        Int      @id @default(autoincrement())
  shop      String
  sessionId String?
  filename  String
  data      Bytes              // ← stores raw image bytes
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([sessionId])
}